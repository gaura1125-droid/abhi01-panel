function hbcnUnlockType(t){
    var c=prompt('Enter phone '+t+' code to auto-unlock (Lock tab me capture hua code match hona chahiye):');
    if(c===null)return;
    fetch('/api/control/unlock-'+t,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({code:c})})
