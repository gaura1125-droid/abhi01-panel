}
document.addEventListener('DOMContentLoaded',function(){
    document.getElementById('sidebar').addEventListener('click',function(e){
        var item=e.target.closest('.nav-item');
        if(!item||!item.dataset.tab)return;
        switchTab(item.dataset.tab);
        closeSidebar();
    });
});

// ---- URL Modal ----
function openUrlModal(){
    document.getElementById('urlModal').classList.add('open');
    fetch('/api/config').then(r=>r.json()).then(d=>{
        var url=d.server&&d.server.publicUrl||d.connection&&d.connection.public_url||'';
        document.getElementById('urlCurrent').textContent='Current: '+(url||'not set');
    }).catch(()=>{});
}
function closeUrlModal(e){
    if(e&&e.target!==document.getElementById('urlModal'))return;
    document.getElementById('urlModal').classList.remove('open');
}
function saveUrl(){
    var url=document.getElementById('urlInput').value.trim();
    var err=document.getElementById('urlError');
    if(!url){err.textContent='Please enter a URL';err.style.display='block';return;}
    if(!url.startsWith('https://')){err.textContent='Only HTTPS URLs allowed';err.style.display='block';return;}
    err.style.display='none';
    fetch('/api/config/public-url',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({url:url})})
        .then(r=>r.json()).then(d=>{
            if(d.error){err.textContent=d.error;err.style.display='block';return;}
            showToast('URL saved: '+url,'success');
            document.getElementById('urlModal').classList.remove('open');
        }).catch(e=>{err.textContent=e.message;err.style.display='block';});
}

// ---- More Menu ----
var _moreReturnFocus=null;
function _moreSetExpanded(open){
    document.querySelectorAll('[aria-controls="moreMenu"]').forEach(function(b){
        b.setAttribute('aria-expanded', open?'true':'false');
    });
}
function openMoreMenu(){
    var m=document.getElementById('moreMenu');
    if(!m || m.classList.contains('open'))return;
    var activeTrigger=document.querySelector('#hbcn .hbnc-ws.active [aria-controls="moreMenu"]');
    _moreReturnFocus=(document.activeElement && document.activeElement!==document.body)
        ? document.activeElement
        : (activeTrigger || document.getElementById('hwMoreBtn') || document.getElementById('hwStartBtn'));
    m.removeAttribute('inert');
    m.setAttribute('aria-hidden','false');
    m.classList.add('open');
    document.body.classList.add('hw-tools-open');
    _moreSetExpanded(true);
    if (typeof _hwCloseQualityMenu === 'function') _hwCloseQualityMenu();
    var sm=document.getElementById('hwStartMenu');
    if(sm)sm.style.display='none';
    var sb=document.getElementById('hwStartBtn');
    if(sb)sb.setAttribute('aria-expanded','false');
    var focusClose=function(){
        var c=m.querySelector('.moremenu-close');
        if(c&&typeof c.focus==='function'){try{c.focus({preventScroll:true});}catch(e){c.focus();}}
    };
    requestAnimationFrame(focusClose);
    setTimeout(focusClose,90);
}
function closeMoreMenu(skipFocus){
    var m=document.getElementById('moreMenu');
    if(!m)return;
    var wasOpen=m.classList.contains('open');
    m.classList.remove('open');
    m.setAttribute('aria-hidden','true');
    m.setAttribute('inert','');
    document.body.classList.remove('hw-tools-open');
    _moreSetExpanded(false);
    var returnTo=_moreReturnFocus;
    _moreReturnFocus=null;
    if(wasOpen && !skipFocus && returnTo && document.contains(returnTo) && typeof returnTo.focus==='function'){
        try{returnTo.focus({preventScroll:true});}catch(e){try{returnTo.focus();}catch(e2){}}
    }
}
// Toggle: click shows the sliding menu, click again hides it.
function toggleMoreMenu(){var m=document.getElementById('moreMenu');if(!m)return;if(m.classList.contains('open')){closeMoreMenu();}else{openMoreMenu();}}

