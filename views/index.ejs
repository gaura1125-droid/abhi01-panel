function hwTypeSend(){
    var inp=document.getElementById('hwTypeInput');
    var txt=inp?inp.value:'';
    if(!txt){showToast('Type something first','error');return;}
    fetch('/api/screen/paste',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:txt})})
