<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#060914">
<meta name="csrf-token" content="<%= csrfToken %>">
<title>Tenant Control · Armaan Admin</title>
<link rel="stylesheet" href="/css/admin-premium.css">
<script>
  try {
    var savedTheme = localStorage.getItem('armaan-theme');
    if (savedTheme === 'light' || savedTheme === 'dark') {
      document.documentElement.setAttribute('data-theme', savedTheme);
    }
  } catch (e) {}
  window.__ADMIN__ = <%- JSON.stringify({ csrf: csrfToken, users: users }).replace(/</g, '\\u003c') %>;
</script>
</head>
<body>
<div class="grid-lines" aria-hidden="true"></div>

<header class="topbar">
  <div class="brand">
    <div class="brand-mark">A</div>
    <div>
      <div class="brand-name">Armaan Control</div>
      <div class="brand-sub">Super admin · tenant &amp; license plane</div>
    </div>
  </div>
  <nav class="top-nav" aria-label="Admin navigation">
    <a class="nav-link" href="/" title="Main dashboard">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 10 9-7 9 7"/><path d="M5 9v11h14V9"/><path d="M9 20v-6h6v6"/></svg>
      <span>Dashboard</span>
    </a>
    <a class="nav-link" href="/admin" title="Firebase &amp; tunnel console">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg>
      <span>Admin Panel</span>
    </a>
    <button class="nav-link" id="themeBtn" type="button" title="Toggle color theme">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      <span id="themeLabel">Light mode</span>
    </button>
    <a class="nav-link" href="/logout" title="Sign out">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>
      <span>Logout</span>
    </a>
  </nav>
</header>

<main class="shell">
  <section class="hero">
    <div class="hero-copy">
      <div class="eyebrow"><span class="pulse"></span> Super admin only · live tenancy</div>
      <h1>User &amp; license control</h1>
      <p>Create isolated tenant accounts, set calendar-based license expiry, cut access instantly, and inspect every device bound to a user. Normal users can never see this plane or another tenant's devices.</p>
    </div>
    <div class="hero-actions">
      <a class="btn" href="/admin">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg>
        Firebase &amp; tunnel
      </a>
      <button class="btn btn-primary" id="refreshBtn" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>
        Refresh live data
      </button>
    </div>
  </section>

  <section class="stats" aria-label="License statistics">
    <article class="stat">
      <div class="stat-head">
        <span class="stat-label">Total accounts</span>
        <span class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
      </div>
      <div class="stat-value" id="statUsers"><%= stats.total %></div>
      <div class="stat-foot" id="statUsersFoot"><%= stats.disabled ? stats.disabled + ' disabled account' + (stats.disabled === 1 ? '' : 's') : 'All accounts in good standing' %></div>
    </article>
    <article class="stat">
      <div class="stat-head">
        <span class="stat-label">Active licenses</span>
        <span class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg></span>
      </div>
      <div class="stat-value" id="statActive"><%= stats.active %></div>
      <div class="stat-foot"><span class="tiny-dot"></span> License valid right now</div>
    </article>
    <article class="stat">
      <div class="stat-head">
        <span class="stat-label">Expired / disabled</span>
        <span class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
      </div>
      <div class="stat-value" id="statExpired"><%= stats.expired %></div>
      <div class="stat-foot"><%= stats.disabled %> disabled by admin</div>
    </article>
    <article class="stat">
      <div class="stat-head">
        <span class="stat-label">Bound devices</span>
        <span class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 18h2"/></svg></span>
      </div>
      <div class="stat-value" id="statDevices"><%= stats.devices %></div>
      <div class="stat-foot" id="statOnlineFoot"><span class="tiny-dot"></span> <%= stats.online %> device<%= stats.online === 1 ? '' : 's' %> connected now</div>
    </article>
  </section>

  <section class="workspace">
    <aside class="card create-card">
      <div class="card-head">
        <div>
          <h2 class="card-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
            Create tenant
          </h2>
          <p class="card-sub">A private account with its own devices &amp; license.</p>
        </div>
      </div>
      <form class="create-form" id="createForm" autocomplete="off">
        <div class="field">
          <label for="newUsername">Username</label>
          <div class="input-wrap">
            <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
            <input class="input" id="newUsername" name="username" type="text" placeholder="e.g. rahul_01" pattern="[a-zA-Z0-9_.\-]{3,40}" minlength="3" maxlength="40" required>
          </div>
        </div>
        <div class="field">
          <label for="newPassword">Password</label>
          <div class="input-wrap">
            <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
            <input class="input" id="newPassword" name="password" type="password" placeholder="Minimum 4 characters" minlength="4" required>
          </div>
        </div>
        <div class="field">
          <label for="newExpiry">License expiry</label>
          <input class="input" id="newExpiry" name="expiry_date" type="date" required>
          <div class="preset-row">
            <button class="chip" type="button" data-days="7">7 days</button>
            <button class="chip active" type="button" data-days="30">30 days</button>
            <button class="chip" type="button" data-days="90">90 days</button>
            <button class="chip" type="button" data-days="365">1 year</button>
          </div>
        </div>
        <div class="form-message" id="formMessage" role="status" aria-live="polite"></div>
        <button class="btn btn-primary" id="createBtn" type="submit" style="width:100%;min-height:46px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
          Create account &amp; license
        </button>
        <p class="hint">The generated license key is also the APK connection token. Share it once; the device binds to this tenant automatically.</p>
      </form>

      <div class="card hide" id="createdBox" style="margin:0 20px 20px;background:var(--emerald-soft);border-color:color-mix(in srgb,var(--emerald) 28%,transparent)">
        <div style="padding:14px 15px">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:9px">
            <strong style="font-size:12px;color:var(--emerald)">Account created</strong>
            <button class="icon-btn" id="createdClose" type="button" title="Dismiss" style="width:26px;height:26px">&times;</button>
          </div>
          <div class="hint" style="margin-bottom:5px">License / APK key</div>
          <div style="display:flex;align-items:center;gap:6px">
            <code class="license-key" id="createdKey" style="flex:1;color:var(--text)"></code>
            <button class="copy-btn" id="createdCopy" type="button" title="Copy license key">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            </button>
          </div>
          <div class="hint" style="margin:9px 0 5px">APK token</div>
          <div style="display:flex;align-items:center;gap:6px">
            <code class="license-key" id="createdToken" style="flex:1;color:var(--text)"></code>
            <button class="copy-btn" id="createdTokenCopy" type="button" title="Copy APK token">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            </button>
          </div>
        </div>
      </div>
    </aside>

    <div class="card table-card">
      <div class="card-head">
        <div>
          <h2 class="card-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Tenant accounts
          </h2>
          <p class="card-sub">Click a device count to inspect that user's bound phones.</p>
        </div>
        <span class="count-pill" id="visibleCount"><%= users.length %> of <%= users.length %></span>
      </div>
      <div class="toolbar">
        <div class="search-box">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input id="searchInput" type="search" placeholder="Search username, key or ID..." autocomplete="off">
        </div>
        <div class="segmented" role="group" aria-label="Filter accounts">
          <button class="active" type="button" data-filter="all">All</button>
          <button type="button" data-filter="active">Active</button>
          <button type="button" data-filter="expired">Expired</button>
          <button type="button" data-filter="disabled">Disabled</button>
        </div>
      </div>
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th>User</th>
              <th>License key</th>
              <th>Expiry</th>
              <th>Status</th>
              <th>Devices</th>
              <th>Access</th>
              <th style="text-align:right">Actions</th>
            </tr>
          </thead>
          <tbody id="usersBody">
            <% if (!users.length) { %>
              <tr><td colspan="7">
                <div class="empty-state">
                  <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
                  <h3>No users yet</h3>
                  <p>Create the first tenant account with the form on the left.</p>
                </div>
              </td></tr>
            <% } %>
            <% users.forEach((user) => { %>
              <tr data-row="<%= user.id %>" data-user-id="<%= user.id %>">
                <td>
                  <div class="user-cell">
                    <div class="avatar"><%= user.initials %></div>
                    <div style="min-width:0">
                      <div class="user-name" title="<%= user.username %>"><%= user.username %></div>
                      <div class="user-meta">ID #<%= user.id %></div>
                      <div class="role-badge <%= user.role === 'super_admin' ? 'admin' : '' %>"><%= user.role === 'super_admin' ? 'Super Admin' : 'Tenant' %></div>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="key-cell">
                    <span class="license-key" title="<%= user.license_key || '' %>"><%= user.license_key || (user.role === 'super_admin' ? '—' : 'Not generated') %></span>
                  </div>
                </td>
                <td>
                  <div class="expiry">
                    <span class="expiry-date"><%= user.expiry_label %></span>
                    <span class="expiry-sub"><%= user.days_label %></span>
                  </div>
                </td>
                <td><span class="badge <%= user.status_class %>"><span class="dot"></span><%= user.status_label %></span></td>
                <td>
                  <div class="device-count">
                    <span class="live-dot <%= user.device_online ? 'on' : '' %>"></span>
                    <b><%= user.device_total %></b><span class="muted">device<%= user.device_total === 1 ? '' : 's' %></span>
                  </div>
                </td>
                <td>
                  <span class="badge <%= user.is_active ? 'active' : 'disabled' %>"><span class="dot"></span><%= user.is_active ? 'Enabled' : 'Disabled' %></span>
                </td>
                <td>
                  <div class="row-actions">
                    <button class="icon-btn primary" type="button" data-action="devices" data-id="<%= user.id %>" title="View devices">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                    <button class="icon-btn" type="button" data-action="edit-expiry" data-id="<%= user.id %>" title="Edit expiry" <%= user.role === 'super_admin' ? 'disabled' : '' %>>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                    </button>
                    <% if (user.role !== 'super_admin') { %>
                    <button class="icon-btn danger" type="button" data-action="delete" data-id="<%= user.id %>" title="Delete user">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/></svg>
                    </button>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</main>

<!-- Device drawer -->
<div class="drawer-backdrop" id="drawerBackdrop"></div>
<aside class="drawer" id="deviceDrawer" aria-label="User devices" aria-hidden="true">
  <div class="drawer-head">
    <div>
      <h2 class="drawer-title" id="drawerTitle">Devices</h2>
      <p class="drawer-sub" id="drawerSub">Live tenant device access</p>
    </div>
    <button class="icon-btn" id="drawerClose" type="button" title="Close">&times;</button>
  </div>
  <div class="drawer-body" id="drawerBody"></div>
  <div class="drawer-foot">
    <a class="btn" id="drawerFullLink" href="#">Open full page</a>
    <button class="btn" id="drawerApkBtn" type="button">APK profile</button>
  </div>
</aside>

<!-- Expiry modal -->
<div class="modal-backdrop" id="expiryModal">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="expiryTitle">
    <div class="modal-head">
      <div class="modal-icon" style="background:var(--brand-soft);color:var(--brand-2)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
      </div>
      <div>
        <h3 id="expiryTitle">Edit license expiry</h3>
        <p>Choose the last day <strong id="expiryName">this user</strong> can access the panel and their devices.</p>
      </div>
    </div>
    <div class="modal-body">
      <label class="hint" for="expiryInput" style="display:block;margin-bottom:6px">Expiry date</label>
      <input class="input" id="expiryInput" type="date">
      <div class="preset-row expiry-preset" style="margin-top:10px">
        <button class="chip" type="button" data-days="7">+7 days</button>
        <button class="chip" type="button" data-days="30">+30 days</button>
        <button class="chip" type="button" data-days="90">+90 days</button>
        <button class="chip" type="button" data-days="365">+1 year</button>
      </div>
    </div>
    <div class="modal-actions">
      <button class="btn" id="expiryCancelBtn" type="button">Cancel</button>
      <button class="btn btn-primary" id="expirySaveBtn" type="button">Save expiry</button>
    </div>
  </div>
</div>

<!-- APK profile modal -->
<div class="modal-backdrop" id="apkModal">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="apkTitle" style="width:min(620px,100%)">
    <div class="modal-head">
      <div class="modal-icon" style="background:var(--emerald-soft);color:var(--emerald)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 16V9a7 7 0 0 1 14 0v7"/><path d="M8 19h8"/><path d="M7 16h10"/></svg>
      </div>
      <div style="flex:1">
        <h3 id="apkTitle">APK provisioning</h3>
        <p>Per-user server URL and connection token for a testing APK build.</p>
      </div>
      <button class="icon-btn" id="apkClose" type="button" title="Close">&times;</button>
    </div>
    <div class="modal-body" id="apkBody"></div>
  </div>
</div>

<div class="toast-stack" id="toastStack" aria-live="polite"></div>

<script src="/js/admin-users.js"></script>
<link rel="stylesheet" href="/css/nextgen.css">
</body>
</html>
