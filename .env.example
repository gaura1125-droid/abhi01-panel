# Armaan Environment Configuration
# Copy this file to .env and edit as needed

# =============================================================================
# Server Binding
# =============================================================================
# Dashboard host binding (default: 127.0.0.1 for security)
# Set to 0.0.0.0 to allow LAN access to dashboard
# DASHBOARD_HOST=127.0.0.1

# Optional: Override ports from armand.json
# PORT=22222
# DASHBOARD_PORT=3000

# =============================================================================
# Admin Access
# =============================================================================
# Admin secret token for /admin entry point
# Can also be set in armand.json (server.secret_token) or SQLite
# ADMIN_SECRET_TOKEN=your-secure-token-here

# =============================================================================
# Telegram Bot (for OTP delivery)
# =============================================================================
# Also configurable in login/config.json
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# =============================================================================
# Session
# =============================================================================
# Session signing secret (auto-generated on first run if not set)
# SESSION_SECRET=your-64-char-hex-secret

# =============================================================================
# Node Environment
# =============================================================================
NODE_ENV=production

# =============================================================================
# Cloudflare Tunnel (optional)
# =============================================================================
# CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token
# CLOUDFLARE_TUNNEL_HOSTNAME=your-hostname.trycloudflare.com