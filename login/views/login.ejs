<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="theme-color" content="#020408">
    <meta name="description" content="ABHI0.1 Admin — Elite Cybersecurity Command Interface">
    <title>ABHI0.1 Admin — Secure Access</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/login/assets/cyber.css?v=5">
    <link rel="icon" type="image/png" href="/login/public/logo.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="ABHI0.1 Admin">
</head>
<body>
    <!-- Animated Background Elements -->
    <div class="particle-field" id="particleField" aria-hidden="true"></div>
    <div class="circuit-traces" id="circuitTraces" aria-hidden="true"></div>
    <div class="scanlines" aria-hidden="true"></div>

    <!-- Main Login Container -->
    <main class="login-container" role="main">
        <article class="login-panel" role="region" aria-label="Secure Login Panel">
            <div class="panel-glass" role="form" aria-label="Authentication Form">
                <!-- Brand Header -->
                <header class="brand-header" role="banner">
                    <div class="brand-badge" aria-hidden="true">
                        <span class="badge-dot" aria-hidden="true"></span>
                        <span>ABHI0.1</span>
                        <span class="badge-version">v3.7.1</span>
                    </div>
                    <h1 class="brand-title">Command Access</h1>
                    <p class="brand-subtitle">Elite Cybersecurity Command Interface</p>
                </header>

                <!-- Status Indicators -->
                <div class="status-indicators" role="status" aria-live="polite" aria-label="System Status">
                    <div class="status-item">
                        <span class="status-dot" aria-hidden="true"></span>
                        <span class="status-label">Core Online</span>
                    </div>
                    <div class="status-item">
                        <span class="status-dot cyan" aria-hidden="true"></span>
                        <span class="status-label">Grid Active</span>
                    </div>
                    <div class="status-item">
                        <span class="status-dot purple" aria-hidden="true"></span>
                        <span class="status-label">Shield Armed</span>
                    </div>
                </div>

                <!-- Login Form -->
                <form class="login-form" id="loginForm" novalidate autocomplete="off" aria-label="Login Credentials">
                    <div class="form-group">
                        <label class="field-label" for="username">Identity Code</label>
                        <div class="field-wrapper" id="userWrapper">
                            <div class="input-wrapper" id="userInputWrapper">
                                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="18" height="18">
                                    <path d="M20 21a8 8 0 0 0-16 0"/>
                                    <circle cx="12" cy="7" r="4"/>
                                </svg>
                                <input
                                    type="text"
                                    class="field-input"
                                    id="username"
                                    name="username"
                                    autocomplete="username"
                                    placeholder="Enter identity code"
                                    required
                                    aria-label="Username or identity code"
                                    autocomplete="username"
                                    spellcheck="false"
                                    inputmode="text"
                                >
                                <button type="button" class="password-toggle" id="userClear" aria-label="Clear username" tabindex="-1">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                                        <line x1="18" y1="6" x2="6" y2="18"/>
                                        <line x1="6" y1="6" x2="18" y2="18"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="field-wrapper" id="passWrapper">
                        <label class="field-label" for="password">Access Key</label>
                        <div class="input-wrapper" id="passInputWrapper">
                            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="18" height="18">
                                <rect x="4" y="10" width="16" height="11" rx="2"/>
                                <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
                            </svg>
                            <input
                                type="password"
                                class="field-input"
                                id="password"
                                name="password"
                                autocomplete="current-password"
                                placeholder="Enter access key"
                                required
                                aria-label="Password or access key"
                                autocomplete="current-password"
                                spellcheck="false"
                                inputmode="text"
                            >
                            <button type="button" class="password-toggle" id="passwordToggle" aria-label="Show password" tabindex="-1">
                                <svg id="eyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
                                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="form-options">
                        <label class="checkbox-wrapper">
                            <input type="checkbox" id="remember" name="remember" value="1" autocomplete="off">
                            <span class="checkmark" aria-hidden="true"></span>
                            <span class="check-label">Persist Session</span>
                        </label>
                        <a href="#" class="forgot-link" id="forgotLink">Recovery Protocol</a>
                    </div>

                    <button type="submit" class="btn-primary" id="loginBtn" aria-label="Initiate Secure Access">
                        <span class="btn-text">Initiate Access</span>
                        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
                            <path d="M15 3h6v6"/>
                            <path d="M10 14L20.5 3.5"/>
                        </svg>
                        <svg class="spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="12" cy="12" r="10" stroke-opacity="0.25"/>
                            <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"/>
                        </svg>
                    </button>
                </form>

                <!-- OTP Form -->
                <form class="otp-form" id="otpForm" novalidate autocomplete="off" aria-label="Two-Factor Authentication">
                    <div class="otp-sent" id="otpSent" style="display: none;" role="status" aria-live="polite">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M8 12l2 2 4-4"/>
                        </svg>
                        <span>Code transmitted to <strong id="sentTarget"></strong></span>
                    </div>

                    <div class="otp-grid" id="otpGrid" role="group" aria-label="6-digit authentication code">
                        <input type="tel" class="otp-input" inputmode="numeric" pattern="[0-9]*" maxlength="1" data-index="0" aria-label="Digit 1" autocomplete="one-time-code" placeholder="" data-digit-color="#00ff88" data-digit-glow="rgba(0, 255, 136, 0.35)">
                        <input type="tel" class="otp-input" inputmode="numeric" pattern="[0-9]*" maxlength="1" data-index="1" aria-label="Digit 2" autocomplete="one-time-code" placeholder="" data-digit-color="#00e5ff" data-digit-glow="rgba(0, 229, 255, 0.35)">
                        <input type="tel" class="otp-input" inputmode="numeric" pattern="[0-9]*" maxlength="1" data-index="2" aria-label="Digit 3" autocomplete="one-time-code" placeholder="" data-digit-color="#0088ff" data-digit-glow="rgba(0, 136, 255, 0.35)">
                        <input type="tel" class="otp-input" inputmode="numeric" pattern="[0-9]*" maxlength="1" data-index="3" aria-label="Digit 4" autocomplete="one-time-code" placeholder="" data-digit-color="#a855f7" data-digit-glow="rgba(168, 85, 247, 0.35)">
                        <input type="tel" class="otp-input" inputmode="numeric" pattern="[0-9]*" maxlength="1" data-index="4" aria-label="Digit 5" autocomplete="one-time-code" placeholder="" data-digit-color="#ec4899" data-digit-glow="rgba(236, 72, 153, 0.35)">
                        <input type="tel" class="otp-input" inputmode="numeric" pattern="[0-9]*" maxlength="1" data-index="5" aria-label="Digit 6" autocomplete="one-time-code" placeholder="" data-digit-color="#00ff88" data-digit-glow="rgba(0, 255, 136, 0.35)">
                    </div>

                    <button type="button" class="btn-primary btn-otp" id="verifyBtn" aria-label="Verify Authentication Code">
                        <span class="btn-text">Verify Access</span>
                        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                            <polyline points="22 4 12 14.01 9 11.01"/>
                        </svg>
                        <svg class="spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="12" cy="12" r="10" stroke-opacity="0.25"/>
                            <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"/>
                        </svg>
                    </button>

                    <div class="btn-group">
                        <button type="button" class="btn-secondary" id="resendBtn" aria-label="Resend Code" disabled>
                            <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                                <circle cx="12" cy="12" r="9"/>
                                <path d="M12 7v5l3 2"/>
                            </svg>
                            <span class="btn-text">Resend Code</span>
                        </button>
                        <button type="button" class="btn-secondary" id="backBtn" aria-label="Return to Login">
                            <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                                <path d="M19 12H5"/>
                                <polyline points="12 19 5 12 12 5"/>
                            </svg>
                            <span class="btn-text">Cancel</span>
                        </button>
                    </div>
                </form>
            </div>
        </article>
    </main>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer" role="region" aria-label="Notifications" aria-live="polite"></div>

    <!-- Security Footer -->
    <footer class="security-footer" role="contentinfo" aria-hidden="true">
        <p class="footer-text">ABHI0.1 SECURE ACCESS v3.7.1</p>
        <p class="footer-subtext">Encrypted Channel • Quantum Resistant • Zero Trust Architecture</p>
    </footer>

    <script>
        // ==========================================================================
        // VYzX Elite Cybersecurity Login Controller
        // ==========================================================================

        (() => {
            'use strict';

            // ==========================================================================
            // DOM Element References
            // ==========================================================================
            const loginForm = document.getElementById('loginForm');
            const otpForm = document.getElementById('otpForm');
            const usernameInput = document.getElementById('username');
            const passwordInput = document.getElementById('password');
            const userClear = document.getElementById('userClear');
            const passwordToggle = document.getElementById('passwordToggle');
            const eyeIcon = document.getElementById('eyeIcon');
            const rememberCheckbox = document.getElementById('remember');
            const loginBtn = document.getElementById('loginBtn');
            const otpInputs = document.querySelectorAll('.otp-input');
            const otpGrid = document.getElementById('otpGrid');
            const verifyBtn = document.getElementById('verifyBtn');
            const resendBtn = document.getElementById('resendBtn');
            const backBtn = document.getElementById('backBtn');
            const otpSent = document.getElementById('otpSent');
            const sentTarget = document.getElementById('sentTarget');
            const userWrapper = document.getElementById('userWrapper');
            const passWrapper = document.getElementById('passWrapper');
            const userInputWrapper = document.getElementById('userInputWrapper');
            const passInputWrapper = document.getElementById('passInputWrapper');
            const userClearBtn = document.getElementById('userClear');
            const passwordToggleBtn = document.getElementById('passwordToggle');
            const eyeIconEl = document.getElementById('eyeIcon');

            // Toast container
            const toastContainer = document.getElementById('toastContainer');

            // State
            let otpValue = '';
            let resendTimer = null;
            let resendSeconds = 0;
            let otpPulseTimer = null;
            let isVerifying = false;

            // ==========================================================================
            // Utility Functions
            // ==========================================================================
            const $ = (selector, root = document) => root.querySelector(selector);
            const $$ = (selector, root = document) => Array.from(root.querySelectorAll(selector));

            function showToast(message, type = 'info', duration = 4000) {
                const toast = document.createElement('div');
                toast.className = `toast ${type} show`;
                toast.role = 'alert';
                toast.ariaLive = type === 'error' ? 'assertive' : 'polite';

                const icons = {
                    error: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>',
                    success: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="12" cy="12" r="10"/><path d="M8 12l2 2 4-4"/></svg>',
                    info: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="8"/></svg>'
                };

                toast.innerHTML = `
                    <span class="toast-icon">${icons[type] || icons.info}</span>
                    <span class="toast-text">${message}</span>
                    <button class="toast-close" aria-label="Dismiss" type="button">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                `;

                const closeBtn = toast.querySelector('.toast-close');
                closeBtn.addEventListener('click', () => removeToast(toast));

                const container = document.getElementById('toastContainer');
                container.appendChild(toast);

                // Force reflow for animation
                requestAnimationFrame(() => toast.classList.add('show'));

                const timeout = setTimeout(() => removeToast(toast), duration);
                toast._timeout = timeout;

                function removeToast(toast) {
                    clearTimeout(toast._timeout);
                    toast.classList.remove('show');
                    toast.addEventListener('transitionend', () => toast.remove(), { once: true });
                }

                return toast;
            }

            function setLoading(button, isLoading) {
                button.disabled = isLoading;
                button.classList.toggle('loading', isLoading);
                if (button === document.getElementById('loginBtn')) {
                    document.body.classList.toggle('login-busy', isLoading);
                }
                if (button === document.getElementById('verifyBtn')) {
                    document.body.classList.toggle('verify-busy', isLoading);
                    document.getElementById('otpGrid')?.classList.toggle('scanning', isLoading);
                }
            }

            function flashError(target) {
                document.body.classList.add('auth-error');
                if (window.flashErrorTimer) clearTimeout(window.flashErrorTimer);
                window.flashErrorTimer = setTimeout(() => {
                    document.body.classList.remove('auth-error');
                }, 780);
            }

            function generateParticles(count = 30) {
                const container = document.getElementById('particleField');
                if (!container) return;

                for (let i = 0; i < count; i++) {
                    const particle = document.createElement('div');
                    particle.className = 'particle';
                    const size = Math.random() * 3 + 1;
                    const colors = ['var(--neon-green)', 'var(--neon-cyan)', 'var(--neon-blue)', 'var(--neon-purple)'];
                    const color = colors[Math.floor(Math.random() * colors.length)];

                    particle.style.cssText = `
                        left: ${Math.random() * 100}%;
                        top: ${Math.random() * 100}%;
                        width: ${size}px;
                        height: ${size}px;
                        background: ${color};
                        box-shadow: 0 0 ${size * 2}px ${color}, 0 0 ${size * 4}px ${color};
                        animation-delay: ${Math.random() * 20}s;
                        animation-duration: ${15 + Math.random() * 15}s;
                    `;
                    container.appendChild(particle);
                }
            }

            function generateCircuitTraces() {
                const container = document.getElementById('circuitTraces');
                if (!container) return;

                // Horizontal traces
                for (let i = 0; i < 8; i++) {
                    const trace = document.createElement('div');
                    trace.className = 'circuit-trace';
                    trace.style.cssText = `
                        top: ${Math.random() * 100}%;
                        left: -200px;
                        width: ${200 + Math.random() * 300}px;
                        height: 1px;
                        animation-delay: ${Math.random() * 8}s;
                        animation-duration: ${8 + Math.random() * 6}s;
                    `;
                    container.appendChild(trace);
                }

                // Vertical traces
                for (let i = 0; i < 6; i++) {
                    const trace = document.createElement('div');
                    trace.className = 'circuit-trace vertical';
                    trace.style.cssText = `
                        left: ${Math.random() * 100}%;
                        top: -200px;
                        width: 1px;
                        height: ${200 + Math.random() * 300}px;
                        animation-delay: ${Math.random() * 10}s;
                        animation-duration: ${10 + Math.random() * 8}s;
                    `;
                    container.appendChild(trace);
                }
            }

            // ==========================================================================
            // Particle System
            // ==========================================================================
            function initParticleField() {
                const container = document.getElementById('particleField');
                if (!container) return;

                const particleCount = window.matchMedia('(max-width: 480px)').matches ? 20 : 40;
                const colors = [
                    'rgba(0, 255, 136, 0.6)',
                    'rgba(0, 229, 255, 0.5)',
                    'rgba(0, 136, 255, 0.4)',
                    'rgba(168, 85, 247, 0.4)'
                ];

                for (let i = 0; i < particleCount; i++) {
                    const particle = document.createElement('div');
                    particle.className = 'particle';
                    const size = Math.random() * 3 + 1;
                    const color = colors[Math.floor(Math.random() * colors.length)];
                    const startX = Math.random() * 100;
                    const startY = Math.random() * 100;
                    const duration = 15 + Math.random() * 20;
                    const delay = Math.random() * 20;

                    particle.style.cssText = `
                        left: ${startX}%;
                        top: ${startY}%;
                        width: ${size}px;
                        height: ${size}px;
                        background: ${color};
                        box-shadow: 0 0 ${size * 3}px ${color}, 0 0 ${size * 6}px ${color};
                        animation-duration: ${duration}s;
                        animation-delay: ${delay}s;
                    `;
                    container.appendChild(particle);
                }
            }

            // ==========================================================================
            // Circuit Traces Generation
            // ==========================================================================
            function initCircuitTraces() {
                const container = document.getElementById('circuitTraces');
                if (!container) return;

                // Horizontal traces
                for (let i = 0; i < 10; i++) {
                    const trace = document.createElement('div');
                    trace.className = 'circuit-trace';
                    const top = Math.random() * 100;
                    const width = 200 + Math.random() * 400;
                    const delay = Math.random() * 8;
                    const duration = 8 + Math.random() * 6;

                    trace.style.cssText = `
                        top: ${top}%;
                        left: -200px;
                        width: ${width}px;
                        height: 1px;
                        animation-delay: ${delay}s;
                        animation-duration: ${duration}s;
                    `;
                    container.appendChild(trace);
                }

                // Vertical traces
                for (let i = 0; i < 8; i++) {
                    const trace = document.createElement('div');
                    trace.className = 'circuit-trace vertical';
                    const left = Math.random() * 100;
                    const height = 200 + Math.random() * 300;
                    const delay = Math.random() * 10;
                    const duration = 10 + Math.random() * 8;

                    trace.style.cssText = `
                        left: ${left}%;
                        top: -200px;
                        width: 1px;
                        height: ${height}px;
                        animation-delay: ${delay}s;
                        animation-duration: ${duration}s;
                    `;
                    container.appendChild(trace);
                }
            }

            // ==========================================================================
            // Input Event Handlers
            // ==========================================================================
            function handleInputFocus(input) {
                const wrapper = input.closest('.field-wrapper');
                if (wrapper) wrapper.classList.add('focused');
                document.body.classList.add(input === usernameInput ? 'focus-user' : 'focus-pass');
            }

            function handleInputBlur(input) {
                const wrapper = input.closest('.field-wrapper');
                if (wrapper) wrapper.classList.remove('focused', 'typing');
                document.body.classList.remove('focus-user', 'focus-pass');
            }

            function handleInput(input) {
                const wrapper = input.closest('.field-wrapper');
                if (wrapper) wrapper.classList.add('typing');
                clearTimeout(wrapper._typingTimer);
                wrapper._typingTimer = setTimeout(() => wrapper.classList.remove('typing'), 380);

                // Clear button visibility
                if (input === usernameInput && userClearBtn) {
                    userClearBtn.style.opacity = input.value ? '1' : '0';
                    userClearBtn.style.pointerEvents = input.value ? 'auto' : 'none';
                }
            }

            // ==========================================================================
            // Password Toggle
            // ==========================================================================
            function togglePasswordVisibility() {
                const show = passwordInput.type === 'password';
                passwordInput.type = show ? 'text' : 'password';
                eyeIcon.className = show ? 'fas fa-eye' : 'fas fa-eye-slash';
                passwordToggleBtn.classList.add('eye-flash');
                setTimeout(() => passwordToggleBtn.classList.remove('eye-flash'), 540);

                // Rings animation
                if (window.fx?.rings) {
                    window.fx.rings(passwordToggleBtn, ['#00ff88', '#00e5ff']);
                }
            }

            // ==========================================================================
            // Username Clear
            // ==========================================================================
            function clearUsername() {
                usernameInput.value = '';
                usernameInput.focus();
                userClearBtn.style.opacity = '0';
                userClearBtn.style.pointerEvents = 'none';
            }

            // ==========================================================================
            // OTP Input Handling
            // ==========================================================================
            function handleOtpInput(input, index) {
                // Filter only digits
                const filtered = input.value.replace(/\D/g, '');
                if (filtered !== input.value) {
                    input.value = filtered;
                }

                if (filtered.length === 1) {
                    input.classList.add('filled');
                    input.classList.remove('error');
                    if (index < 5) {
                        otpInputs[index + 1].focus();
                    } else {
                        // All filled - auto verify after brief delay
                        setTimeout(() => {
                            const val = Array.from(otpInputs).map(x => x.value).join('');
                            if (val.length === 6) verifyOtp();
                        }, 100);
                    }
                    // Pulse animation
                    input.classList.add('pulse');
                    setTimeout(() => input.classList.remove('pulse'), 380);

                    // Update progress bar
                    updateOtpProgress();
                } else if (filtered.length === 0) {
                    input.classList.remove('filled');
                    updateOtpProgress();
                }

                otpValue = Array.from(otpInputs).map(x => x.value).join('');

                // Check if complete
                if (otpValue.length === 6) {
                    otpGrid.classList.add('complete');
                    setTimeout(() => otpGrid.classList.remove('complete'), 760);
                    // Auto-verify after brief moment
                    setTimeout(() => verifyOtp(), 300);
                }
            }

            function handleOtpKeydown(e, index) {
                if (e.key === 'Backspace' && !e.target.value && index > 0) {
                    e.preventDefault();
                    otpInputs[index - 1].focus();
                    otpInputs[index - 1].value = '';
                    otpInputs[index - 1].classList.remove('filled');
                    handleOtpInput(otpInputs[index - 1], index - 1);
                } else if (e.key === 'ArrowLeft' && index > 0) {
                    otpInputs[index - 1].focus();
                } else if (e.key === 'ArrowRight' && index < 5) {
                    otpInputs[index + 1].focus();
                } else if (e.key === 'Delete' && index < 5) {
                    otpInputs[index + 1].focus();
                }
            }

            function handleOtpPaste(e, index) {
                e.preventDefault();
                const data = (e.clipboardData || window.clipboardData).getData('text').trim();
                const digits = data.replace(/\D/g, '');

                if (digits.length >= 1) {
                    // Fill inputs with pasted digits
                    for (let j = 0; j < Math.min(digits.length, 6); j++) {
                        otpInputs[j].value = digits[j];
                        otpInputs[j].classList.add('filled');
                        otpInputs[j].classList.remove('error');
                    }
                    // Focus next empty or last
                    const nextEmpty = Array.from(otpInputs).findIndex(x => !x.value);
                    (nextEmpty >= 0 ? otpInputs[nextEmpty] : otpInputs[5]).focus();

                    otpValue = Array.from(otpInputs).map(x => x.value).join('');
                    updateOtpProgress();

                    // If complete, auto-verify
                    if (otpValue.length === 6) {
                        otpGrid.classList.add('complete');
                        setTimeout(() => otpGrid.classList.remove('complete'), 760);
                        setTimeout(() => verifyOtp(), 100);
                    }
                }
            }

            function updateOtpProgress() {
                const filled = Array.from(otpInputs).filter(x => x.classList.contains('filled')).length;
                const progress = (filled / 6) * 100;
                otpGrid.style.setProperty('--progress', `${progress}%`);
            }

            // ==========================================================================
            // OTP Verification
            // ==========================================================================
            async function verifyOtp() {
                if (isVerifying) return;
                if (otpValue.length !== 6) {
                    otpInputs.forEach(x => x.classList.add('error'));
                    flashError(otpGrid);
                    showToast('Enter 6 digits', 'error');
                    return;
                }

                document.body.classList.remove('auth-error');
                setLoading(verifyBtn, true);
                isVerifying = true;

                try {
                    const response = await fetch('/login/verify', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ otp: otpValue })
                    });
                    const data = await response.json();

                    if (data.success) {
                        document.body.classList.remove('verify-busy', 'otp-focus');
                        document.body.classList.add('auth-success');
                        document.documentElement.classList.add('portal-active');
                        showToast('Access Granted', 'success');

                        // Trigger success animation
                        if (window.fx?.play) window.fx.play('success', verifyBtn);

                        setTimeout(() => {
                            location.href = data.redirect || '/';
                        }, 900);
                        return;
                    }

                    // Handle specific error cases
                    if (data.message?.includes('expired') || data.errorCode === 'OTP_EXPIRED') {
                        showToast('Code expired. Request a new one.', 'error');
                    } else if (data.message?.includes('Invalid') || data.errorCode === 'INVALID_OTP') {
                        showToast('Invalid code. Please try again.', 'error');
                    } else {
                        showToast(data.message || 'Invalid code', 'error');
                    }

                    otpInputs.forEach(x => x.classList.add('error'));
                    flashError(otpGrid);

                } catch (err) {
                    console.error('OTP verification error:', err);
                    showToast('Network error. Please try again.', 'error');
                } finally {
                    setLoading(verifyBtn, false);
                    isVerifying = false;
                }
            }

            // ==========================================================================
            // Resend OTP
            // ==========================================================================
            function startResendCountdown() {
                resendSeconds = 60;
                resendBtn.disabled = true;
                resendBtn.classList.add('counting');
                updateResendButton();

                resendTimer = setInterval(() => {
                    resendSeconds--;
                    if (resendSeconds <= 0) {
                        clearInterval(resendTimer);
                        resendBtn.disabled = false;
                        resendBtn.classList.remove('counting');
                        resendBtn.innerHTML = `<svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span class="btn-text">Resend Code</span>`;
                    } else {
                        updateResendButton();
                    }
                }, 1000);
            }

            function updateResendButton() {
                resendBtn.innerHTML = `
                    <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                        <circle cx="12" cy="12" r="9"/>
                        <path d="M12 7v5l3 2"/>
                    </svg>
                    <span class="btn-text">${resendSeconds}s</span>
                `;
            }

            async function handleResend() {
                const username = usernameInput.value.trim();
                if (!username) return;

                setLoading(resendBtn, true);
                try {
                    const response = await fetch('/login/resend', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ username })
                    });
                    const data = await response.json();
                    if (data.success) {
                        startResendCountdown();
                        otpInputs.forEach(x => {
                            x.value = '';
                            x.classList.remove('filled', 'error', 'pulse');
                        });
                        otpGrid.classList.remove('complete', 'scanning');
                        otpValue = '';
                        otpInputs[0].focus();
                        showToast('Code resent', 'success');
                    } else {
                        flashError(resendBtn);
                        showToast(data.message || 'Failed to resend', 'error');
                    }
                } catch (err) {
                    showToast('Network error', 'error');
                } finally {
                    setLoading(resendBtn, false);
                }
            }

            // ==========================================================================
            // Form Navigation
            // ==========================================================================
            function showOtpForm(username) {
                // Reset any error states
                document.body.classList.remove('focus-user', 'focus-pass', 'auth-error', 'auth-success', 'bursting', 'verify-busy', 'otp-focus', 'login-busy');
                document.documentElement.classList.remove('portal-active');
                document.body.classList.add('otp-active');

                // Force reflow to ensure CSS transition triggers
                void otpForm.offsetWidth;

                document.getElementById('otpSent').style.display = 'block';
                document.getElementById('sentTarget').textContent = username;

                startResendCountdown();
                otpInputs.forEach(x => {
                    x.value = '';
                    x.classList.remove('filled', 'error', 'pulse');
                });
                otpGrid.classList.remove('complete', 'scanning');
                otpValue = '';

                setTimeout(() => otpInputs[0]?.focus(), 120);
            }

            function showLoginForm() {
                document.body.classList.remove('otp-active', 'otp-focus', 'verify-busy', 'auth-error', 'auth-success', 'bursting', 'login-busy');
                document.documentElement.classList.remove('portal-active');
                otpGrid.classList.remove('scanning', 'complete');

                if (resendTimer) {
                    clearInterval(resendTimer);
                    resendTimer = null;
                }
                resendBtn.classList.remove('counting');
                document.getElementById('otpSent').style.display = 'none';

                usernameInput.classList.remove('error');
                passwordInput.classList.remove('error');

                setLoading(loginBtn, false);
                setLoading(verifyBtn, false);
            }

            // ==========================================================================
            // Login Submission
            // ==========================================================================
            async function handleLogin(e) {
                e.preventDefault();

                const username = usernameInput.value.trim();
                const password = passwordInput.value;

                if (!username || !password) {
                    flashError(loginForm);
                    showToast('Enter identity code & access key', 'error');
                    return;
                }

                document.body.classList.remove('auth-error');
                document.body.classList.add('bursting');
                setTimeout(() => document.body.classList.remove('bursting'), 950);

                setLoading(loginBtn, true);
                usernameInput.classList.remove('error');
                passwordInput.classList.remove('error');

                try {
                    const response = await fetch('/login/step1', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({
                            username,
                            password,
                            remember: rememberCheckbox.checked
                        })
                    });
                    const data = await response.json();

                    if (data.success) {
                        showOtpForm(username);
                    } else {
                        if (data.errorCode === 'INVALID_PASSWORD' || data.message?.includes('password')) {
                            passwordInput.classList.add('error');
                            passwordInput.focus();
                        } else {
                            usernameInput.classList.add('error');
                            usernameInput.focus();
                        }
                        flashError(loginForm);
                        showToast(data.message || 'Authentication failed', 'error');
                    }
                } catch (err) {
                    showToast('Network error', 'error');
                } finally {
                    setLoading(loginBtn, false);
                }
            }

            // ==========================================================================
            // Initialize
            // ==========================================================================
            function init() {
                // Generate visual effects
                generateParticles(35);
                generateCircuitTraces();

                // Focus handlers
                usernameInput.addEventListener('focus', () => handleInputFocus(usernameInput));
                usernameInput.addEventListener('blur', () => handleInputBlur(usernameInput));
                usernameInput.addEventListener('input', (e) => handleInput(e.target));

                passwordInput.addEventListener('focus', () => handleInputFocus(passwordInput));
                passwordInput.addEventListener('blur', () => handleInputBlur(passwordInput));
                passwordInput.addEventListener('input', (e) => handleInput(e.target));

                // Password toggle
                passwordToggleBtn.addEventListener('click', togglePasswordVisibility);

                // Clear username
                userClearBtn.addEventListener('click', clearUsername);

                // OTP inputs - attach all event handlers
                otpInputs.forEach((input, index) => {
                    input.addEventListener('focus', () => {
                        document.body.classList.add('otp-focus');
                        input.closest('.otp-grid')?.classList.add('focused');
                    });
                    input.addEventListener('blur', () => {
                        document.body.classList.remove('otp-focus');
                        input.closest('.otp-grid')?.classList.remove('focused');
                    });
                    input.addEventListener('input', (e) => handleOtpInput(e.target, index));
                    input.addEventListener('keydown', (e) => handleOtpKeydown(e, index));
                    input.addEventListener('paste', (e) => handleOtpPaste(e, index));
                    input.addEventListener('compositionend', (e) => handleOtpInput(e.target, index));
                });

                // Form submissions
                loginForm.addEventListener('submit', handleLogin);
                verifyBtn.addEventListener('click', verifyOtp);
                resendBtn.addEventListener('click', handleResend);
                backBtn.addEventListener('click', showLoginForm);

                // Username clear button visibility
                usernameInput.addEventListener('input', () => {
                    userClearBtn.style.opacity = usernameInput.value ? '1' : '0';
                    userClearBtn.style.pointerEvents = usernameInput.value ? 'auto' : 'none';
                });

                // Check for auto-login
                checkTrusted();

                // Initialize visual effects
                setTimeout(() => {
                    document.body.classList.add('loaded');
                }, 100);

                console.log('%cNEBULA X SECURE ACCESS', 'color: #00ff88; font-size: 16px; font-weight: bold; font-family: "JetBrains Mono", monospace;');
                console.log('%cElite Cybersecurity Command Interface v3.7.1', 'color: #00e5ff; font-family: "JetBrains Mono", monospace;');
            }

            // Check for trusted session
            async function checkTrusted() {
                const params = new URLSearchParams(location.search);
                if (params.get('force') === '1') return;

                try {
                    const response = await fetch('/login/check', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: '{}'
                    });
                    const data = await response.json();
                    if (data?.trusted && data.autoLogin) {
                        location.href = data.redirect || '/';
                    }
                } catch (err) {
                    // Silent fail
                }
            }

            // Initialize when DOM ready
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
        })();
    </script>
